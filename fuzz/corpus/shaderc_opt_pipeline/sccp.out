func @loop_constant(%n: i32) -> i32 {
block0:
    loop header block1(i32 1, i32 0) continue block3 merge block4
block1(%x: i32, %k: i32):
    %done = icmp sge %k, %n
    cond_br %done, block4(i32 1), block2 merge block2
block2:
    %x2 = mul i32 1, i32 1
    br block3
block3:
    %k2 = add %k, i32 1
    br block1(i32 1, %k2)
block4(%r: i32):
    return i32 1
}

func @one_way(%a: i32) -> i32 {
block0:
    %c = icmp eq i32 2, i32 2
    cond_br i1 true, block1, block2 merge block3
block1:
    br block3(i32 7)
block2:
    br block3(%a)
block3(%r: i32):
    %s = add i32 7, i32 1
    return i32 8
}
