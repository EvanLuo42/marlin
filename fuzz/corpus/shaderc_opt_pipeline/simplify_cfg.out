func @switch_kept(%a: i32) -> i32 {
block0:
    switch i32 1 [] default block1 merge block3
block1:
    %c = icmp slt %a, i32 0
    cond_br %c, block3(i32 20), block2 merge block2
block2:
    br block3(%a)
block3(%r: i32):
    return %r
}

func @switch_gone(%a: i32) -> i32 {
block0:
    %b = add %a, i32 1
    return %b
}

func @loop_once(%a: i32) -> i32 {
block0:
    %y = add %a, i32 1
    return %y
}

func @loop_kept(%a: i32) -> i32 {
block0:
    loop header block1(%a) continue block4 merge block3
block1(%x: i32):
    %c = icmp slt %x, i32 0
    cond_br %c, block3(i32 -1), block2 merge block2
block2:
    br block3(%x)
block3(%r: i32):
    return %r
block4:
    unreachable
}

func @both_return(%a: i32) -> i32 {
block0:
    %c = icmp slt %a, i32 0
    cond_br %c, block1, block2 merge block3
block1:
    return i32 1
block2:
    return i32 2
block3:
    unreachable
}

func @empty_arms(%a: i32) -> i32 {
block0:
    %c = icmp slt %a, i32 0
    cond_br %c, block2(i32 1), block1 merge block2
block1:
    br block2(%a)
block2(%r: i32):
    return %r
}
