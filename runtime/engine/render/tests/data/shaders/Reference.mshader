namespace Render;

// A reference rasterizer for the visibility tests: each drawable instance's LOD 0 drawn with
// vertex pulling from its resident geometry and the GPU Scene, as an indexed draw with a depth
// buffer, unlit: every pixel is its instance's color.

using Marlin.Engine.Scene;

public struct ReferenceFrame
{
    public float4x4 ViewProjection;
}

public struct ReferenceArgs
{
    public Uniform<ReferenceFrame> Frame;
    /// GPU Scene instance rows, grouped by mesh: this draw's start at `BaseInstance`.
    public ReadOnlyBuffer<uint> InstanceList;
    public ReadOnlyBuffer<InstanceTransforms> Transforms;
    public ReadOnlyBuffer<InstanceData> Instances;
    public ReadOnlyBuffer<MeshEntry> Meshes;
    public ReadOnlyByteBuffer Geometry;
    public uint Lod;
    public uint BaseInstance;
}

public struct ReferenceVertex
{
    [Position] public float4 Pos;
    public float4 Color;
}

[Vertex]
public ReferenceVertex ReferenceVs(
    [VertexId] uint vertexId, [InstanceId] uint instanceId, [Push] in ReferenceArgs a)
{
    uint row = a.InstanceList[a.BaseInstance + instanceId];
    InstanceData instance = a.Instances[row];
    MeshEntry mesh = a.Meshes[instance.Mesh];
    LodStreams lod = Lod(a.Geometry, a.Lod);
    float3 position = DecodePosition(a.Geometry, mesh, lod, vertexId);
    float4 world = float4(Apply(a.Transforms[row].Current, float4(position, 1)), 1);
    return ReferenceVertex
    {
        Pos = a.Frame.Value.ViewProjection * world,
        Color = instance.Color,
    };
}

[Pixel]
public float4 ReferencePs(in ReferenceVertex v, [Push] in ReferenceArgs a) => v.Color;
