namespace Test;

// One flat-shaded triangle from the vertex id alone.

/// Words 0-3 the color; 4 the mode; 5 the depth; 8-11 the second color of dual-source blending.
public struct SolidArgs
{
    public float4 Color;
    public uint Mode;
    public float Depth;
    public uint2 Unused;
    public float4 Color1;
}

public struct SolidVertex
{
    [Position] public float4 Pos;
}

/// Mode 0 covers the whole target, 1 the lower-left half below the diagonal, 2 a sliver in the
/// top-left pixel of a 4x4 target that misses its center.
[Vertex]
public SolidVertex SolidVs([VertexId] uint vertex, [Push] in SolidArgs a)
{
    uint v = vertex % 3;
    float2 p;
    if (a.Mode == 0)
        p = float2(v == 1 ? 3 : -1, v == 2 ? 3 : -1);
    else if (a.Mode == 1)
        p = float2(v == 1 ? 1 : -1, v == 2 ? 1 : -1);
    else
        p = float2(v == 1 ? -0.9 : -0.99, v == 2 ? 0.9 : 0.99);
    return SolidVertex { Pos = float4(p, a.Depth, 1) };
}

[Pixel]
public float4 SolidPs([Push] in SolidArgs a) => a.Color;

public struct Dual
{
    [Target(0)] public float4 Color0;
    [Target(0, Source = 1)] public float4 Color1;
}

[Pixel]
public Dual SolidDual([Push] in SolidArgs a) => Dual { Color0 = a.Color, Color1 = a.Color1 };

/// The pixel position the shader ran at, packed (x | y << 16): coarse shading repeats it.
[Pixel]
public uint SolidCoord([Position] float4 position) =>
    (uint)position.x | ((uint)position.y << 16);

/// `SolidCoord`, but pixels from x = 4 on are dropped (`Discard`): they write nothing; a pixel
/// that is a helper all the same would write `0xFFFFFFFF`.
[Pixel]
public uint DiscardRight([Position] float4 position)
{
    if (position.x >= 4)
        Discard();
    return IsHelperInvocation() ? 0xFFFFFFFF : (uint)position.x | ((uint)position.y << 16);
}
