namespace Test;

// Reads textures through views and samplers the tests make, writing what they saw to a raw
// buffer; and 3D textures, `Size` texels on a side.

/// One push layout for the `Sample*` entries: each names its texture's type.
public struct SampleArgs
{
    public Texture2D<float> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
    public uint X;
    public float U;
    public float V;
}

/// One filtered sample of a float texture at (U, V), mip 0.
[Compute(1, 1, 1)]
public void SampleOne([Push] in SampleArgs a) =>
    a.Output.Store(0, AsUInt(a.Texture.Sample(a.Sampler, float2(a.U, a.V), lod: 0)));

public struct StencilArgs
{
    public Texture2D<uint> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
}

/// Texels (0, 0) through (3, 0) of a stencil view.
[Compute(4, 1, 1)]
public void SampleStencil([DispatchThreadId] uint3 id, [Push] in StencilArgs a) =>
    a.Output.Store(id.x * 4, a.Texture[int2((int)id.x, 0)]);

public struct MultisampleArgs
{
    public Texture2DMS<float4> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
    public uint X;
}

/// The red of each of 4 samples of pixel (X, X) of a multisampled texture, as 0..255.
[Compute(4, 1, 1)]
public void SampleMultisample([DispatchThreadId] uint3 id, [Push] in MultisampleArgs a)
{
    int x = (int)a.X;
    float r = a.Texture.Load(int2(x, x), sample: (int)id.x).x;
    a.Output.Store(id.x * 4, (uint)(r * 255 + 0.5));
}

public struct CubeArgs
{
    public TextureCubeArray<float4> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
    public uint X;
}

/// The red of cube X of a cube array, seen along +X, as 0..255.
[Compute(1, 1, 1)]
public void SampleCube([Push] in CubeArgs a)
{
    float4 c = a.Texture.Sample(a.Sampler, float3(1, 0, 0), layer: (int)a.X, lod: 0);
    a.Output.Store(0, (uint)(c.x * 255 + 0.5));
}

public struct VolumeWriteArgs
{
    public StorageTexture3D<uint> Volume;
    public ByteBuffer Output;
    public uint Size;
}

/// Texel (x, y, z) of an R32Uint volume = x + 16 * y + 256 * z + 1.
[Compute(4, 4, 4)]
public void VolumeWrite([DispatchThreadId] uint3 id, [Push] in VolumeWriteArgs a)
{
    if (All(id < a.Size))
        a.Volume[(int3)id] = id.x + 16 * id.y + 256 * id.z + 1;
}

public struct VolumeReadArgs
{
    public Texture3D<uint> Volume;
    public ByteBuffer Output;
    public uint Size;
}

/// Every texel of a volume into a raw buffer, x fastest.
[Compute(4, 4, 4)]
public void VolumeRead([DispatchThreadId] uint3 id, [Push] in VolumeReadArgs a)
{
    uint size = a.Size;
    if (All(id < size))
        a.Output.Store(((id.z * size + id.y) * size + id.x) * 4, a.Volume[(int3)id]);
}

public struct SignedWriteArgs
{
    public StorageTexture2D<int> Texture;
    public uint Size;
}

/// Texel (x, y) of an R32Sint texture = -(x + 4 * y) - 1.
[Compute(4, 4, 1)]
public void SignedWrite([DispatchThreadId] uint3 id, [Push] in SignedWriteArgs a)
{
    if (All(id.xy < a.Size))
        a.Texture[(int2)id.xy] = -(int)(id.x + 4 * id.y) - 1;
}

public struct SignedReadArgs
{
    public Texture2D<int> Texture;
    public ByteBuffer Output;
    public uint Size;
}

/// Every texel halved with an arithmetic shift (so the sign must survive), x fastest.
[Compute(4, 4, 1)]
public void SignedRead([DispatchThreadId] uint3 id, [Push] in SignedReadArgs a)
{
    if (All(id.xy < a.Size))
        a.Output.Store((id.y * a.Size + id.x) * 4, (uint)(a.Texture[(int2)id.xy] >> 1));
}

/// The red of the four texels around (U, V): words 0 to 3.
[Compute(1, 1, 1)]
public void GatherRed([Push] in SampleArgs a) =>
    a.Output.Store4(0, AsUInt(a.Texture.Gather(a.Sampler, float2(a.U, a.V))));

/// A sample at (U, V) one texel to the right, and texel (0, 1) loaded as (0, 0) one row down.
[Compute(1, 1, 1)]
public void SampleOffsets([Push] in SampleArgs a)
{
    a.Output.Store(0, AsUInt(a.Texture.Sample(a.Sampler, float2(a.U, a.V), lod: 0, offset: int2(1, 0))));
    a.Output.Store(4, AsUInt(a.Texture.Load(int2(0, 0), offset: int2(0, 1))));
}

public struct CompareArgs
{
    public Texture2D<float> Depth;
    public ComparisonSampler Sampler;
    public ByteBuffer Output;
    public uint X;
    /// The reference depth.
    public float U;
    public float V;
}

/// The comparison of U with the depth at (0.5, 0.5): word 0 one sample, words 1 to 4 a gather.
[Compute(1, 1, 1)]
public void CompareDepth([Push] in CompareArgs a)
{
    float2 uv = float2(0.5, 0.5);
    a.Output.Store(0, AsUInt(a.Depth.SampleCompare(a.Sampler, uv, a.U, lod: 0)));
    a.Output.Store4(4, AsUInt(a.Depth.GatherCompare(a.Sampler, uv, a.U)));
}

public struct QueryArgs
{
    public Texture2DArray<float4> Array;
    public Texture2DMS<float4> Multisampled;
    public TextureCubeArray<float4> Cubes;
    public Texture3D<float4> Volume;
    public ByteBuffer Output;
}

/// Sizes and counts, in this order: the array's size, mip 1 size, mips and layers; the
/// multisampled texture's size and samples; the cube array's face size and cubes; the
/// volume's size.
[Compute(1, 1, 1)]
public void Queries([Push] in QueryArgs a)
{
    a.Output.Store2(0, a.Array.Size);
    a.Output.Store2(8, a.Array.MipSize(1));
    a.Output.Store(16, a.Array.MipCount);
    a.Output.Store(20, a.Array.LayerCount);
    a.Output.Store2(24, a.Multisampled.Size);
    a.Output.Store(32, a.Multisampled.SampleCount);
    a.Output.Store2(36, a.Cubes.Size);
    a.Output.Store(44, a.Cubes.LayerCount);
    a.Output.Store3(48, a.Volume.Size);
}
