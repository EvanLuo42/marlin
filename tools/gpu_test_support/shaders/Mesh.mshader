namespace Test;

// Mesh shading into the columns target: each mesh group emits one quad covering one column,
// written as `column + 1` (drawn with `ColumnsPs`).
// - ColumnsMesh: column = First (push word 31, set per indirect dispatch) + the group id.
// - ColumnsAmplify + ColumnsAmplified: each amplification group launches 2 mesh groups, for
//   columns First + 2 * the group id and the one after it.

public struct MeshArgs
{
    public uint Columns;
    public uint[30] Unused;
    public uint First;
}

public struct ColumnPayload
{
    public uint First;
}

void Quad(uint column, uint columns, MeshOutput<ColumnVertex> o)
{
    o.SetCounts(4, 2);
    float x0 = (float)column / (float)columns * 2 - 1;
    float x1 = (float)(column + 1) / (float)columns * 2 - 1;
    o.Vertices[0] = ColumnVertex { Pos = float4(x0, -1, 0.5, 1), Value = column + 1 };
    o.Vertices[1] = ColumnVertex { Pos = float4(x1, -1, 0.5, 1), Value = column + 1 };
    o.Vertices[2] = ColumnVertex { Pos = float4(x1, 1, 0.5, 1), Value = column + 1 };
    o.Vertices[3] = ColumnVertex { Pos = float4(x0, 1, 0.5, 1), Value = column + 1 };
    o.Triangles[0] = uint3(0, 1, 2);
    o.Triangles[1] = uint3(0, 2, 3);
}

[Mesh(1, 1, 1, MaxVertices = 4, MaxPrimitives = 2, Topology = MeshTopology.Triangle)]
public void ColumnsMesh([GroupId] uint3 group, [Push] in MeshArgs a, MeshOutput<ColumnVertex> o)
{
    Quad(a.First + group.x, a.Columns, o);
}

[GroupShared] ColumnPayload SharedPayload;

[Amplification(1, 1, 1)]
public void ColumnsAmplify([GroupId] uint3 group, [Push] in MeshArgs a)
{
    SharedPayload.First = a.First + group.x * 2;
    Mesh.Dispatch(2, 1, 1, SharedPayload);
}

[Mesh(1, 1, 1, MaxVertices = 4, MaxPrimitives = 2, Topology = MeshTopology.Triangle)]
public void ColumnsAmplified(
    [GroupId] uint3 group,
    [Payload] in ColumnPayload p,
    [Push] in MeshArgs a,
    MeshOutput<ColumnVertex> o)
{
    Quad(p.First + group.x, a.Columns, o);
}
