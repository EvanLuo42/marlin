namespace Marlin.Engine.Visibility;

// The visibility pipeline of one view (0009 §4.1–§4.3): two passes against a hierarchical
// depth buffer (HZB), hardware raster only.
//
// Pass 1 tests against the HZB of the last frame (its view-projection), pass 2 against one
// built from what pass 1 drew. Each pass:
//
// 1. `Reset` (pass 1) zeroes the counters.
// 2. Instances: pass 1's `InstanceCull`, one thread per instance row: frustum test of its world
//    sphere, then the occlusion test; occluded instances are kept in `OccludedInstances` for
//    pass 2, the others append their hierarchy's root node to `Nodes`. Pass 2's
//    `InstanceRetest` tests the occluded ones again; those now visible append their root node.
// 3. The DAG traversal, one `NodeArgs` + `NodeCull` pair per level of hierarchy nodes:
//    `NodeArgs` takes the nodes appended since the last level as this level's, `NodeCull` tests
//    each of their children (8 threads a node): frustum, then the largest error below projected
//    against the budget (within it, nothing below is drawn). Passing children append to
//    `Nodes`, or to `Parts` for a leaf (a group's clusters in one page) whose group is whole:
//    every page of it resident. A leaf whose group is not appends its missing pages to
//    `Requests` instead, for marlin-render's streaming.
// 4. `PartArgs` + `ClusterCull`: one group per part appended this pass. A part whose group's
//    projected error is within the budget draws nothing (the group is good enough, so a coarser
//    one is drawn); otherwise each of its clusters whose own LOD error projects within the
//    budget, or whose finer source group is not resident, is drawn once it passes the frustum,
//    normal-cone and occlusion tests: it is appended to `Clusters`, whose index is the cluster
//    id the visibility buffer stores. Pass 1 keeps occluded clusters in `OccludedClusters`;
//    pass 2's `ClusterRetest` tests them again. Every slot a part is read from is marked in
//    `Used`. A cluster whose triangles are small on screen (`Software`) goes to the software
//    raster instead of the mesh shader.
// 5. `FinishArgs` turns the clusters appended this pass into the mesh dispatch and the
//    software raster's.
// 6. `VisMesh` + `VisPs`: one mesh group per hardware cluster of the pass; `SwRaster`: one
//    group per software cluster, a thread per triangle. Each pixel keeps the nearest
//    `depth << 32 | cluster << 7 | triangle` with a 64-bit atomic max (no attachments).
// 7. `VisDepth` splits the depth out into an `R32Float` texture, and `Hzb.mshader` builds the
//    HZB from it.
//
// Pass 1 only culls what the last frame's HZB hides; anything it culls wrongly (it moved, the
// camera did) pass 2 draws, so the picture is the one a single pass without occlusion culling
// would draw. The cut is the DAG's (0009 §3): the errors and spheres grow from children to
// parents and every test projects them with `ProjectedError`, so the cut is watertight.
//
// `Counters` words (atomics): 0 the visible instances, 1 the nodes appended, 2 the parts
// appended, 3 the visible clusters appended (each may pass its capacity), 4 the clusters drawn;
// 5 where the next level's nodes start, 6 and 7 the current level's range, 8 the page requests
// (may pass their capacity), 9 the occluded instances, 10 the pass's first cluster, 11 the
// occluded clusters, 12 where the next pass's parts start, 13 and 14 the pass's part range,
// 15 the software-raster clusters appended, 16 those drawn, 17 the pass's first one. Software
// raster clusters are kept in `Clusters` from `ClusterCapacity` on.
// `Args` (indirect arguments, a pass never both counts into and dispatches from one buffer)
// holds five records of the RHI's indirect dispatches: a constant (push word 31, unused here),
// then x, y, z. Words 0–3 are the node level's, 4–7 the cluster cull's, 8–11 the mesh
// dispatch, 12–15 the instance retest's, 16–19 the cluster retest's, 20–23 the software
// raster's.

using Marlin.Engine.Scene;

/// The view, as marlin-render's visibility passes upload it.
public struct View
{
    /// Matrices are column-major; `M * v` is the column-vector product.
    public float4x4 ViewProjection;
    /// The last frame's, which its HZB was drawn with.
    public float4x4 PreviousViewProjection;
    /// World-space frustum planes (left, right, bottom, top, near): a point p is inside a plane
    /// when `Dot(plane.xyz, p) + plane.w >= 0`. The far plane is at infinity.
    public float4[5] Planes;
    /// xyz: the eye; w: pixels per world unit at distance 1.
    public float4 Eye;
    /// The screen-space error, in pixels, the cut may have.
    public float LodErrorPixels;
    public uint InstanceRows;
    /// Entries `Nodes`, `Parts` and `Clusters` hold.
    public uint NodeCapacity;
    public uint PartCapacity;
    public uint ClusterCapacity;
    /// Entries `Requests` holds.
    public uint RequestCapacity;
    /// Entries `OccludedInstances` and `OccludedClusters` hold.
    public uint OccludedCapacity;
    /// The HZB's mip count; its mip 0 is `HzbSize`.
    public uint HzbMips;
    public uint2 HzbSize;
    /// Clusters whose triangles' average edge is shorter than this many pixels draw in
    /// software.
    public float SwEdgePixels;
    /// The view's size in pixels.
    public uint Width;
    public uint Height;
    public uint[3] Spare;
}

public struct CullArgs
{
    public Uniform<View> View;
    public ReadOnlyBuffer<InstanceData> Instances;
    public ReadOnlyBuffer<InstanceTransforms> Transforms;
    /// World bounding spheres: center, radius.
    public ReadOnlyBuffer<float4> Bounds;
    public ReadOnlyBuffer<MeshEntry> Meshes;
    /// Hierarchy nodes to test: instance row, node.
    public Buffer<uint2> Nodes;
    /// Group parts to test: instance row, part.
    public Buffer<uint2> Parts;
    public Buffer<uint> Counters;
    public Buffer<uint> Args;
    /// Visible clusters: instance row, `slot << 12 | cluster`.
    public Buffer<uint2> Clusters;
    /// Page requests: the byte offset of the page's table entry in the pool, the projected
    /// error (float bits) as priority.
    public Buffer<uint2> Requests;
    /// A word per pool slot: set once a slot is read.
    public Buffer<uint> Used;
    /// The HZB the pass tests against: all mips.
    public Texture2D<float> Hzb;
    /// What pass 1 found occluded: instance rows, and clusters (row, `slot << 12 | cluster`).
    public Buffer<uint> OccludedInstances;
    public Buffer<uint2> OccludedClusters;
    /// `TestHzb` | `SecondPass`.
    public uint Pass;
}

/// `CullArgs.Pass`: test against `Hzb`.
const uint TestHzb = 1;
/// `CullArgs.Pass`: the second pass: the current view, what is occluded is dropped.
const uint SecondPass = 2;

/// Groups per row of a dispatch (the smallest maximum every device allows); more go to rows.
const uint GroupsPerRow = 65535;

/// A hierarchy child that is a leaf: the rest is a part.
const uint LeafBit = 2147483648;
const uint NoChild = 4294967295;

/// A dispatch's linear group index.
uint GroupIndex(uint3 group) => group.x + group.y * GroupsPerRow;

/// An indirect dispatch record of `groups` groups at word `at` of the arguments.
void WriteDispatch(in CullArgs a, uint at, uint groups)
{
    a.Args[at] = 0;
    a.Args[at + 1] = Min(groups, GroupsPerRow);
    a.Args[at + 2] = (groups + GroupsPerRow - 1) / GroupsPerRow;
    a.Args[at + 3] = 1;
}

[Compute(1, 1, 1)]
public void Reset([Push] in CullArgs a)
{
    for (uint i = 0; i < 20; i++)
        a.Counters[i] = 0;
}

bool InFrustum(in View v, float3 center, float radius)
{
    for (uint i = 0; i < 5; i++)
    {
        float4 p = v.Planes[i];
        if (Dot(p.xyz, center) + p.w < -radius)
            return false;
    }
    return true;
}

/// Whether the world sphere (`center`, `radius`), seen through `viewProjection`, is behind
/// what `hzb` holds: its nearest depth is farther than the farthest depth of every texel its
/// screen rectangle covers. The rectangle is the projection of the sphere's bounding box,
/// tested at the coarsest mip where it covers at most 2×2 texels. A box reaching behind the
/// camera is never occluded.
bool Occluded(in View v, float4x4 viewProjection, Texture2D<float> hzb, float3 center, float radius)
{
    float2 lo = float2(1, 1);
    float2 hi = float2(-1, -1);
    float nearest = 0;
    for (uint i = 0; i < 8; i++)
    {
        float3 corner = center + float3(
            (i & 1) != 0 ? radius : -radius,
            (i & 2) != 0 ? radius : -radius,
            (i & 4) != 0 ? radius : -radius);
        float4 clip = viewProjection * float4(corner, 1);
        if (clip.w <= 0.000001)
            return false;
        float3 ndc = clip.xyz / clip.w;
        lo = Min(lo, ndc.xy);
        hi = Max(hi, ndc.xy);
        // Reverse-Z: the nearest depth is the largest.
        nearest = Max(nearest, ndc.z);
    }
    if (nearest >= 1)
        return false;
    // Mip-0 texels, y down; a texel covers the same share of the screen at every size.
    float2 size = float2((float)v.HzbSize.x, (float)v.HzbSize.y);
    float2 from = Clamp(float2(lo.x * 0.5 + 0.5, 0.5 - hi.y * 0.5) * size, float2(0, 0), size - 1);
    float2 to = Clamp(float2(hi.x * 0.5 + 0.5, 0.5 - lo.y * 0.5) * size, float2(0, 0), size - 1);
    uint2 a = uint2((uint)from.x, (uint)from.y);
    uint2 b = uint2((uint)to.x, (uint)to.y);
    uint level = 0;
    while (level + 1 < v.HzbMips && ((b.x >> level) - (a.x >> level) > 1 || (b.y >> level) - (a.y >> level) > 1))
        level++;
    int2 p = int2((int)(a.x >> level), (int)(a.y >> level));
    int2 q = int2((int)(b.x >> level), (int)(b.y >> level));
    float farthest = Min(
        Min(hzb.Load(p, mip: (int)level), hzb.Load(int2(q.x, p.y), mip: (int)level)),
        Min(hzb.Load(int2(p.x, q.y), mip: (int)level), hzb.Load(q, mip: (int)level)));
    return nearest < farthest;
}

/// Whether the pass culls the world sphere as occluded.
bool PassOccludes(in CullArgs a, in View v, float3 center, float radius)
{
    if ((a.Pass & TestHzb) == 0)
        return false;
    float4x4 viewProjection = (a.Pass & SecondPass) != 0 ? v.ViewProjection : v.PreviousViewProjection;
    return Occluded(v, viewProjection, a.Hzb, center, radius);
}

/// The largest scale of a transform: its longest column.
float MaxScale(in Rows3x4 m)
{
    float3 x = float3(m.R0.x, m.R1.x, m.R2.x);
    float3 y = float3(m.R0.y, m.R1.y, m.R2.y);
    float3 z = float3(m.R0.z, m.R1.z, m.R2.z);
    return Sqrt(Max(Dot(x, x), Max(Dot(y, y), Dot(z, z))));
}

/// Whether a transform scales every axis alike (normal cones stay valid).
bool UniformScale(in Rows3x4 m)
{
    float3 x = float3(m.R0.x, m.R1.x, m.R2.x);
    float3 y = float3(m.R0.y, m.R1.y, m.R2.y);
    float3 z = float3(m.R0.z, m.R1.z, m.R2.z);
    float lo = Min(Dot(x, x), Min(Dot(y, y), Dot(z, z)));
    float hi = Max(Dot(x, x), Max(Dot(y, y), Dot(z, z)));
    return hi <= lo * 1.0001;
}

/// Object-space `error` measured over object-space `sphere`, in pixels: projected at the
/// sphere's near side. Larger spheres and errors project larger, so testing parents and
/// children against one budget gives a consistent cut.
float ProjectedError(in View v, in Rows3x4 t, float scale, float4 sphere, float error)
{
    float3 center = Apply(t, float4(sphere.xyz, 1));
    float distance = Max(Length(center - v.Eye.xyz) - sphere.w * scale, 0.0001);
    return error * scale * v.Eye.w / distance;
}

/// Appends instance `row`'s root node: its traversal starts.
void Visible(in CullArgs a, in View v, uint row)
{
    a.Counters.AtomicAdd(0, 1);
    uint slot = a.Counters.AtomicAdd(1, 1);
    if (slot < v.NodeCapacity)
        a.Nodes[slot] = uint2(row, 0);
}

[Compute(64, 1, 1)]
public void InstanceCull([DispatchThreadId] uint3 id, [Push] in CullArgs a)
{
    View v = a.View.Value;
    uint row = id.x;
    if (row >= v.InstanceRows)
        return;
    InstanceData instance = a.Instances[row];
    // Hidden, or removed (the scatter hides removed rows).
    if ((instance.Flags & 1) != 0)
        return;
    MeshEntry mesh = a.Meshes[instance.Mesh];
    if (mesh.Resident == 0)
        return;
    float4 sphere = a.Bounds[row];
    if (!InFrustum(v, sphere.xyz, sphere.w))
        return;
    if (PassOccludes(a, v, sphere.xyz, sphere.w))
    {
        uint at = a.Counters.AtomicAdd(9, 1);
        if (at < v.OccludedCapacity)
            a.OccludedInstances[at] = row;
        else
            Visible(a, v, row);
        return;
    }
    Visible(a, v, row);
}

[Compute(1, 1, 1)]
public void InstanceRetestArgs([Push] in CullArgs a)
{
    WriteDispatch(a, 12, (Min(a.Counters[9], a.View.Value.OccludedCapacity) + 63) / 64);
}

/// Pass 2: the instances pass 1 found occluded, against the new HZB.
[Compute(64, 1, 1)]
public void InstanceRetest([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in CullArgs a)
{
    View v = a.View.Value;
    uint index = GroupIndex(group) * 64 + thread.x;
    if (index >= Min(a.Counters[9], v.OccludedCapacity))
        return;
    uint row = a.OccludedInstances[index];
    float4 sphere = a.Bounds[row];
    if (!PassOccludes(a, v, sphere.xyz, sphere.w))
        Visible(a, v, row);
}

/// The nodes appended since the last level become this level's.
[Compute(1, 1, 1)]
public void NodeArgs([Push] in CullArgs a)
{
    uint start = a.Counters[5];
    uint end = Min(a.Counters[1], a.View.Value.NodeCapacity);
    a.Counters[6] = start;
    a.Counters[7] = end;
    a.Counters[5] = end;
    WriteDispatch(a, 0, (end - start + 7) / 8);
}

[Compute(64, 1, 1)]
public void NodeCull([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in CullArgs a)
{
    View v = a.View.Value;
    uint item = a.Counters[6] + GroupIndex(group) * 8 + thread.x / 8;
    if (item >= a.Counters[7])
        return;
    uint2 node = a.Nodes[item];
    uint row = node.x;
    MeshEntry mesh = a.Meshes[a.Instances[row].Mesh];
    HierarchyChild child = LoadChild(mesh.Dag, node.y, thread.x & 7);
    if (child.Child == NoChild)
        return;
    Rows3x4 t = a.Transforms[row].Current;
    float scale = MaxScale(t);
    if (!InFrustum(v, Apply(t, float4(child.Sphere.xyz, 1)), child.Sphere.w * scale))
        return;
    // Every group below is good enough: nothing below is drawn. The margin keeps a group whose
    // error projects right at the budget here, so `ClusterCull` decides it.
    float projected = ProjectedError(v, t, scale, child.Sphere, child.MaxError);
    if (projected <= v.LodErrorPixels * 0.99)
        return;
    if ((child.Child & LeafBit) != 0)
    {
        uint part = child.Child & (LeafBit - 1);
        // A group is drawn whole: until every page of it is resident, ask for the missing ones;
        // coarser clusters draw this part of the surface meanwhile.
        DagGroup g = LoadGroup(mesh.Dag, LoadPart(mesh.Dag, part).Group);
        bool whole = true;
        for (uint i = 0; i < g.PartCount; i++)
        {
            uint page = LoadPart(mesh.Dag, g.FirstPart + i).Page;
            if (PageSlot(mesh.Pages, mesh.Dag, page) == NoChild)
            {
                whole = false;
                uint request = a.Counters.AtomicAdd(8, 1);
                if (request < v.RequestCapacity)
                    a.Requests[request] = uint2(PageEntry(mesh.Dag, page), AsUInt(projected));
            }
        }
        if (!whole)
            return;
        uint slot = a.Counters.AtomicAdd(2, 1);
        if (slot < v.PartCapacity)
            a.Parts[slot] = uint2(row, part);
    }
    else
    {
        uint slot = a.Counters.AtomicAdd(1, 1);
        if (slot < v.NodeCapacity)
            a.Nodes[slot] = uint2(row, child.Child);
    }
}

/// The parts appended since the last pass become this pass's.
[Compute(1, 1, 1)]
public void PartArgs([Push] in CullArgs a)
{
    uint start = a.Counters[12];
    uint end = Min(a.Counters[2], a.View.Value.PartCapacity);
    a.Counters[13] = start;
    a.Counters[14] = end;
    a.Counters[12] = end;
    WriteDispatch(a, 4, end - start);
}

/// A snorm8 in bits `shift` to `shift + 7` of `w`.
float Snorm8(uint w, uint shift)
{
    int b = (int)((w >> shift) & 255);
    if (b >= 128)
        b -= 256;
    return Max((float)b / 127, -1);
}

/// Whether a cluster of `triangles` triangles in the world sphere (`center`, `radius`) draws
/// in software: its triangles are small on screen (their average edge, estimated from the
/// sphere's projected diameter, under `SwEdgePixels`) and it does not reach the near plane
/// (software raster does not clip).
bool Software(in View v, float3 center, float radius, uint triangles)
{
    float4 near = v.Planes[4];
    float d = Dot(near.xyz, center) + near.w;
    if (d <= radius)
        return false;
    float diameter = 2 * radius * v.Eye.w / Max(Length(center - v.Eye.xyz) - radius, 0.0001);
    return diameter * Sqrt(2 / (float)Max(triangles, 1)) < v.SwEdgePixels;
}

/// Appends a visible cluster: hardware raster from the front of `Clusters`, software raster
/// from `ClusterCapacity` on.
void Draw(in CullArgs a, in View v, uint row, uint address, bool software)
{
    if (software)
    {
        uint index = a.Counters.AtomicAdd(15, 1);
        if (index < v.ClusterCapacity)
            a.Clusters[v.ClusterCapacity + index] = uint2(row, address);
        return;
    }
    uint at = a.Counters.AtomicAdd(3, 1);
    if (at < v.ClusterCapacity)
        a.Clusters[at] = uint2(row, address);
}

[Compute(32, 1, 1)]
public void ClusterCull([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in CullArgs a)
{
    View v = a.View.Value;
    uint index = a.Counters[13] + GroupIndex(group);
    if (index >= a.Counters[14])
        return;
    uint2 item = a.Parts[index];
    uint row = item.x;
    MeshEntry mesh = a.Meshes[a.Instances[row].Mesh];
    DagPart part = LoadPart(mesh.Dag, item.y);
    Rows3x4 t = a.Transforms[row].Current;
    float scale = MaxScale(t);
    // The group is good enough: a coarser one draws this part of the surface.
    DagGroup g = LoadGroup(mesh.Dag, part.Group);
    if (ProjectedError(v, t, scale, g.Sphere, g.Error) <= v.LodErrorPixels)
        return;
    uint slot = PageSlot(mesh.Pages, mesh.Dag, part.Page);
    a.Used[slot] = 1;
    Page page = LoadPage(mesh.Pages, slot);
    bool cones = UniformScale(t);
    for (uint i = thread.x; i < part.ClusterCount; i += 32)
    {
        uint cluster = part.FirstCluster + i;
        Cluster c = LoadCluster(mesh.Pages, page, cluster);
        // Not good enough itself: the finer clusters it was made from draw it, once they are
        // resident (level 0 has no error, so it always has a source group here).
        if (ProjectedError(v, t, scale, c.LodSphere, c.LodError) > v.LodErrorPixels)
        {
            if (GroupResident(mesh.Pages, mesh.Dag, c.SourceGroup))
                continue;
        }
        float3 center = Apply(t, float4(c.Sphere.xyz, 1));
        float radius = c.Sphere.w * scale;
        if (!InFrustum(v, center, radius))
            continue;
        float cutoff = Snorm8(c.Cone, 24);
        // A cutoff of 1 (127) is a degenerate cone: never culled.
        if (cones && cutoff < 1)
        {
            float3 axis = Normalize(Apply(t, float4(Snorm8(c.Cone, 0), Snorm8(c.Cone, 8), Snorm8(c.Cone, 16), 0)));
            float3 d = center - v.Eye.xyz;
            if (Dot(d, axis) >= cutoff * Length(d) + radius)
                continue;
        }
        uint address = (slot << 12) | cluster;
        bool software = Software(v, center, radius, c.TriangleCount);
        if (PassOccludes(a, v, center, radius))
        {
            // Pass 1: pass 2 decides.
            if ((a.Pass & SecondPass) == 0)
            {
                uint at = a.Counters.AtomicAdd(11, 1);
                if (at < v.OccludedCapacity)
                    a.OccludedClusters[at] = uint2(row, address);
                else
                    Draw(a, v, row, address, software);
            }
            continue;
        }
        Draw(a, v, row, address, software);
    }
}

[Compute(1, 1, 1)]
public void ClusterRetestArgs([Push] in CullArgs a)
{
    WriteDispatch(a, 16, (Min(a.Counters[11], a.View.Value.OccludedCapacity) + 63) / 64);
}

/// Pass 2: the clusters pass 1 found occluded, against the new HZB.
[Compute(64, 1, 1)]
public void ClusterRetest([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in CullArgs a)
{
    View v = a.View.Value;
    uint index = GroupIndex(group) * 64 + thread.x;
    if (index >= Min(a.Counters[11], v.OccludedCapacity))
        return;
    uint2 item = a.OccludedClusters[index];
    uint row = item.x;
    MeshEntry mesh = a.Meshes[a.Instances[row].Mesh];
    Page page = LoadPage(mesh.Pages, AddressSlot(item.y));
    Cluster c = LoadCluster(mesh.Pages, page, AddressCluster(item.y));
    Rows3x4 t = a.Transforms[row].Current;
    float3 center = Apply(t, float4(c.Sphere.xyz, 1));
    float radius = c.Sphere.w * MaxScale(t);
    if (!PassOccludes(a, v, center, radius))
        Draw(a, v, row, item.y, Software(v, center, radius, c.TriangleCount));
}

/// The clusters appended this pass become its mesh dispatch and its software raster dispatch.
[Compute(1, 1, 1)]
public void FinishArgs([Push] in CullArgs a)
{
    uint capacity = a.View.Value.ClusterCapacity;
    uint first = a.Counters[4];
    uint count = Min(a.Counters[3], capacity);
    a.Counters[10] = first;
    a.Counters[4] = count;
    WriteDispatch(a, 8, count - first);
    uint swFirst = a.Counters[16];
    uint swCount = Min(a.Counters[15], capacity);
    a.Counters[17] = swFirst;
    a.Counters[16] = swCount;
    WriteDispatch(a, 20, swCount - swFirst);
}

public struct RasterArgs
{
    public Uniform<View> View;
    public ReadOnlyBuffer<InstanceData> Instances;
    public ReadOnlyBuffer<InstanceTransforms> Transforms;
    public ReadOnlyBuffer<MeshEntry> Meshes;
    public ReadOnlyBuffer<uint2> Clusters;
    public ReadOnlyBuffer<uint> Counters;
    public StorageTexture2D<ulong> Vis;
}

public struct VisVertex
{
    [Position] public float4 Pos;
}

public struct VisPrimitive
{
    /// `cluster << 7 | triangle`.
    [PrimitiveId] public uint Id;
}

[Mesh(128, 1, 1, MaxVertices = 128, MaxPrimitives = 128, Topology = MeshTopology.Triangle)]
public void VisMesh(
    [GroupId] uint3 group,
    [GroupThreadId] uint3 thread,
    [Push] in RasterArgs a,
    MeshOutput<VisVertex, VisPrimitive> o)
{
    // This pass's clusters follow the last pass's.
    uint cluster = a.Counters[10] + GroupIndex(group);
    if (cluster >= a.Counters[4])
    {
        o.SetCounts(0, 0);
        return;
    }
    uint2 entry = a.Clusters[cluster];
    uint row = entry.x;
    MeshEntry mesh = a.Meshes[a.Instances[row].Mesh];
    ReadOnlyByteBuffer pool = mesh.Pages;
    Page page = LoadPage(pool, AddressSlot(entry.y));
    Cluster c = LoadCluster(pool, page, AddressCluster(entry.y));
    o.SetCounts(c.VertexCount, c.TriangleCount);
    uint i = thread.x;
    if (i < c.VertexCount)
    {
        float3 p = DecodePosition(pool, mesh, page, c.VertexOffset + i);
        float4 world = float4(Apply(a.Transforms[row].Current, float4(p, 1)), 1);
        o.Vertices[i] = VisVertex { Pos = a.View.Value.ViewProjection * world };
    }
    if (i < c.TriangleCount)
    {
        o.Triangles[i] = LoadTriangle(pool, page, c, i) - c.VertexOffset;
        o.Primitives[i] = VisPrimitive { Id = (cluster << 7) | i };
    }
}

[Pixel]
public void VisPs([Position] float4 position, [PrimitiveId] uint id, [Push] in RasterArgs a)
{
    // Reverse-Z: the nearest has the largest depth, and a non-negative float's bits order as
    // the float does.
    ulong value = ((ulong)AsUInt(position.z) << 32) | (ulong)id;
    a.Vis.AtomicMax((int2)position.xy, value);
}

/// Sub-pixel bits of the software raster's fixed-point positions: what the hardware snaps to
/// (8 on the GPUs we ship on), so both cover the same pixels.
const int SubPixelBits = 8;

/// A screen position (pixels, y down) snapped to fixed point.
long2 Snap(float2 p) => long2((long)Floor(p.x * 256 + 0.5), (long)Floor(p.y * 256 + 0.5));

/// `Cross(b - a, p - a)` in fixed point: positive on the inside of an edge `a`→`b` of a
/// triangle whose corners make a positive area.
long Edge(long2 a, long2 b, long2 p) => (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);

/// Whether edge `a`→`b` is a top or a left edge (y down, positive area): pixels exactly on it
/// are covered, as on the hardware's top-left rule.
bool TopLeft(long2 a, long2 b) => b.y < a.y || (b.y == a.y && b.x > a.x);

/// Software raster: one group per cluster of the pass, one thread per triangle; each covered
/// pixel center keeps the nearest `depth << 32 | cluster << 7 | triangle`, as `VisPs` does.
/// Coverage follows the hardware's rules: positions snapped to 1/256 pixel, pixel centers,
/// top-left fill, back faces (clockwise on screen with y up) culled; depth is interpolated
/// linearly on screen.
[Compute(128, 1, 1)]
public void SwRaster([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in RasterArgs a)
{
    View v = a.View.Value;
    uint index = a.Counters[17] + GroupIndex(group);
    if (index >= a.Counters[16])
        return;
    uint cluster = v.ClusterCapacity + index;
    uint2 entry = a.Clusters[cluster];
    uint row = entry.x;
    MeshEntry mesh = a.Meshes[a.Instances[row].Mesh];
    ReadOnlyByteBuffer pool = mesh.Pages;
    Page page = LoadPage(pool, AddressSlot(entry.y));
    Cluster c = LoadCluster(pool, page, AddressCluster(entry.y));
    uint triangle = thread.x;
    if (triangle >= c.TriangleCount)
        return;
    uint3 corners = LoadTriangle(pool, page, c, triangle);
    Rows3x4 t = a.Transforms[row].Current;
    float width = (float)v.Width;
    float height = (float)v.Height;
    long2[3] p = default;
    float[3] z = default;
    for (uint k = 0; k < 3; k++)
    {
        uint vertex = k == 0 ? corners.x : (k == 1 ? corners.y : corners.z);
        float3 world = Apply(t, float4(DecodePosition(pool, mesh, page, vertex), 1));
        float4 clip = v.ViewProjection * float4(world, 1);
        float3 ndc = clip.xyz / clip.w;
        p[k] = Snap(float2((ndc.x * 0.5 + 0.5) * width, (0.5 - ndc.y * 0.5) * height));
        z[k] = ndc.z;
    }
    long area = Edge(p[0], p[1], p[2]);
    // Front faces turn counter-clockwise with y up: a negative area with y down. Back faces
    // and degenerate triangles cover nothing.
    if (area >= 0)
        return;
    // Positive area from here: swap two corners.
    long2 p1 = p[2];
    long2 p2 = p[1];
    long2 p0 = p[0];
    float z0 = z[0];
    float z1 = z[2];
    float z2 = z[1];
    area = -area;
    long bias0 = TopLeft(p1, p2) ? 0 : -1;
    long bias1 = TopLeft(p2, p0) ? 0 : -1;
    long bias2 = TopLeft(p0, p1) ? 0 : -1;
    long halfPixel = 1 << (SubPixelBits - 1);
    long pixel = 1 << SubPixelBits;
    // The pixels whose centers can be inside: the corners' bounds, on screen.
    long minX = Min(p0.x, Min(p1.x, p2.x));
    long minY = Min(p0.y, Min(p1.y, p2.y));
    long maxX = Max(p0.x, Max(p1.x, p2.x));
    long maxY = Max(p0.y, Max(p1.y, p2.y));
    int x0 = Max((int)((minX - halfPixel + pixel - 1) >> SubPixelBits), 0);
    int y0 = Max((int)((minY - halfPixel + pixel - 1) >> SubPixelBits), 0);
    int x1 = Min((int)((maxX - halfPixel) >> SubPixelBits), (int)v.Width - 1);
    int y1 = Min((int)((maxY - halfPixel) >> SubPixelBits), (int)v.Height - 1);
    float inverse = 1 / (float)area;
    uint id = (cluster << 7) | triangle;
    for (int y = y0; y <= y1; y++)
    {
        for (int x = x0; x <= x1; x++)
        {
            long2 s = long2((long)x * pixel + halfPixel, (long)y * pixel + halfPixel);
            long w0 = Edge(p1, p2, s);
            long w1 = Edge(p2, p0, s);
            long w2 = Edge(p0, p1, s);
            if (w0 + bias0 < 0 || w1 + bias1 < 0 || w2 + bias2 < 0)
                continue;
            float depth = ((float)w0 * z0 + (float)w1 * z1 + (float)w2 * z2) * inverse;
            ulong value = ((ulong)AsUInt(Max(depth, 0)) << 32) | (ulong)id;
            a.Vis.AtomicMax(int2(x, y), value);
        }
    }
}

public struct TargetArgs
{
    public StorageTexture2D<ulong> Vis;
    public StorageTexture2D<float> Depth;
    public uint Width;
    public uint Height;
}

/// Clears the visibility buffer to depth 0 (the far plane under reverse-Z), cluster 0.
[Compute(8, 8, 1)]
public void VisClear([DispatchThreadId] uint3 id, [Push] in TargetArgs a)
{
    if (id.x >= a.Width || id.y >= a.Height)
        return;
    a.Vis[(int2)id.xy] = 0;
}

/// The depth half of the visibility buffer as a float texture.
[Compute(8, 8, 1)]
public void VisDepth([DispatchThreadId] uint3 id, [Push] in TargetArgs a)
{
    if (id.x >= a.Width || id.y >= a.Height)
        return;
    a.Depth[(int2)id.xy] = AsFloat((uint)(a.Vis[(int2)id.xy] >> 32));
}
