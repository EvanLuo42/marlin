namespace Marlin.Engine.Visibility;

// The visibility pipeline of one view (0009 §4.1, §4.3), one pass, hardware raster only:
//
// 1. `Reset` zeroes the counters.
// 2. `InstanceCull`: one thread per instance row; frustum test of its world sphere. Visible
//    instances append their hierarchy's root node to `Nodes`.
// 3. The DAG traversal, one `NodeArgs` + `NodeCull` pair per level of hierarchy nodes:
//    `NodeArgs` takes the nodes the last level appended as this level's, `NodeCull` tests each
//    of their children (8 threads a node): frustum, then the largest error below projected
//    against the budget (within it, nothing below is drawn). Passing children append to
//    `Nodes`, or to `Parts` for a leaf (a group's clusters in one page).
// 4. `PartArgs` + `ClusterCull`: one group per part. A part whose group's projected error is
//    within the budget draws nothing (the group is good enough, so a coarser one is drawn);
//    otherwise each of its clusters whose own LOD error projects within the budget is drawn
//    once it passes the frustum and normal-cone tests: it is appended to `Clusters`, whose index
//    is the cluster id the visibility buffer stores.
// 5. `FinishArgs` turns the cluster count into the mesh dispatch.
// 6. `VisMesh` + `VisPs`: one mesh group per visible cluster; each pixel keeps the nearest
//    `depth << 32 | cluster << 7 | triangle` with a 64-bit atomic max (no attachments).
// 7. `VisDepth` splits the depth out into an `R32Float` texture.
//
// The cut is the DAG's (0009 §3): the errors and spheres grow from children to parents and every
// test projects them with `ProjectedError`, so the cut is watertight.
//
// `Counters` words (atomics): 0 the visible instances, 1 the nodes appended, 2 the parts
// appended, 3 the visible clusters appended (each may pass its capacity), 4 the clusters drawn;
// 5 where the next level's nodes start, 6 and 7 the current level's range. `Args` (indirect
// arguments, a pass never both counts into and dispatches from one buffer) holds three records
// of the RHI's indirect dispatches: a constant (push word 31, unused here), then x, y, z. Words
// 0–3 are the node level's, 4–7 the cluster cull's, 8–11 the mesh dispatch.

using Marlin.Engine.Scene;

/// The view, as marlin-render's visibility passes upload it.
public struct View
{
    /// Matrices are column-major; `M * v` is the column-vector product.
    public float4x4 ViewProjection;
    /// World-space frustum planes (left, right, bottom, top, near): a point p is inside a plane
    /// when `Dot(plane.xyz, p) + plane.w >= 0`. The far plane is at infinity.
    public float4[5] Planes;
    /// xyz: the eye; w: pixels per world unit at distance 1.
    public float4 Eye;
    /// The screen-space error, in pixels, the cut may have.
    public float LodErrorPixels;
    public uint InstanceRows;
    /// Entries `Nodes`, `Parts` and `Clusters` hold.
    public uint NodeCapacity;
    public uint PartCapacity;
    public uint ClusterCapacity;
    public uint[3] Spare;
}

public struct CullArgs
{
    public Uniform<View> View;
    public ReadOnlyBuffer<InstanceData> Instances;
    public ReadOnlyBuffer<InstanceTransforms> Transforms;
    /// World bounding spheres: center, radius.
    public ReadOnlyBuffer<float4> Bounds;
    public ReadOnlyBuffer<MeshEntry> Meshes;
    /// Hierarchy nodes to test: instance row, node.
    public Buffer<uint2> Nodes;
    /// Group parts to test: instance row, part.
    public Buffer<uint2> Parts;
    public Buffer<uint> Counters;
    public Buffer<uint> Args;
    /// Visible clusters: instance row, `slot << 12 | cluster`.
    public Buffer<uint2> Clusters;
}

/// Groups per row of a dispatch (the smallest maximum every device allows); more go to rows.
const uint GroupsPerRow = 65535;

/// A hierarchy child that is a leaf: the rest is a part.
const uint LeafBit = 2147483648;
const uint NoChild = 4294967295;

/// A dispatch's linear group index.
uint GroupIndex(uint3 group) => group.x + group.y * GroupsPerRow;

/// An indirect dispatch record of `groups` groups at word `at` of the arguments.
void WriteDispatch(in CullArgs a, uint at, uint groups)
{
    a.Args[at] = 0;
    a.Args[at + 1] = Min(groups, GroupsPerRow);
    a.Args[at + 2] = (groups + GroupsPerRow - 1) / GroupsPerRow;
    a.Args[at + 3] = 1;
}

[Compute(1, 1, 1)]
public void Reset([Push] in CullArgs a)
{
    for (uint i = 0; i < 8; i++)
        a.Counters[i] = 0;
}

bool InFrustum(in View v, float3 center, float radius)
{
    for (uint i = 0; i < 5; i++)
    {
        float4 p = v.Planes[i];
        if (Dot(p.xyz, center) + p.w < -radius)
            return false;
    }
    return true;
}

/// The largest scale of a transform: its longest column.
float MaxScale(in Rows3x4 m)
{
    float3 x = float3(m.R0.x, m.R1.x, m.R2.x);
    float3 y = float3(m.R0.y, m.R1.y, m.R2.y);
    float3 z = float3(m.R0.z, m.R1.z, m.R2.z);
    return Sqrt(Max(Dot(x, x), Max(Dot(y, y), Dot(z, z))));
}

/// Whether a transform scales every axis alike (normal cones stay valid).
bool UniformScale(in Rows3x4 m)
{
    float3 x = float3(m.R0.x, m.R1.x, m.R2.x);
    float3 y = float3(m.R0.y, m.R1.y, m.R2.y);
    float3 z = float3(m.R0.z, m.R1.z, m.R2.z);
    float lo = Min(Dot(x, x), Min(Dot(y, y), Dot(z, z)));
    float hi = Max(Dot(x, x), Max(Dot(y, y), Dot(z, z)));
    return hi <= lo * 1.0001;
}

/// Object-space `error` measured over object-space `sphere`, in pixels: projected at the
/// sphere's near side. Larger spheres and errors project larger, so testing parents and
/// children against one budget gives a consistent cut.
float ProjectedError(in View v, in Rows3x4 t, float scale, float4 sphere, float error)
{
    float3 center = Apply(t, float4(sphere.xyz, 1));
    float distance = Max(Length(center - v.Eye.xyz) - sphere.w * scale, 0.0001);
    return error * scale * v.Eye.w / distance;
}

[Compute(64, 1, 1)]
public void InstanceCull([DispatchThreadId] uint3 id, [Push] in CullArgs a)
{
    View v = a.View.Value;
    uint row = id.x;
    if (row >= v.InstanceRows)
        return;
    InstanceData instance = a.Instances[row];
    // Hidden, or removed (the scatter hides removed rows).
    if ((instance.Flags & 1) != 0)
        return;
    MeshEntry mesh = a.Meshes[instance.Mesh];
    if (mesh.Resident == 0)
        return;
    float4 sphere = a.Bounds[row];
    if (!InFrustum(v, sphere.xyz, sphere.w))
        return;
    a.Counters.AtomicAdd(0, 1);
    uint slot = a.Counters.AtomicAdd(1, 1);
    if (slot < v.NodeCapacity)
        a.Nodes[slot] = uint2(row, 0);
}

/// The nodes appended since the last level become this level's.
[Compute(1, 1, 1)]
public void NodeArgs([Push] in CullArgs a)
{
    uint start = a.Counters[5];
    uint end = Min(a.Counters[1], a.View.Value.NodeCapacity);
    a.Counters[6] = start;
    a.Counters[7] = end;
    a.Counters[5] = end;
    WriteDispatch(a, 0, (end - start + 7) / 8);
}

[Compute(64, 1, 1)]
public void NodeCull([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in CullArgs a)
{
    View v = a.View.Value;
    uint item = a.Counters[6] + GroupIndex(group) * 8 + thread.x / 8;
    if (item >= a.Counters[7])
        return;
    uint2 node = a.Nodes[item];
    uint row = node.x;
    MeshEntry mesh = a.Meshes[a.Instances[row].Mesh];
    HierarchyChild child = LoadChild(mesh.Dag, node.y, thread.x & 7);
    if (child.Child == NoChild)
        return;
    Rows3x4 t = a.Transforms[row].Current;
    float scale = MaxScale(t);
    if (!InFrustum(v, Apply(t, float4(child.Sphere.xyz, 1)), child.Sphere.w * scale))
        return;
    // Every group below is good enough: nothing below is drawn. The margin keeps a group whose
    // error projects right at the budget here, so `ClusterCull` decides it.
    if (ProjectedError(v, t, scale, child.Sphere, child.MaxError) <= v.LodErrorPixels * 0.99)
        return;
    if ((child.Child & LeafBit) != 0)
    {
        uint slot = a.Counters.AtomicAdd(2, 1);
        if (slot < v.PartCapacity)
            a.Parts[slot] = uint2(row, child.Child & (LeafBit - 1));
    }
    else
    {
        uint slot = a.Counters.AtomicAdd(1, 1);
        if (slot < v.NodeCapacity)
            a.Nodes[slot] = uint2(row, child.Child);
    }
}

[Compute(1, 1, 1)]
public void PartArgs([Push] in CullArgs a)
{
    WriteDispatch(a, 4, Min(a.Counters[2], a.View.Value.PartCapacity));
}

/// A snorm8 in bits `shift` to `shift + 7` of `w`.
float Snorm8(uint w, uint shift)
{
    int b = (int)((w >> shift) & 255);
    if (b >= 128)
        b -= 256;
    return Max((float)b / 127, -1);
}

[Compute(32, 1, 1)]
public void ClusterCull([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in CullArgs a)
{
    View v = a.View.Value;
    uint index = GroupIndex(group);
    if (index >= Min(a.Counters[2], v.PartCapacity))
        return;
    uint2 item = a.Parts[index];
    uint row = item.x;
    MeshEntry mesh = a.Meshes[a.Instances[row].Mesh];
    DagPart part = LoadPart(mesh.Dag, item.y);
    Rows3x4 t = a.Transforms[row].Current;
    float scale = MaxScale(t);
    // The group is good enough: a coarser one draws this part of the surface.
    DagGroup g = LoadGroup(mesh.Dag, part.Group);
    if (ProjectedError(v, t, scale, g.Sphere, g.Error) <= v.LodErrorPixels)
        return;
    uint slot = PageSlot(mesh.Dag, part.Page);
    Page page = LoadPage(mesh.Pages, slot);
    bool cones = UniformScale(t);
    for (uint i = thread.x; i < part.ClusterCount; i += 32)
    {
        uint cluster = part.FirstCluster + i;
        Cluster c = LoadCluster(mesh.Pages, page, cluster);
        // Not good enough itself: finer clusters draw it.
        if (ProjectedError(v, t, scale, c.LodSphere, c.LodError) > v.LodErrorPixels)
            continue;
        float3 center = Apply(t, float4(c.Sphere.xyz, 1));
        float radius = c.Sphere.w * scale;
        if (!InFrustum(v, center, radius))
            continue;
        float cutoff = Snorm8(c.Cone, 24);
        // A cutoff of 1 (127) is a degenerate cone: never culled.
        if (cones && cutoff < 1)
        {
            float3 axis = Normalize(Apply(t, float4(Snorm8(c.Cone, 0), Snorm8(c.Cone, 8), Snorm8(c.Cone, 16), 0)));
            float3 d = center - v.Eye.xyz;
            if (Dot(d, axis) >= cutoff * Length(d) + radius)
                continue;
        }
        uint at = a.Counters.AtomicAdd(3, 1);
        if (at < v.ClusterCapacity)
            a.Clusters[at] = uint2(row, (slot << 12) | cluster);
    }
}

[Compute(1, 1, 1)]
public void FinishArgs([Push] in CullArgs a)
{
    uint count = Min(a.Counters[3], a.View.Value.ClusterCapacity);
    a.Counters[4] = count;
    WriteDispatch(a, 8, count);
}

public struct RasterArgs
{
    public Uniform<View> View;
    public ReadOnlyBuffer<InstanceData> Instances;
    public ReadOnlyBuffer<InstanceTransforms> Transforms;
    public ReadOnlyBuffer<MeshEntry> Meshes;
    public ReadOnlyBuffer<uint2> Clusters;
    public ReadOnlyBuffer<uint> Counters;
    public StorageTexture2D<ulong> Vis;
}

public struct VisVertex
{
    [Position] public float4 Pos;
}

public struct VisPrimitive
{
    /// `cluster << 7 | triangle`.
    [PrimitiveId] public uint Id;
}

[Mesh(128, 1, 1, MaxVertices = 128, MaxPrimitives = 128, Topology = MeshTopology.Triangle)]
public void VisMesh(
    [GroupId] uint3 group,
    [GroupThreadId] uint3 thread,
    [Push] in RasterArgs a,
    MeshOutput<VisVertex, VisPrimitive> o)
{
    uint cluster = GroupIndex(group);
    if (cluster >= a.Counters[4])
    {
        o.SetCounts(0, 0);
        return;
    }
    uint2 entry = a.Clusters[cluster];
    uint row = entry.x;
    MeshEntry mesh = a.Meshes[a.Instances[row].Mesh];
    ReadOnlyByteBuffer pool = mesh.Pages;
    Page page = LoadPage(pool, AddressSlot(entry.y));
    Cluster c = LoadCluster(pool, page, AddressCluster(entry.y));
    o.SetCounts(c.VertexCount, c.TriangleCount);
    uint i = thread.x;
    if (i < c.VertexCount)
    {
        float3 p = DecodePosition(pool, mesh, page, c.VertexOffset + i);
        float4 world = float4(Apply(a.Transforms[row].Current, float4(p, 1)), 1);
        o.Vertices[i] = VisVertex { Pos = a.View.Value.ViewProjection * world };
    }
    if (i < c.TriangleCount)
    {
        o.Triangles[i] = LoadTriangle(pool, page, c, i) - c.VertexOffset;
        o.Primitives[i] = VisPrimitive { Id = (cluster << 7) | i };
    }
}

[Pixel]
public void VisPs([Position] float4 position, [PrimitiveId] uint id, [Push] in RasterArgs a)
{
    // Reverse-Z: the nearest has the largest depth, and a non-negative float's bits order as
    // the float does.
    ulong value = ((ulong)AsUInt(position.z) << 32) | (ulong)id;
    a.Vis.AtomicMax((int2)position.xy, value);
}

public struct TargetArgs
{
    public StorageTexture2D<ulong> Vis;
    public StorageTexture2D<float> Depth;
    public uint Width;
    public uint Height;
}

/// Clears the visibility buffer to depth 0 (the far plane under reverse-Z), cluster 0.
[Compute(8, 8, 1)]
public void VisClear([DispatchThreadId] uint3 id, [Push] in TargetArgs a)
{
    if (id.x >= a.Width || id.y >= a.Height)
        return;
    a.Vis[(int2)id.xy] = 0;
}

/// The depth half of the visibility buffer as a float texture.
[Compute(8, 8, 1)]
public void VisDepth([DispatchThreadId] uint3 id, [Push] in TargetArgs a)
{
    if (id.x >= a.Width || id.y >= a.Height)
        return;
    a.Depth[(int2)id.xy] = AsFloat((uint)(a.Vis[(int2)id.xy] >> 32));
}
