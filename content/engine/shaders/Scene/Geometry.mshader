namespace Marlin.Engine.Scene;

// Resident geometry (0009 §3.2): a cooked mesh's cluster DAG on the GPU, decoded where it is
// read. marlin-render's `geometry` module lays it out: the pages in slots of the page pool, as
// cooked (`marlin_render::asset::cluster`'s streams, offsets from the slot's start), then the
// page table (a slot per page of every mesh, `0xFFFFFFFF` while the page is not resident); each
// mesh's resident part in its DAG buffer: four words (the groups' and parts' byte offsets, the
// byte offset of its page table entries in the pool, the node count), the hierarchy nodes from
// byte 16, the groups and the parts.
//
// A cluster is addressed as `slot << 12 | cluster`: its page's pool slot and its index in the
// page.

/// A row of the GPU Scene's mesh table.
public struct MeshEntry
{
    /// The page pool the mesh's pages are in.
    public ReadOnlyByteBuffer Pages;
    /// The mesh's DAG buffer.
    public ReadOnlyByteBuffer Dag;
    /// `MeshFlags`: 1 float positions, 2 skin, 4 color.
    public uint Flags;
    /// Bytes per vertex: positions | attributes << 8 | skin << 16.
    public uint Strides;
    /// Quantized positions decode as `PositionOffset + q * PositionScale`.
    public float3 PositionOffset;
    /// 1 once the geometry is on the GPU.
    public uint Resident;
    public float3 PositionScale;
    public uint UvSets;
    /// Local bounding sphere: center, radius.
    public float4 Sphere;
}

/// The slot of an address `slot << 12 | cluster`.
public uint AddressSlot(uint address) => address >> 12;

/// The cluster index in its page of an address `slot << 12 | cluster`.
public uint AddressCluster(uint address) => address & 4095;

/// Where a page's streams are in the pool: byte offsets from the pool's start.
public struct Page
{
    public uint ClusterCount;
    public uint Clusters;
    public uint UvRanges;
    public uint Positions;
    public uint Attributes;
    public uint Skin;
    public uint Triangles;
    public uint Sections;
}

/// The page in pool slot `slot` (its header: `PageHeader`).
public Page LoadPage(ReadOnlyByteBuffer pool, uint slot)
{
    // 128 KiB slots.
    uint at = slot * 131072;
    uint4 counts = pool.Load4(at);
    uint4 a = pool.Load4(at + 16);
    uint4 b = pool.Load4(at + 32);
    uint4 c = pool.Load4(at + 48);
    uint2 d = pool.Load2(at + 64);
    return Page
    {
        ClusterCount = counts.x,
        Clusters = at + a.x,
        UvRanges = at + a.z,
        Positions = at + b.x,
        Attributes = at + b.z,
        Skin = at + c.x,
        Triangles = at + c.z,
        Sections = at + d.x,
    };
}

/// A cluster as a page holds it (`ClusterRecord`).
public struct Cluster
{
    /// Culling sphere: center, radius.
    public float4 Sphere;
    /// The sphere and error of the simplification that made the cluster.
    public float4 LodSphere;
    public float LodError;
    /// Normal cone: axis and cutoff, snorm8 each.
    public uint Cone;
    /// The group the cluster is in.
    public uint Group;
    /// The group it was made from; `0xFFFFFFFF` at level 0.
    public uint SourceGroup;
    /// First vertex and triangle in the page's streams.
    public uint VertexOffset;
    public uint TriangleOffset;
    public uint VertexCount;
    public uint TriangleCount;
}

/// Cluster `i` of page `p`.
public Cluster LoadCluster(ReadOnlyByteBuffer pool, in Page p, uint i)
{
    uint at = p.Clusters + i * 64;
    uint4 w = pool.Load4(at + 32);
    uint4 x = pool.Load4(at + 48);
    return Cluster
    {
        Sphere = AsFloat(pool.Load4(at)),
        LodSphere = AsFloat(pool.Load4(at + 16)),
        LodError = AsFloat(w.x),
        Cone = w.y,
        Group = w.z,
        SourceGroup = w.w,
        VertexOffset = x.x,
        TriangleOffset = x.y,
        VertexCount = x.w & 255,
        TriangleCount = (x.w >> 8) & 255,
    };
}

/// Page vertex `v`'s object-space position.
public float3 DecodePosition(ReadOnlyByteBuffer pool, in MeshEntry m, in Page p, uint v)
{
    if ((m.Flags & 1) != 0)
        return AsFloat(pool.Load3(p.Positions + v * 12));
    uint2 w = pool.Load2(p.Positions + v * 8);
    float3 q = float3((float)(w.x & 65535), (float)(w.x >> 16), (float)(w.y & 65535));
    return m.PositionOffset + q * m.PositionScale;
}

/// An octahedral-encoded unit vector, each coordinate in [-1, 1].
public float3 OctDecode(float2 e)
{
    float z = 1 - Abs(e.x) - Abs(e.y);
    float t = Max(-z, 0);
    float x = e.x + (e.x >= 0 ? -t : t);
    float y = e.y + (e.y >= 0 ? -t : t);
    return Normalize(float3(x, y, z));
}

/// The normal of a packed tangent frame (`encode_tangent_frame`: bits 0–19).
public float3 DecodeNormal(uint frame)
{
    float2 e = float2((float)(frame & 1023), (float)((frame >> 10) & 1023)) / 1023 * 2 - 1;
    return OctDecode(e);
}

/// Page vertex `v`'s object-space normal.
public float3 DecodeVertexNormal(ReadOnlyByteBuffer pool, in MeshEntry m, in Page p, uint v)
{
    uint stride = (m.Strides >> 8) & 255;
    return DecodeNormal(pool.Load(p.Attributes + v * stride));
}

/// Triangle `t` of cluster `c`: its corners as page vertex indices.
public uint3 LoadTriangle(ReadOnlyByteBuffer pool, in Page p, in Cluster c, uint t)
{
    uint w = pool.Load(p.Triangles + (c.TriangleOffset + t) * 4);
    return uint3(w & 255, (w >> 8) & 255, (w >> 16) & 255) + c.VertexOffset;
}

/// A group of the DAG (`ClusterGroup`).
public struct DagGroup
{
    /// Encloses the LOD spheres of its clusters.
    public float4 Sphere;
    /// Object-space simplification error; +∞ for a root group.
    public float Error;
    public uint FirstPart;
    public uint PartCount;
}

public DagGroup LoadGroup(ReadOnlyByteBuffer dag, uint group)
{
    uint at = dag.Load(0) + group * 32;
    return DagGroup
    {
        Sphere = AsFloat(dag.Load4(at)),
        Error = AsFloat(dag.Load(at + 16)),
        FirstPart = dag.Load(at + 24),
        PartCount = dag.Load(at + 28),
    };
}

/// A group's clusters in one page (`GroupPart`).
public struct DagPart
{
    public uint Page;
    public uint FirstCluster;
    public uint ClusterCount;
    public uint Group;
}

public DagPart LoadPart(ReadOnlyByteBuffer dag, uint part)
{
    uint4 w = dag.Load4(dag.Load(4) + part * 16);
    return DagPart { Page = w.x, FirstCluster = w.y, ClusterCount = w.z, Group = w.w };
}

/// The byte offset in the pool of page `page`'s table entry.
public uint PageEntry(ReadOnlyByteBuffer dag, uint page) => dag.Load(8) + page * 4;

/// The pool slot of page `page`, or `0xFFFFFFFF` while it is not resident.
public uint PageSlot(ReadOnlyByteBuffer pool, ReadOnlyByteBuffer dag, uint page) => pool.Load(PageEntry(dag, page));

/// Whether every page of group `group` is resident.
public bool GroupResident(ReadOnlyByteBuffer pool, ReadOnlyByteBuffer dag, uint group)
{
    DagGroup g = LoadGroup(dag, group);
    for (uint i = 0; i < g.PartCount; i++)
    {
        if (PageSlot(pool, dag, LoadPart(dag, g.FirstPart + i).Page) == 4294967295)
            return false;
    }
    return true;
}

/// A child of a hierarchy node (`HierarchyChild`).
public struct HierarchyChild
{
    /// Encloses the spheres of every group below.
    public float4 Sphere;
    /// The largest group error below.
    public float MaxError;
    /// A node, `0x80000000 | part` for a leaf, or `0xFFFFFFFF` for none.
    public uint Child;
}

/// Child `i` (of 8) of hierarchy node `node`.
public HierarchyChild LoadChild(ReadOnlyByteBuffer dag, uint node, uint i)
{
    uint at = 16 + node * 192 + i * 24;
    uint2 w = dag.Load2(at + 16);
    return HierarchyChild { Sphere = AsFloat(dag.Load4(at)), MaxError = AsFloat(w.x), Child = w.y };
}
