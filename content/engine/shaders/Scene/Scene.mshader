namespace Marlin.Engine.Scene;

// The GPU Scene (0009 §2): the render scene's tables as buffers, one row per instance, mesh or
// light, the row being the scene's handle index. marlin-render's `scene::gpu` writes them with
// the scatter pass below; its module docs list the layouts.

/// A 3x4 matrix as three rows: the affine transform without its constant last row.
public struct Rows3x4
{
    public float4 R0;
    public float4 R1;
    public float4 R2;
}

/// `m` applied to `v` (w = 1 for a point, 0 for a direction).
public float3 Apply(Rows3x4 m, float4 v) => float3(Dot(m.R0, v), Dot(m.R1, v), Dot(m.R2, v));

public struct InstanceData
{
    /// The mesh's row in the mesh table.
    public uint Mesh;
    public uint Flags;
    /// The material's row in the material table; `0xFFFFFFFF`: none.
    public uint Material;
    public uint Spare;
    /// Linear RGBA: the material's per-instance data (`SurfaceContext.CustomData`).
    public float4 Color;
}

/// A row of the material table.
public struct MaterialEntry
{
    /// The resolve permutation that draws it; `0xFFFFFFFF`: removed.
    public uint Permutation;
    /// Its row in the permutation's parameter table.
    public uint Slot;
    public uint2 Spare;
}

/// An instance's current transform.
public struct InstanceTransforms
{
    public Rows3x4 Current;
    /// Last frame's: for motion vectors.
    public Rows3x4 Previous;
}

public struct ScatterArgs
{
    /// One op per row: x = the row's first word in the table, y = what to do, z = first data
    /// word, w = words.
    public ReadOnlyBuffer<uint4> Ops;
    public ReadOnlyBuffer<uint> Data;
    /// A writable raw view of the table.
    public ByteBuffer Table;
    public uint Count;
}

/// One thread per op, one dispatch per table. Kind 0 writes `w` words of data at the row; kind
/// 1 (transforms) copies the current transform over the previous one; kind 2 does that, then
/// writes the new current.
[Compute(64, 1, 1)]
public void Scatter([DispatchThreadId] uint3 id, [Push] in ScatterArgs a)
{
    if (id.x >= a.Count)
        return;
    uint4 op = a.Ops[id.x];
    uint first = op.x * 4;
    if (op.y != 0)
    {
        for (uint i = 0; i < 12; i++)
            a.Table.Store(first + (12 + i) * 4, a.Table.Load(first + i * 4));
    }
    for (uint i = 0; i < op.w; i++)
        a.Table.Store(first + i * 4, a.Data[op.z + i]);
}
