namespace Marlin.Engine.Scene;

// The GPU Scene (0009 §2): the render scene's tables as buffers, one row per instance, mesh or
// light, the row being the scene's handle index. marlin-render's `scene::gpu` writes them with
// the scatter pass below; its module docs list the layouts.

/// A 3x4 matrix as three rows: the affine transform without its constant last row.
public struct Rows3x4
{
    public float4 R0;
    public float4 R1;
    public float4 R2;
}

/// `m` applied to `v` (w = 1 for a point, 0 for a direction).
public float3 Apply(Rows3x4 m, float4 v) => float3(Dot(m.R0, v), Dot(m.R1, v), Dot(m.R2, v));

public struct InstanceData
{
    /// The mesh's row in the mesh table.
    public uint Mesh;
    public uint Flags;
    public uint2 Spare;
    /// Linear RGBA (until materials replace it).
    public float4 Color;
}

public struct InstanceTransforms
{
    public Rows3x4 Current;
    /// Last frame's: for motion vectors.
    public Rows3x4 Previous;
}

public struct ScatterArgs
{
    /// One op per row: x = table | kind << 8, y = row, z = first data word, w = words.
    public ReadOnlyBuffer<uint4> Ops;
    public ReadOnlyBuffer<uint> Data;
    /// Writable raw views of the tables: instance data, transforms, bounds, meshes, lights.
    public ByteBuffer InstanceData;
    public ByteBuffer Transforms;
    public ByteBuffer Bounds;
    public ByteBuffer Meshes;
    public ByteBuffer Lights;
    public uint Count;
}

/// Words per row of table `t`.
uint Stride(uint t) => t == 0 ? 8 : t == 1 ? 24 : t == 2 ? 4 : t == 3 ? 8 : 16;

uint Read(in ScatterArgs a, uint t, uint word)
{
    uint at = word * 4;
    if (t == 0)
        return a.InstanceData.Load(at);
    if (t == 1)
        return a.Transforms.Load(at);
    if (t == 2)
        return a.Bounds.Load(at);
    if (t == 3)
        return a.Meshes.Load(at);
    return a.Lights.Load(at);
}

void Write(in ScatterArgs a, uint t, uint word, uint value)
{
    uint at = word * 4;
    if (t == 0)
        a.InstanceData.Store(at, value);
    else if (t == 1)
        a.Transforms.Store(at, value);
    else if (t == 2)
        a.Bounds.Store(at, value);
    else if (t == 3)
        a.Meshes.Store(at, value);
    else
        a.Lights.Store(at, value);
}

/// One thread per op. Kind 0 writes `w` words of data at the row; kind 1 (transforms) copies
/// the current transform over the previous one; kind 2 does that, then writes the new current.
[Compute(64, 1, 1)]
public void Scatter([DispatchThreadId] uint3 id, [Push] in ScatterArgs a)
{
    if (id.x >= a.Count)
        return;
    uint4 op = a.Ops[id.x];
    uint table = op.x & 255;
    uint kind = op.x >> 8;
    uint first = op.y * Stride(table);
    if (kind != 0)
    {
        for (uint i = 0; i < 12; i++)
            Write(a, table, first + 12 + i, Read(a, table, first + i));
    }
    for (uint i = 0; i < op.w; i++)
        Write(a, table, first + i, a.Data[op.z + i]);
}
