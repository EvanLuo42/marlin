!Version 1

// The engine's own shaders: one package, a namespace per directory (this one is
// `Marlin.Engine`, a subdirectory `Post/` would be `Marlin.Engine.Post`). The engine finds the
// cooked library by the package's name and each entry point by its full path.
ShaderPackage
{
    !Uuid = "01a14e23-41a7-7240-a3d8-65abdeb55b0e"
    !Name = "Marlin.Engine"
    Sources = [
        `source:shaders/DefaultMaterial.mshader`,
        `source:shaders/Lighting/Lighting.mshader`,
        `source:shaders/Material/Material.mshader`,
        `source:shaders/Post/Post.mshader`,
        `source:shaders/Scene/Geometry.mshader`,
        `source:shaders/Scene/Scene.mshader`,
        `source:shaders/Streaming/Streaming.mshader`,
        `source:shaders/Ui/Ui.mshader`,
        `source:shaders/Visibility/Visibility.mshader`,
    ]
    Dependencies = [<substrate/package:Marlin.Substrate #019a3c40-5b21-7d10-9a6e-3f1c2b4d5e60>]
}
