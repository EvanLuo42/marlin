namespace Marlin.Engine.Shadows;

// Virtual shadow maps for the sun (0010 §5.3): a clipmap of square levels around the camera,
// each `VirtualResolution`² texels in pages of `PageSize`² texels, level k twice the extent of
// level k − 1. Pages are cached across frames: the physical pool, a cache table (a virtual
// page's last physical page) and a tag per physical page (the level, the page's absolute
// position and the generation it was drawn in) persist. marlin-render's `Vsm` declares, a
// frame:
//
// 1. `VsmMark`: every screen pixel's surface, in the level whose texels are about its size,
//    marks the pages its filter reads.
// 2. `VsmInvalidate`: physical pages under a world sphere whose shadow changed (an instance
//    moved, appeared, vanished or streamed in finer) lose their tag.
// 3. `VsmKeep`: a marked page whose cached physical page still carries its tag keeps it.
// 4. `VsmFreeList`: the pages not kept, those without a valid tag first, then the cached ones
//    nothing marked (evicted only when the first run out).
// 5. `VsmAllocate`: every marked page: its kept page, or the next free one, tagged and marked
//    `Render` in the frame's page table; `0xFFFFFFFF` when not marked or the pool ran out;
//    the pages drawn are listed per level (`Drawn`).
// 6. `VsmClearArgs` + `VsmClear`: the pages taken are cleared to depth 0 (farthest from the
//    light).
// 7. Each level, the visibility passes in orthographic mode draw the clusters over its
//    `Render` pages, a cluster over each page on its own;
//    `Marlin.Engine.Visibility.ShadowPs` keeps the depth nearest the light per texel.
// 8. `VsmMask`: every pixel's sun visibility in its level, a 3×3 percentage-closer filter (L0)
//    or rays marched toward the sun's disk (SMRT, L1–L2), into the shadow mask the lighting
//    multiplies the sun by.
//
// A level's pages are world-anchored: page p of the level (from its first page) is absolute
// page `Origin + p` and sits in table slot `(p + Offset) mod PagesPerSide`, `Offset` being
// `Origin mod PagesPerSide`, so a page keeps its slot while the level moves with the camera.
//
// Light depth: about 0.5 at the camera (its center snaps in steps), larger toward the light,
// `DepthPerUnit` a world unit.

using Marlin.Substrate;

/// A level of the clipmap.
public struct VsmLevel
{
    /// World to the level's clip space (orthographic; x, y in [-1, 1] over the level, z the
    /// light depth). Column-major.
    public float4x4 ViewProjection;
    /// The level's texel, in world units.
    public float Texel;
    public uint Spare;
    /// The absolute page of the level's first page, and its slot: `Origin mod PagesPerSide`.
    public int2 Origin;
    public uint2 Offset;
}

public struct VsmConstants
{
    /// The camera's clip space to world. Column-major.
    public float4x4 InverseViewProjection;
    /// xyz: the camera; w: a pixel's size in world units at distance 1.
    public float4 Eye;
    /// The screen.
    public uint Width;
    public uint Height;
    public uint Levels;
    public uint VirtualResolution;
    public uint PageSize;
    /// Pages per side of a level.
    public uint PagesPerSide;
    /// Physical pages per row of the pool, and pages in it.
    public uint PoolPagesPerRow;
    public uint PoolPages;
    /// Level 0's texel, in world units.
    public float FirstTexel;
    /// Light depth per world unit.
    public float DepthPerUnit;
    /// How far the surface is pushed along its normal, and toward the light, before the test:
    /// in texels of its level.
    public float NormalOffset;
    public float DepthBias;
    /// 1 when `MaterialBuffer` gives the surfaces' normals.
    public uint Normals;
    /// Pages drawn in another generation (another sun, depth center or clipmap) are stale.
    public uint Generation;
    /// Spheres in `Invalidations`.
    public uint InvalidationCount;
    /// 0: a 3×3 PCF; else the SMRT rays per pixel, and steps per ray.
    public uint SmrtRays;
    public uint SmrtSteps;
    /// The texels of its level a ray spreads over, and the tangent of the sun's angular radius.
    public float PenumbraTexels;
    public float TanSunRadius;
    /// How far from the receiver, in texels, a ray may start.
    public float DitherTexels;
}

public struct VsmArgs
{
    public Uniform<VsmConstants> Constants;
    public ReadOnlyBuffer<VsmLevel> Levels;
    /// The camera's depth (`R32Float`, reverse-Z, 0 where nothing is).
    public Texture2D<float> Depth;
    /// The material buffer: the surfaces' normals.
    public Texture2D<uint4> MaterialBuffer;
    /// A word per table slot (virtual page of every level): marked.
    public Buffer<uint> Requests;
    /// A word per table slot: this frame's physical page, `| Render` if it is drawn this
    /// frame, or `0xFFFFFFFF`.
    public Buffer<uint> PageTable;
    /// 0: pages taken (may pass the free ones); 1, 2: free pages without a tag, and cached
    /// ones; 3: marked pages found cached.
    public Buffer<uint> Counters;
    public Buffer<uint> Args;
    public StorageTexture2D<uint> Pool;
    public StorageTexture2D<float> Mask;
    /// The pool, read (the mask).
    public Texture2D<uint> Stored;
    /// Persistent: a word per table slot: the physical page it last had, or `0xFFFFFFFF`.
    public Buffer<uint> Cache;
    /// Persistent: per physical page, what it holds: level, absolute page (x, y), generation;
    /// x `0xFFFFFFFF` when nothing valid.
    public Buffer<uint4> Tags;
    /// A word per physical page: kept this frame.
    public Buffer<uint> Keep;
    /// Free physical pages: those without a tag from 0, cached ones from `PoolPages`.
    public Buffer<uint> Free;
    /// World spheres (center, radius) whose shadow changed.
    public ReadOnlyBuffer<float4> Invalidations;
    /// Per level, from `level * (PoolPages + 1)`: the count of its pages drawn this frame, then
    /// each one (`x | y << 16`, from the level's first page).
    public Buffer<uint> Drawn;
}

const uint NotMapped = 4294967295;
/// A page table entry's bit: the page is drawn this frame.
const uint Render = 2147483648;
const uint PhysicalBits = 2147483647;

/// The world position of screen pixel `px` at `depth`.
float3 WorldOf(in VsmConstants c, uint2 px, float depth)
{
    float2 ndc = float2(((float)px.x + 0.5) / (float)c.Width * 2 - 1, 1 - ((float)px.y + 0.5) / (float)c.Height * 2);
    float4 p = c.InverseViewProjection * float4(ndc, depth, 1);
    return p.xyz / p.w;
}

/// `world`'s position in the texels of `level`, and its light depth.
float2 TexelOf(in VsmConstants c, in VsmLevel l, float3 world, out float depth)
{
    float4 clip = l.ViewProjection * float4(world, 1);
    float size = (float)c.VirtualResolution;
    depth = clip.z;
    return float2((clip.x * 0.5 + 0.5) * size, (0.5 - clip.y * 0.5) * size);
}

/// The finest level whose texels are no smaller than a pixel at `world` (or the last) and that
/// holds it;
/// `c.Levels` if none does. `texel` is the position in the level's texels, `depth` its light
/// depth.
uint LevelOf(in VsmConstants c, in VsmArgs a, float3 world, out float2 texel, out float depth)
{
    float footprint = Length(world - c.Eye.xyz) * c.Eye.w;
    // A texel finer than the pixel is only sharper: past the last level, the last.
    uint level = Min((uint)Max(Ceil(Log2(Max(footprint / c.FirstTexel, 1))), 0), c.Levels - 1);
    float size = (float)c.VirtualResolution;
    for (; level < c.Levels; level++)
    {
        texel = TexelOf(c, a.Levels[level], world, out depth);
        // A margin of two texels for the filter.
        if (texel.x >= 2 && texel.y >= 2 && texel.x < size - 2 && texel.y < size - 2)
            return level;
    }
    texel = float2(0, 0);
    depth = 0;
    return c.Levels;
}

/// The table slot of page `page` (from the level's first) of `level`.
uint SlotOf(in VsmConstants c, in VsmLevel l, uint level, uint2 page)
{
    uint2 s = (page + l.Offset) % c.PagesPerSide;
    return (level * c.PagesPerSide + s.y) * c.PagesPerSide + s.x;
}

/// The table slot of the page holding `texel` of `level` (in range).
uint PageIndex(in VsmConstants c, in VsmArgs a, uint level, int2 texel)
{
    uint2 page = uint2((uint)texel.x, (uint)texel.y) / c.PageSize;
    return SlotOf(c, a.Levels[level], level, page);
}

/// What the physical page of table slot `slot` holds when it is current: its level, absolute
/// page and the generation.
uint4 TagOf(in VsmConstants c, in VsmArgs a, uint slot)
{
    uint perLevel = c.PagesPerSide * c.PagesPerSide;
    uint level = slot / perLevel;
    uint within = slot % perLevel;
    VsmLevel l = a.Levels[level];
    uint n = c.PagesPerSide;
    // The page from the level's first, undoing the wrap.
    uint2 page = (uint2(within % n, within / n) + uint2(n, n) - l.Offset) % n;
    int2 absolute = l.Origin + int2((int)page.x, (int)page.y);
    return uint4(level, (uint)absolute.x, (uint)absolute.y, c.Generation);
}

bool SameTag(uint4 a, uint4 b) => a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w;

[Compute(8, 8, 1)]
public void VsmMark([DispatchThreadId] uint3 id, [Push] in VsmArgs a)
{
    VsmConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    float depth = a.Depth.Load((int2)id.xy);
    if (depth <= 0)
        return;
    uint level = LevelOf(c, a, WorldOf(c, id.xy, depth), out float2 texel, out float light);
    if (level >= c.Levels)
        return;
    // The pages under the filter's corners: the PCF's texels, or as far as the rays spread
    // (at most half a page, so the corners' pages are all of them), within the level.
    float margin = Max(1.5, c.PenumbraTexels + c.DitherTexels + 1.5);
    float last = (float)c.VirtualResolution - 1;
    int2 lo = int2((int)Floor(Max(texel.x - margin, 0)), (int)Floor(Max(texel.y - margin, 0)));
    int2 hi = int2((int)Floor(Min(texel.x + margin, last)), (int)Floor(Min(texel.y + margin, last)));
    a.Requests[PageIndex(c, a, level, lo)] = 1;
    a.Requests[PageIndex(c, a, level, int2(hi.x, lo.y))] = 1;
    a.Requests[PageIndex(c, a, level, int2(lo.x, hi.y))] = 1;
    a.Requests[PageIndex(c, a, level, hi)] = 1;
}

[Compute(64, 1, 1)]
public void VsmInvalidate([DispatchThreadId] uint3 id, [Push] in VsmArgs a)
{
    VsmConstants c = a.Constants.Value;
    if (id.x >= c.PoolPages)
        return;
    uint4 tag = a.Tags[id.x];
    if (tag.x >= c.Levels)
        return;
    VsmLevel l = a.Levels[tag.x];
    // The page's texels in the level as it is now (it may lie outside).
    float2 lo = (float2((float)((int)tag.y - l.Origin.x), (float)((int)tag.z - l.Origin.y))) * (float)c.PageSize;
    float2 hi = lo + float2((float)c.PageSize, (float)c.PageSize);
    for (uint i = 0; i < c.InvalidationCount; i++)
    {
        float4 sphere = a.Invalidations[i];
        float2 center = TexelOf(c, l, sphere.xyz, out float depth);
        // A texel more for the raster's rounding.
        float radius = sphere.w / l.Texel + 1;
        float2 nearest = Clamp(center, lo, hi);
        if (Length(center - nearest) <= radius)
        {
            a.Tags[id.x] = uint4(NotMapped, 0, 0, 0);
            return;
        }
    }
}

[Compute(64, 1, 1)]
public void VsmKeep([DispatchThreadId] uint3 id, [Push] in VsmArgs a)
{
    VsmConstants c = a.Constants.Value;
    if (id.x >= c.Levels * c.PagesPerSide * c.PagesPerSide || a.Requests[id.x] == 0)
        return;
    uint physical = a.Cache[id.x];
    if (physical < c.PoolPages && SameTag(a.Tags[physical], TagOf(c, a, id.x)))
        a.Keep[physical] = 1;
}

[Compute(64, 1, 1)]
public void VsmFreeList([DispatchThreadId] uint3 id, [Push] in VsmArgs a)
{
    VsmConstants c = a.Constants.Value;
    if (id.x >= c.PoolPages || a.Keep[id.x] != 0)
        return;
    uint4 tag = a.Tags[id.x];
    if (tag.x == NotMapped || tag.w != c.Generation)
        a.Free[a.Counters.AtomicAdd(1, 1)] = id.x;
    else
        a.Free[c.PoolPages + a.Counters.AtomicAdd(2, 1)] = id.x;
}

/// The `i`th free page, those without a tag first; `NotMapped` past the last.
uint FreePage(in VsmConstants c, in VsmArgs a, uint i)
{
    uint untagged = a.Counters[1];
    if (i < untagged)
        return a.Free[i];
    if (i - untagged < a.Counters[2])
        return a.Free[c.PoolPages + i - untagged];
    return NotMapped;
}

[Compute(64, 1, 1)]
public void VsmAllocate([DispatchThreadId] uint3 id, [Push] in VsmArgs a)
{
    VsmConstants c = a.Constants.Value;
    uint pages = c.Levels * c.PagesPerSide * c.PagesPerSide;
    if (id.x >= pages)
        return;
    if (a.Requests[id.x] == 0)
    {
        a.PageTable[id.x] = NotMapped;
        return;
    }
    uint4 tag = TagOf(c, a, id.x);
    uint physical = a.Cache[id.x];
    // Kept pages are not handed out, so their tags hold still.
    if (physical < c.PoolPages && a.Keep[physical] != 0 && SameTag(a.Tags[physical], tag))
    {
        a.PageTable[id.x] = physical;
        a.Counters.AtomicAdd(3, 1);
        return;
    }
    physical = FreePage(c, a, a.Counters.AtomicAdd(0, 1));
    a.Cache[id.x] = physical;
    if (physical == NotMapped)
    {
        a.PageTable[id.x] = NotMapped;
        return;
    }
    a.Tags[physical] = tag;
    a.PageTable[id.x] = physical | Render;
    // Each physical page goes to one slot, so a level draws at most `PoolPages`.
    uint n = c.PagesPerSide;
    uint level = id.x / (n * n);
    uint within = id.x % (n * n);
    uint2 page = (uint2(within % n, within / n) + uint2(n, n) - a.Levels[level].Offset) % n;
    uint list = level * (c.PoolPages + 1);
    a.Drawn[list + 1 + a.Drawn.AtomicAdd(list, 1)] = page.x | (page.y << 16);
}

/// Groups per row of a dispatch; more go to rows.
const uint GroupsPerRow = 65535;

[Compute(1, 1, 1)]
public void VsmClearArgs([Push] in VsmArgs a)
{
    VsmConstants c = a.Constants.Value;
    uint taken = Min(a.Counters[0], a.Counters[1] + a.Counters[2]);
    uint tiles = taken * (c.PageSize / 8) * (c.PageSize / 8);
    a.Args[0] = 0;
    a.Args[1] = Min(tiles, GroupsPerRow);
    a.Args[2] = (tiles + GroupsPerRow - 1) / GroupsPerRow;
    a.Args[3] = 1;
}

/// The physical page `physical`'s first texel in the pool.
uint2 PageOrigin(in VsmConstants c, uint physical) =>
    uint2(physical % c.PoolPagesPerRow, physical / c.PoolPagesPerRow) * c.PageSize;

[Compute(8, 8, 1)]
public void VsmClear([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in VsmArgs a)
{
    VsmConstants c = a.Constants.Value;
    uint tile = group.x + group.y * GroupsPerRow;
    uint perSide = c.PageSize / 8;
    uint page = FreePage(c, a, tile / (perSide * perSide));
    uint within = tile % (perSide * perSide);
    uint2 at = PageOrigin(c, page) + uint2(within % perSide, within / perSide) * 8 + thread.xy;
    a.Pool[int2((int)at.x, (int)at.y)] = 0;
}

/// The depth nearest the light at `texel` of `level`; 0 (nothing) where no page is mapped.
float Stored(in VsmConstants c, in VsmArgs a, uint level, int2 texel)
{
    uint physical = a.PageTable[PageIndex(c, a, level, texel)];
    if (physical == NotMapped)
        return 0;
    physical = physical & PhysicalBits;
    uint2 at = PageOrigin(c, physical) + uint2((uint)texel.x, (uint)texel.y) % c.PageSize;
    return AsFloat(a.Stored.Load(int2((int)at.x, (int)at.y)));
}

/// Interleaved gradient noise of pixel `px`, in [0, 1). The same every frame until a temporal
/// filter (TSR) can average frames.
float Noise(uint2 px) => Frac(52.9829189 * Frac(0.06711056 * (float)px.x + 0.00583715 * (float)px.y));

/// The fraction of the sun a receiver at `texel` of `level`, light depth `depth` (biased),
/// sees: `c.SmrtRays` rays toward points of the sun's disk (a Vogel spiral turned by `noise`),
/// each marched in `c.SmrtSteps` steps through the level's texels, closer together near the
/// receiver. A ray moving t world units toward the light spreads `t · TanSunRadius` across it
/// and gains `t · DepthPerUnit` of depth; it is blocked where something nearer the light is
/// stored. Its last step, at its full length, sees every occluder farther along.
float Smrt(in VsmConstants c, in VsmArgs a, uint level, float2 texel, float depth, float noise)
{
    float texelSize = a.Levels[level].Texel;
    float length = c.PenumbraTexels * texelSize / c.TanSunRadius;
    // Texels a ray spreads per world unit, at the disk's edge.
    float spread = c.TanSunRadius / texelSize;
    float size = (float)c.VirtualResolution;
    float rays = (float)c.SmrtRays;
    float steps = (float)c.SmrtSteps;
    // Steps grow geometrically from a texel away to the ray's length: an occluder is a height
    // field to the shadow map, so a step anywhere between the receiver and its top finds it,
    // and the first steps find the near ones before the ray spreads.
    float first = Min(texelSize, length);
    float ratio = steps > 1 ? Pow(length / first, 1 / (steps - 1)) : 1;
    float reached = 0;
    for (uint r = 0; r < c.SmrtRays; r++)
    {
        float radius = Sqrt(((float)r + 0.5) / rays);
        float angle = (noise + (float)r * 0.381966) * 6.2831853;
        float2 disk = float2(Cos(angle), Sin(angle)) * radius;
        // Where the ray starts: a point of a disk of `DitherTexels` around the receiver (R2
        // sequence over the rays, turned by the noise).
        float startAngle = (Frac(noise * 7) + (float)r * 0.5698403) * 6.2831853;
        float startRadius = Sqrt(Frac(noise + ((float)r + 0.5) * 0.7548777)) * c.DitherTexels;
        float2 start = texel + float2(Cos(startAngle), Sin(startAngle)) * startRadius;
        float jitter = Frac(noise + (float)r * 0.618034);
        float lit = 1;
        for (uint i = 0; i < c.SmrtSteps; i++)
        {
            float k = i + 1 == c.SmrtSteps ? steps - 1 : (float)i + jitter;
            float t = first * Pow(ratio, k);
            float2 at = start + disk * (spread * t);
            if (at.x < 0 || at.y < 0 || at.x >= size || at.y >= size)
                break;
            if (Stored(c, a, level, int2((int)Floor(at.x), (int)Floor(at.y))) > depth + t * c.DepthPerUnit)
            {
                lit = 0;
                break;
            }
        }
        reached += lit;
    }
    return reached / rays;
}

[Compute(8, 8, 1)]
public void VsmMask([DispatchThreadId] uint3 id, [Push] in VsmArgs a)
{
    VsmConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    int2 px = (int2)id.xy;
    float depth = a.Depth.Load(px);
    if (depth <= 0)
    {
        a.Mask[px] = 1;
        return;
    }
    float3 world = WorldOf(c, id.xy, depth);
    uint level = LevelOf(c, a, world, out float2 texel, out float light);
    if (level >= c.Levels)
    {
        a.Mask[px] = 1;
        return;
    }
    // Off the surface along its normal, by its level's texel, so it does not shadow itself.
    float size = a.Levels[level].Texel;
    uint4 encoded = uint4(0, 0, 0, 0);
    if (c.Normals != 0)
        encoded = a.MaterialBuffer.Load(px);
    Proxy p = UnpackProxy(encoded);
    if (p.Count != 0)
    {
        world += p.Normal * (c.NormalOffset * size);
        texel = TexelOf(c, a.Levels[level], world, out light);
    }
    float receiver = light + c.DepthBias * size * c.DepthPerUnit;
    if (c.SmrtRays != 0)
    {
        a.Mask[px] = Smrt(c, a, level, texel, receiver, Noise(id.xy));
        return;
    }
    // 3×3 texels around the nearest: lit where nothing nearer the light is stored.
    int2 center = int2((int)Floor(texel.x), (int)Floor(texel.y));
    float lit = 0;
    for (int dy = -1; dy <= 1; dy++)
    {
        for (int dx = -1; dx <= 1; dx++)
            lit += Stored(c, a, level, center + int2(dx, dy)) > receiver ? 0 : 1;
    }
    a.Mask[px] = lit / 9;
}
