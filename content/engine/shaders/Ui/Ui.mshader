namespace Marlin.Engine.Ui;

// The UI renderer's passes (docs/design/0012-ui-renderer.md §5), all compute but the encode:
//
// 1. `Bounds`: one thread per command: its screen bounding box and opaque interior.
// 2. `Bin`: one thread per command: a bit per (256-command chunk, 256 × 256 bin) mask word for
//    every bin the bounds touch.
// 3. `Coarse`: one workgroup per bin, one thread per 16 × 16 tile: walks the masks in command
//    order and appends each command that reaches the tile to the tile's list; an opaque command
//    covering the whole tile empties the list first. Lists are 32-word blocks from a pool.
//    `PathTiles`, beside them: every path segment walked through the tiles it crosses, giving
//    each tile of a path its segments and its backdrop (the winding number at its corner).
// 4. `Fine`: one workgroup per tile, one thread per pixel: every listed command's coverage and
//    color, blended in registers (premultiplied, sRGB-encoded), into the UI target.
// 5. `EncodeVs`/`EncodePs`: the UI target into the swapchain.
//
// The command format is `marlin_ui_render::command`'s, and every function here mirrors
// `marlin_ui_render::shape`, which is the CPU reference the tests compare with.

public struct UiFrame
{
    public uint Width;
    public uint Height;
    public uint Commands;
    /// 256-command chunks.
    public uint Chunks;
    public uint BinsX;
    public uint BinsY;
    public uint TilesX;
    public uint TilesY;
    /// Blocks in the tile list pool.
    public uint PoolBlocks;
    /// Tile hashes start from it.
    public uint Salt;
    /// Nonzero: every tile is dirty.
    public uint Force;
    /// Layers the frame is drawn in (backdrop blurs, §5.6); `CoarseArgs.LayerStarts` holds them.
    public uint Layers;
    /// Premultiplied, sRGB-encoded.
    public float4 Clear;
}

/// A paint: solid (kind 0) or image (kind 1, with its texture and sampler).
public struct UiPaint
{
    public uint Kind;
    /// RGBA8, sRGB, straight alpha.
    public uint Color;
    public Texture2D<float4> Texture;
    public Sampler Sampler;
}

const uint KindRect = 1;
const uint KindCircle = 2;
const uint KindLine = 3;
const uint KindTriangle = 4;
const uint KindGlyph = 5;
const uint KindImage = 6;
const uint KindEffect = 7;
const uint KindPath = 8;
const uint KindBlur = 9;

/// The payload word a path's segments start at (`marlin_ui_render::path::SEGMENTS`).
const uint PathSegments = 9;
/// Words of a path's record: its payload offset, its tile grid x0 y0 x1 y1 (tiles), its first
/// tile in the path tiles.
const uint PathRecordWords = 8;
/// Words of a path tile: the backdrop (`int`; a delta before the prefix sum), its segments, its
/// first entry, the entries written.
const uint PathTileWords = 4;
/// Fixed-point units of path coverage (`marlin_ui_render::path::COVERAGE_UNIT`).
const float CoverageUnit = 1048576;

/// Members a group effect follows exactly (`marlin_ui_render::list::MAX_EFFECT_MEMBERS`).
const uint MaxEffectMembers = 16;

const uint FlagOpaque = 64;
const uint FlagImageSrgbPremultiplied = 128;

const uint NoBlock = 4294967295;
const uint BlockWords = 32;
const uint BlockCommands = 31;

/// Half a tile's diagonal.
const float TileRadius = 11.313708;

const uint GroupWords = 24;
const uint ClipWords = 20;
const uint GroupNonuniform = 1;
const uint GroupAxisAligned = 2;

float P(ReadOnlyBuffer<uint> p, uint at) => AsFloat(p[at]);

/// floor/ceil of a box, clamped to the surface: x0 y0 x1 y1.
int4 Pixels(float x0, float y0, float x1, float y1, in UiFrame f)
{
    float w = (float)f.Width;
    float h = (float)f.Height;
    return int4(
        (int)Clamp(Floor(x0), 0, w),
        (int)Clamp(Floor(y0), 0, h),
        (int)Clamp(Ceil(x1), 0, w),
        (int)Clamp(Ceil(y1), 0, h));
}

/// ceil/floor of a box, clamped: the whole pixels inside it.
int4 Inside(float x0, float y0, float x1, float y1, in UiFrame f)
{
    float w = (float)f.Width;
    float h = (float)f.Height;
    return int4(
        (int)Clamp(Ceil(x0), 0, w),
        (int)Clamp(Ceil(y0), 0, h),
        (int)Clamp(Floor(x1), 0, w),
        (int)Clamp(Floor(y1), 0, h));
}

int4 Intersect(int4 a, int4 b) => int4(Max(a.x, b.x), Max(a.y, b.y), Min(a.z, b.z), Min(a.w, b.w));

/// Group `g`'s transform (`at` 0: to the screen; 6: from it) applied to `q`.
float2 Apply(ReadOnlyBuffer<uint> groups, uint g, uint at, float2 q)
{
    uint b = g * GroupWords + at;
    return float2(
        P(groups, b) * q.x + P(groups, b + 2) * q.y + P(groups, b + 4),
        P(groups, b + 1) * q.x + P(groups, b + 3) * q.y + P(groups, b + 5));
}

/// The screen box of a local box in group `g`.
float4 ScreenBox(ReadOnlyBuffer<uint> groups, uint g, float4 l)
{
    float2 a = Apply(groups, g, 0, float2(l.x, l.y));
    float2 b = Apply(groups, g, 0, float2(l.z, l.y));
    float2 c = Apply(groups, g, 0, float2(l.x, l.w));
    float2 d = Apply(groups, g, 0, float2(l.z, l.w));
    return float4(
        Min(Min(a.x, b.x), Min(c.x, d.x)),
        Min(Min(a.y, b.y), Min(c.y, d.y)),
        Max(Max(a.x, b.x), Max(c.x, d.x)),
        Max(Max(a.y, b.y), Max(c.y, d.y)));
}

/// A rectangle payload's radii (at `r`), each at most half the shorter side of the box at `at`.
float4 Radii(ReadOnlyBuffer<uint> p, uint at, uint r)
{
    float limit = Max(Min(P(p, at + 2) - P(p, at), P(p, at + 3) - P(p, at + 1)) * 0.5, 0);
    return float4(
        Min(P(p, r), limit),
        Min(P(p, r + 1), limit),
        Min(P(p, r + 2), limit),
        Min(P(p, r + 3), limit));
}

/// How far a line's ink reaches from its center line.
float LineReach(ReadOnlyBuffer<uint> p, uint at)
{
    float hw = P(p, at + 4) * 0.5;
    return p[at + 5] == 2 ? hw * 1.41421356 : hw;
}

/// 16-bit two's complement in the low or high half.
int Low16(uint v) => ((int)(v << 16)) >> 16;
int High16(uint v) => ((int)v) >> 16;

/// x0 | y0 << 16, x1 | y1 << 16 of the bounding box; the same of the opaque interior.
uint4 CommandBounds(
    uint4 c,
    ReadOnlyBuffer<uint> p,
    ReadOnlyBuffer<uint4> glyphs,
    ReadOnlyBuffer<uint> groups,
    ReadOnlyBuffer<uint> clips,
    in UiFrame f)
{
    uint kind = c.x & 63;
    uint at = c.w;
    uint g = c.x >> 16;
    uint cb = (c.y & 65535) * ClipWords;
    int4 clipBox = Pixels(P(clips, cb + 10), P(clips, cb + 11), P(clips, cb + 12), P(clips, cb + 13), f);
    bool opaque = (c.x & FlagOpaque) != 0 && (groups[g * GroupWords + 14] & GroupAxisAligned) != 0;
    float aa = P(groups, g * GroupWords + 13);
    float4 local = float4(0, 0, 0, 0);
    float4 inner = float4(0, 0, 0, 0);
    bool hasInner = false;
    if (kind == KindRect)
    {
        float e = P(p, at + 8) * 0.5;
        local = float4(P(p, at) - e, P(p, at + 1) - e, P(p, at + 2) + e, P(p, at + 3) + e);
        if (opaque)
        {
            float4 r = Radii(p, at, at + 4);
            float m = Max(Max(r.x, r.y), Max(r.z, r.w)) + aa * 0.5;
            inner = float4(P(p, at) + m, P(p, at + 1) + m, P(p, at + 2) - m, P(p, at + 3) - m);
            hasInner = true;
        }
    }
    else if (kind == KindCircle)
    {
        float cx = P(p, at);
        float cy = P(p, at + 1);
        float r = P(p, at + 2);
        float e = r + P(p, at + 3) * 0.5;
        local = float4(cx - e, cy - e, cx + e, cy + e);
        if (opaque)
        {
            float h = (r - aa * 0.5) * 0.70710678;
            inner = float4(cx - h, cy - h, cx + h, cy + h);
            hasInner = true;
        }
    }
    else if (kind == KindLine)
    {
        float e = LineReach(p, at);
        float ax = P(p, at);
        float ay = P(p, at + 1);
        float bx = P(p, at + 2);
        float by = P(p, at + 3);
        local = float4(Min(ax, bx) - e, Min(ay, by) - e, Max(ax, bx) + e, Max(ay, by) + e);
    }
    else if (kind == KindTriangle)
    {
        float e = P(p, at + 6) * 0.5;
        float x0 = Min(Min(P(p, at), P(p, at + 2)), P(p, at + 4));
        float y0 = Min(Min(P(p, at + 1), P(p, at + 3)), P(p, at + 5));
        float x1 = Max(Max(P(p, at), P(p, at + 2)), P(p, at + 4));
        float y1 = Max(Max(P(p, at + 1), P(p, at + 3)), P(p, at + 5));
        local = float4(x0 - e, y0 - e, x1 + e, y1 + e);
    }
    else if (kind == KindImage || kind == KindBlur)
    {
        local = float4(P(p, at), P(p, at + 1), P(p, at + 2), P(p, at + 3));
    }
    int4 box = int4(0, 0, 0, 0);
    int4 interior = int4(0, 0, 0, 0);
    if (kind == KindPath)
    {
        // Flattened onto the screen when recorded.
        box = Intersect(Pixels(P(p, at + 5) - 0.5, P(p, at + 6) - 0.5, P(p, at + 7) + 0.5, P(p, at + 8) + 0.5, f), clipBox);
    }
    else if (kind == KindEffect)
    {
        // On the screen: the members' box, moved by the shadow's offset and grown by its blur
        // or the glow's radius.
        float x0 = P(p, at + 2);
        float y0 = P(p, at + 3);
        float x1 = P(p, at + 4);
        float y1 = P(p, at + 5);
        if (x0 < x1)
        {
            uint gb = g * GroupWords;
            float dx = p[at] == 0 ? P(groups, gb + 17) : 0.0;
            float dy = p[at] == 0 ? P(groups, gb + 18) : 0.0;
            float e = p[at] == 0 ? P(groups, gb + 19) * 1.5 : P(groups, gb + 21);
            box = Intersect(Pixels(x0 + dx - e - 0.5, y0 + dy - e - 0.5, x1 + dx + e + 0.5, y1 + dy + e + 0.5, f), clipBox);
        }
    }
    else if (kind == KindGlyph)
    {
        // Glyphs are placed on the screen.
        uint4 gr = glyphs[p[at + 2]];
        int x0 = (int)p[at] + Low16(gr.z);
        int y0 = (int)p[at + 1] + High16(gr.z);
        int w = (int)f.Width;
        int h = (int)f.Height;
        box = Intersect(
            int4(
                Clamp(x0, 0, w),
                Clamp(y0, 0, h),
                Clamp(x0 + (int)(gr.y & 65535), 0, w),
                Clamp(y0 + (int)(gr.y >> 16), 0, h)),
            clipBox);
    }
    else if ((kind >= KindRect && kind <= KindImage) || kind == KindBlur)
    {
        float4 sb = ScreenBox(groups, g, local);
        box = Intersect(Pixels(sb.x - 0.5, sb.y - 0.5, sb.z + 0.5, sb.w + 0.5, f), clipBox);
        if (hasInner)
        {
            float4 si = ScreenBox(groups, g, inner);
            interior = Intersect(
                Inside(si.x - 0.5, si.y - 0.5, si.z + 0.5, si.w + 0.5, f),
                Inside(P(clips, cb + 14), P(clips, cb + 15), P(clips, cb + 16), P(clips, cb + 17), f));
        }
    }
    uint4 u = (uint4)box;
    uint4 v = (uint4)interior;
    return uint4(u.x | (u.y << 16), u.z | (u.w << 16), v.x | (v.y << 16), v.z | (v.w << 16));
}

public struct BoundsArgs
{
    public Uniform<UiFrame> Frame;
    public ReadOnlyBuffer<uint4> Commands;
    public ReadOnlyBuffer<uint> Payload;
    public ReadOnlyBuffer<uint4> Glyphs;
    public ReadOnlyBuffer<uint> Groups;
    public ReadOnlyBuffer<uint> Clips;
    public Buffer<uint4> Bounds;
}

[Compute(256, 1, 1)]
public void Bounds([DispatchThreadId] uint3 id, [Push] in BoundsArgs a)
{
    UiFrame f = a.Frame.Value;
    if (id.x >= f.Commands)
        return;
    a.Bounds[id.x] = CommandBounds(a.Commands[id.x], a.Payload, a.Glyphs, a.Groups, a.Clips, f);
}

public struct BinArgs
{
    public Uniform<UiFrame> Frame;
    public ReadOnlyBuffer<uint4> Bounds;
    /// Per chunk, per bin: 8 words, a bit per command of the chunk. Cleared before.
    public Buffer<uint> Masks;
}

[Compute(256, 1, 1)]
public void Bin([DispatchThreadId] uint3 id, [Push] in BinArgs a)
{
    UiFrame f = a.Frame.Value;
    if (id.x >= f.Commands)
        return;
    uint4 b = a.Bounds[id.x];
    uint x0 = b.x & 65535;
    uint y0 = b.x >> 16;
    uint x1 = b.y & 65535;
    uint y1 = b.y >> 16;
    if (x0 >= x1 || y0 >= y1)
        return;
    uint chunk = id.x >> 8;
    uint word = (id.x & 255) >> 5;
    uint bit = 1u << (id.x & 31);
    uint bins = f.BinsX * f.BinsY;
    for (uint by = y0 >> 8; by <= (y1 - 1) >> 8; by++)
    {
        for (uint bx = x0 >> 8; bx <= (x1 - 1) >> 8; bx++)
        {
            a.Masks.AtomicOr(((chunk * bins) + by * f.BinsX + bx) * 8 + word, bit);
        }
    }
}

/// Distance from `p` to the segment `a`–`b`.
float SegmentDistance(float2 p, float2 a, float2 b)
{
    float2 pa = p - a;
    float2 ba = b - a;
    float len2 = Max(ba.x * ba.x + ba.y * ba.y, 0.000000000001);
    float h = Clamp((pa.x * ba.x + pa.y * ba.y) / len2, 0, 1);
    float2 q = pa - ba * h;
    return Sqrt(q.x * q.x + q.y * q.y);
}

/// Negative or zero: the line's reach includes the tile centered at `t`, measured in its group.
float LineTouchesTile(ReadOnlyBuffer<uint> p, uint at, ReadOnlyBuffer<uint> groups, uint g, float2 t)
{
    float2 q = Apply(groups, g, 6, t);
    float d = SegmentDistance(q, float2(P(p, at), P(p, at + 1)), float2(P(p, at + 2), P(p, at + 3)));
    return d - (LineReach(p, at) + (TileRadius + 0.5) * P(groups, g * GroupWords + 23));
}

public struct CoarseArgs
{
    public Uniform<UiFrame> Frame;
    public ReadOnlyBuffer<uint4> Commands;
    public ReadOnlyBuffer<uint> Payload;
    public ReadOnlyBuffer<uint> Groups;
    /// Every command's content hash (`marlin_ui_render::damage`).
    public ReadOnlyBuffer<uint> Hashes;
    public ReadOnlyBuffer<uint4> Bounds;
    public ReadOnlyBuffer<uint> Masks;
    /// Per tile: first block, command count, 1 if it is shaded this frame.
    public Buffer<uint4> Heads;
    public Buffer<uint> Pool;
    /// 0: blocks taken; 1: nonzero if the pool ran out. Cleared before.
    public Buffer<uint> Counters;
    /// Per tile: the hash of its list last frame, this frame's after (§5.5).
    public Buffer<uint> TileHashes;
    /// Every layer's first command (`Frame.Layers` of them, the first 0): an opaque command
    /// empties a tile's list only of its own layer's commands, since a blur in a later layer
    /// may read the tile (§5.6).
    public ReadOnlyBuffer<uint> LayerStarts;
}

[Compute(16, 16, 1)]
public void Coarse([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in CoarseArgs a)
{
    UiFrame f = a.Frame.Value;
    uint tx = group.x * 16 + thread.x;
    uint ty = group.y * 16 + thread.y;
    bool live = tx < f.TilesX && ty < f.TilesY;
    uint bin = group.y * f.BinsX + group.x;
    uint bins = f.BinsX * f.BinsY;
    int x0 = (int)(tx * 16);
    int y0 = (int)(ty * 16);
    float2 center = float2((float)x0 + 8, (float)y0 + 8);
    uint head = NoBlock;
    uint current = NoBlock;
    uint count = 0;
    bool full = false;
    uint hash = f.Salt;
    // The layers seen, and the list as it stood when the current one began: an opaque command
    // hides only its own layer's commands (§5.6).
    uint layer = 0;
    uint layerCount = 0;
    uint layerCurrent = NoBlock;
    uint layerHash = f.Salt;
    for (uint c = 0; c < f.Chunks; c++)
    {
        for (uint w = 0; w < 8; w++)
        {
            uint m = a.Masks[(c * bins + bin) * 8 + w];
            while (m != 0)
            {
                uint i = c * 256 + w * 32 + FirstBitLow(m);
                m = m & (m - 1);
                if (!live || full)
                    continue;
                uint4 b = a.Bounds[i];
                int bx0 = (int)(b.x & 65535);
                int by0 = (int)(b.x >> 16);
                int bx1 = (int)(b.y & 65535);
                int by1 = (int)(b.y >> 16);
                if (x0 + 16 <= bx0 || x0 >= bx1 || y0 + 16 <= by0 || y0 >= by1)
                    continue;
                uint4 cmd = a.Commands[i];
                if ((cmd.x & 63) == KindLine && LineTouchesTile(a.Payload, cmd.w, a.Groups, cmd.x >> 16, center) > 0)
                    continue;
                int ix0 = (int)(b.z & 65535);
                int iy0 = (int)(b.z >> 16);
                int ix1 = (int)(b.w & 65535);
                int iy1 = (int)(b.w >> 16);
                if (layer < f.Layers && a.LayerStarts[layer] <= i)
                {
                    while (layer < f.Layers && a.LayerStarts[layer] <= i)
                        layer++;
                    layerCount = count;
                    layerCurrent = current;
                    layerHash = hash;
                }
                if (x0 >= ix0 && y0 >= iy0 && x0 + 16 <= ix1 && y0 + 16 <= iy1)
                {
                    // Hidden: back to where the layer began, reusing the blocks.
                    count = layerCount;
                    current = layerCount == 0 ? head : layerCurrent;
                    hash = layerHash;
                }
                uint slot = count % BlockCommands;
                if (slot == 0)
                {
                    uint block = count == 0 ? head : a.Pool[current * BlockWords + BlockCommands];
                    if (block == NoBlock)
                    {
                        block = a.Counters.AtomicAdd(0, 1);
                        if (block >= f.PoolBlocks)
                        {
                            a.Counters.AtomicOr(1, 1);
                            full = true;
                            continue;
                        }
                        a.Pool[block * BlockWords + BlockCommands] = NoBlock;
                        if (count == 0)
                            head = block;
                        else
                            a.Pool[current * BlockWords + BlockCommands] = block;
                    }
                    current = block;
                }
                a.Pool[current * BlockWords + slot] = i;
                count++;
                hash = (hash ^ a.Hashes[i]) * 16777619;
            }
        }
    }
    if (live)
    {
        // Dirty when its list changed: content, order, or a command dropped for want of blocks.
        uint tile = ty * f.TilesX + tx;
        bool dirty = f.Force != 0 || full || a.TileHashes[tile] != hash;
        a.TileHashes[tile] = full ? 0 : hash;
        a.Heads[tile] = uint4(head, count, dirty ? 1u : 0u, 0);
    }
}

public struct PathTilesArgs
{
    public ReadOnlyBuffer<uint> Payload;
    /// Per path: `PathRecordWords` words.
    public ReadOnlyBuffer<uint> Paths;
    /// Per segment (modes 0 and 2) or tile row (mode 1) of every path with tiles: its path.
    public ReadOnlyBuffer<uint> Items;
    /// `PathTileWords` words per tile of every path's grid. Cleared before.
    public Buffer<uint> Tiles;
    /// 0: entries taken. Cleared before.
    public Buffer<uint> Counter;
    /// Per tile, the segments it shades (`PathEntries`), as `float` bits.
    public Buffer<int4> Entries;
    public uint EntryCapacity;
    /// 0: count each tile's segments and backdrop deltas; 1: sum the backdrops along each tile
    /// row and give each tile its entries; 2: write the entries.
    public uint Mode;
    /// The segments (modes 0 and 2) or tile rows (mode 1) of every path with tiles.
    public uint Count;
}

/// The tile column (or row) holding coordinate `v`: everything before tile `lo` in `lo - 1`,
/// everything from `hi` on in `hi`.
int PathCell(float v, int lo, int hi) => (int)Clamp(Floor(v * 0.0625), (float)(lo - 1), (float)hi);

/// Writes what tile `(x, y)` (its words at `t`) shades for segment `s`: `s`, or when it crosses
/// the tile's left side, its part right of the side and a vertical segment on the side from the
/// crossing to the tile's bottom (`marlin_ui_render::path::entries`).
void PathEntries(in PathTilesArgs a, uint t, float4 s, bool crosses, int x, int y)
{
    uint n = crosses ? 2u : 1u;
    uint at = a.Tiles[t + 2] + a.Tiles.AtomicAdd(t + 3, n);
    if (at + n > a.EntryCapacity)
        return;
    if (!crosses)
    {
        a.Entries[at] = AsInt(s);
        return;
    }
    float x0 = (float)(x * 16);
    float bottom = (float)((y + 1) * 16);
    float ye = s.y + (s.w - s.y) * ((x0 - s.x) / (s.z - s.x));
    if (s.x < x0)
    {
        a.Entries[at] = AsInt(float4(x0, ye, s.z, s.w));
        a.Entries[at + 1] = AsInt(float4(x0, bottom, x0, ye));
    }
    else
    {
        a.Entries[at] = AsInt(float4(s.x, s.y, x0, ye));
        a.Entries[at + 1] = AsInt(float4(x0, ye, x0, bottom));
    }
}

/// Walks segment `index` of the path whose record is at `rec` through the tiles of its grid
/// (`marlin_ui_render::path::walk`), counting (mode 0) or listing (mode 2) it in each.
void PathWalk(in PathTilesArgs a, uint rec, uint index)
{
    uint s = a.Paths[rec] + PathSegments + 4 * index;
    float x0 = P(a.Payload, s);
    float y0 = P(a.Payload, s + 1);
    float x1 = P(a.Payload, s + 2);
    float y1 = P(a.Payload, s + 3);
    int gx0 = (int)a.Paths[rec + 1];
    int gy0 = (int)a.Paths[rec + 2];
    int gx1 = (int)a.Paths[rec + 3];
    int gy1 = (int)a.Paths[rec + 4];
    uint firstTile = a.Paths[rec + 5];
    int c = PathCell(x0, gx0, gx1);
    int r = PathCell(y0, gy0, gy1);
    int c1 = PathCell(x1, gx0, gx1);
    int r1 = PathCell(y1, gy0, gy1);
    int sx = c1 > c ? 1 : (c1 < c ? -1 : 0);
    int sy = r1 > r ? 1 : (r1 < r ? -1 : 0);
    int nx = (c1 - c) * sx;
    int ny = (r1 - r) * sy;
    float adx = Abs(x1 - x0);
    float ady = Abs(y1 - y0);
    bool edge = false;
    int steps = nx + ny;
    for (int k = 0; k <= steps; k++)
    {
        // The next grid line is a column's when the segment meets it first.
        bool xStep = false;
        if (nx > 0)
        {
            if (ny == 0)
                xStep = true;
            else
            {
                float bx = (float)(16 * (sx > 0 ? c + 1 : c));
                float by = (float)(16 * (sy > 0 ? r + 1 : r));
                xStep = (bx - x0) * (float)sx * ady < (by - y0) * (float)sy * adx;
            }
        }
        if (c >= gx0 && c < gx1 && r >= gy0 && r < gy1)
        {
            uint t = (firstTile + (uint)((r - gy0) * (gx1 - gx0) + (c - gx0))) * PathTileWords;
            bool crosses = edge || (xStep && sx < 0);
            if (a.Mode == 0)
                a.Tiles.AtomicAdd(t + 1, crosses ? 2u : 1u);
            else
                PathEntries(a, t, float4(x0, y0, x1, y1), crosses, c, r);
        }
        if (k == steps)
            break;
        if (xStep)
        {
            c = c + sx;
            nx = nx - 1;
            edge = sx > 0;
        }
        else
        {
            int row = sy > 0 ? r + 1 : r;
            if (a.Mode == 0 && row >= gy0 && row < gy1 && c + 1 < gx1)
            {
                uint t = (firstTile + (uint)((row - gy0) * (gx1 - gx0) + (c + 1 - gx0))) * PathTileWords;
                a.Tiles.AtomicAdd(t, (uint)sy);
            }
            r = r + sy;
            ny = ny - 1;
            edge = false;
        }
    }
}

/// Paths' tiles (§4.2), in three dispatches over the segments (or tile rows) of every path with
/// tiles, one a thread: each segment counted in the tiles it crosses, with where it crosses tile
/// rows' tops; each tile row's backdrops summed along it and its tiles' entries taken from the
/// pool; each segment written into its tiles' entries. The group index is split over x and y
/// past 65535.
[Compute(256, 1, 1)]
public void PathTiles([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in PathTilesArgs a)
{
    uint item = (group.y * 65535 + group.x) * 256 + thread.x;
    if (item >= a.Count)
        return;
    if (a.Mode == 1)
    {
        uint record = a.Items[item] * PathRecordWords;
        uint w = a.Paths[record + 3] - a.Paths[record + 1];
        uint t0 = (a.Paths[record + 5] + (item - a.Paths[record + 7]) * w) * PathTileWords;
        int run = 0;
        uint total = 0;
        for (uint x = 0; x < w; x++)
        {
            uint t = t0 + x * PathTileWords;
            run = run + (int)a.Tiles[t];
            a.Tiles[t] = (uint)run;
            total = total + a.Tiles[t + 1];
        }
        uint at = a.Counter.AtomicAdd(0, total);
        for (uint x = 0; x < w; x++)
        {
            uint t = t0 + x * PathTileWords;
            a.Tiles[t + 2] = at;
            at = at + a.Tiles[t + 1];
        }
        return;
    }
    uint rec = a.Items[item] * PathRecordWords;
    PathWalk(a, rec, item - a.Paths[rec + 6]);
}

/// Signed distance to a box of half size `b` around the origin, rounded by `r`.
float RoundBox(float2 p, float2 b, float r)
{
    float qx = Abs(p.x) - b.x + r;
    float qy = Abs(p.y) - b.y + r;
    float ox = Max(qx, 0);
    float oy = Max(qy, 0);
    return Min(Max(qx, qy), 0) + Sqrt(ox * ox + oy * oy) - r;
}

/// Distance to the rounded rectangle of the box at `at` and the radii at `r`.
float RectDistance(ReadOnlyBuffer<uint> p, uint at, uint r, float2 px)
{
    float cx = (P(p, at) + P(p, at + 2)) * 0.5;
    float cy = (P(p, at + 1) + P(p, at + 3)) * 0.5;
    float bx = (P(p, at + 2) - P(p, at)) * 0.5;
    float by = (P(p, at + 3) - P(p, at + 1)) * 0.5;
    float2 q = float2(px.x - cx, px.y - cy);
    float4 radii = Radii(p, at, r);
    // top-left, top-right, bottom-right, bottom-left; y down.
    float radius = q.x > 0 ? (q.y > 0 ? radii.z : radii.y) : (q.y > 0 ? radii.w : radii.x);
    return RoundBox(q, float2(bx, by), radius);
}

float Dot2(float2 u, float2 v) => u.x * v.x + u.y * v.y;

/// Signed distance to a triangle (either winding), negative inside.
float TriangleDistance(float2 p, float2 a, float2 b, float2 c)
{
    float2 e0 = b - a;
    float2 e1 = c - b;
    float2 e2 = a - c;
    float2 v0 = p - a;
    float2 v1 = p - b;
    float2 v2 = p - c;
    float2 q0 = v0 - e0 * Clamp(Dot2(v0, e0) / Max(Dot2(e0, e0), 0.000000000001), 0, 1);
    float2 q1 = v1 - e1 * Clamp(Dot2(v1, e1) / Max(Dot2(e1, e1), 0.000000000001), 0, 1);
    float2 q2 = v2 - e2 * Clamp(Dot2(v2, e2) / Max(Dot2(e2, e2), 0.000000000001), 0, 1);
    float s = e0.x * e2.y - e0.y * e2.x < 0 ? -1.0 : 1.0;
    float dx = Min(Min(Dot2(q0, q0), Dot2(q1, q1)), Dot2(q2, q2));
    float dy = Min(Min(s * (v0.x * e0.y - v0.y * e0.x), s * (v1.x * e1.y - v1.y * e1.x)), s * (v2.x * e2.y - v2.y * e2.x));
    float mag = Sqrt(dx);
    return dy > 0 ? -mag : mag;
}

/// Signed distance to a line command's ink: caps and dashes.
float LineDistance(ReadOnlyBuffer<uint> p, uint at, float2 px)
{
    float ax = P(p, at);
    float ay = P(p, at + 1);
    float hw = P(p, at + 4) * 0.5;
    float dx = P(p, at + 2) - ax;
    float dy = P(p, at + 3) - ay;
    float len = Sqrt(dx * dx + dy * dy);
    float ux = len > 0.000001 ? dx / len : 1.0;
    float uy = len > 0.000001 ? dy / len : 0.0;
    float rx = px.x - ax;
    float ry = px.y - ay;
    float u = rx * ux + ry * uy;
    float v = rx * uy - ry * ux;
    uint cap = p[at + 5];
    float d = 0;
    if (cap == 1)
    {
        float t = u - Clamp(u, 0, len);
        d = Sqrt(t * t + v * v) - hw;
    }
    else
    {
        float ext = cap == 2 ? hw : 0.0;
        float qx = Abs(u - len * 0.5) - (len * 0.5 + ext);
        float qy = Abs(v) - hw;
        float ox = Max(qx, 0);
        float oy = Max(qy, 0);
        d = Sqrt(ox * ox + oy * oy) + Min(Max(qx, qy), 0);
    }
    float dash = P(p, at + 6);
    if (dash > 0)
    {
        float period = dash + P(p, at + 7);
        float s = u + P(p, at + 8) - dash * 0.5 + period * 0.5;
        float t = s - period * Floor(s / period) - period * 0.5;
        d = Max(d, Abs(t) - dash * 0.5);
    }
    return d;
}

float Coverage(float d) => Clamp(0.5 - d, 0, 1);

/// A packed RGBA8 sRGB color with straight alpha, premultiplied.
float4 Premultiplied(uint c)
{
    float a = (float)(c >> 24) / 255;
    return float4(
        (float)(c & 255) / 255 * a,
        (float)((c >> 8) & 255) / 255 * a,
        (float)((c >> 16) & 255) / 255 * a,
        a);
}

/// `src` over `dst`, premultiplied.
float4 Over(float4 src, float4 dst) => src + dst * (1 - src.w);

float LinearToSrgb(float x) => x <= 0.0031308 ? x * 12.92 : 1.055 * Pow(x, 1.0 / 2.4) - 0.055;

float SrgbToLinear(float x) => x <= 0.04045 ? x / 12.92 : Pow((x + 0.055) / 1.055, 2.4);

/// The fill under the stroke, both straddling the edge at distance `d` (group units; `k` screen
/// pixels per unit).
float4 FillAndStroke(float4 fill, float d, float k, float strokeWidth, uint stroke)
{
    float4 f = fill * Coverage(d * k);
    if (strokeWidth <= 0)
        return f;
    return Over(Premultiplied(stroke) * Coverage((Abs(d) - strokeWidth * 0.5) * k), f);
}

/// The signed distance of a command's shape at `q` (group units): rectangles, circles, lines,
/// triangles and images; `p` holds its payload at `at`.
float Distance(uint kind, ReadOnlyBuffer<uint> p, uint at, float2 q)
{
    if (kind == KindRect)
        return RectDistance(p, at, at + 4, q);
    if (kind == KindCircle)
    {
        float2 d = q - float2(P(p, at), P(p, at + 1));
        return Sqrt(d.x * d.x + d.y * d.y) - P(p, at + 2);
    }
    if (kind == KindLine)
        return LineDistance(p, at, q);
    if (kind == KindTriangle)
        return TriangleDistance(
            q,
            float2(P(p, at), P(p, at + 1)),
            float2(P(p, at + 2), P(p, at + 3)),
            float2(P(p, at + 4), P(p, at + 5)));
    if (kind == KindBlur)
        return RectDistance(p, at, at + 4, q);
    // An image's rounded rectangle: radii after the UV rectangle and the size.
    return RectDistance(p, at, at + 9, q);
}

/// Screen pixels per unit of group `g` for the shape at `px` whose distance there is `d`: the
/// transform's scale, or for a non-uniform transform the distance's gradient.
float PixelsPerUnit(ReadOnlyBuffer<uint> groups, uint g, uint kind, ReadOnlyBuffer<uint> p, uint at, float2 px, float d)
{
    uint b = g * GroupWords;
    if ((groups[b + 14] & GroupNonuniform) == 0)
        return 1 / P(groups, b + 13);
    float dx = Distance(kind, p, at, Apply(groups, g, 6, px + float2(1, 0))) - d;
    float dy = Distance(kind, p, at, Apply(groups, g, 6, px + float2(0, 1))) - d;
    float grad = Sqrt(dx * dx + dy * dy);
    return grad > 0.000001 ? 1 / grad : 1 / P(groups, b + 13);
}

/// The coverage of clip `clip`'s chain at screen pixel `px`.
float ClipCoverage(ReadOnlyBuffer<uint> clips, ReadOnlyBuffer<uint> groups, uint clip, float2 px)
{
    float cov = 1;
    uint c = clip;
    while (c != 0)
    {
        uint b = c * ClipWords;
        uint g = clips[b + 8];
        float d = RectDistance(clips, b, b + 4, Apply(groups, g, 6, px));
        float k = 1 / P(groups, g * GroupWords + 13);
        if ((groups[g * GroupWords + 14] & GroupNonuniform) != 0)
        {
            float dx = RectDistance(clips, b, b + 4, Apply(groups, g, 6, px + float2(1, 0))) - d;
            float dy = RectDistance(clips, b, b + 4, Apply(groups, g, 6, px + float2(0, 1))) - d;
            float grad = Sqrt(dx * dx + dy * dy);
            k = grad > 0.000001 ? 1 / grad : k;
        }
        cov = cov * Coverage(d * k);
        c = clips[b + 9];
    }
    return cov;
}

public struct FineArgs
{
    public Uniform<UiFrame> Frame;
    public ReadOnlyBuffer<uint4> Commands;
    public ReadOnlyBuffer<uint> Payload;
    public ReadOnlyBuffer<UiPaint> Paints;
    /// Gradient records (`marlin_ui_render::command::GRADIENT_WORDS` words each).
    public ReadOnlyBuffer<uint> Gradients;
    public ReadOnlyBuffer<uint4> Glyphs;
    public ReadOnlyBuffer<uint> Groups;
    public ReadOnlyBuffer<uint> Clips;
    public ReadOnlyBuffer<uint4> Heads;
    public ReadOnlyBuffer<uint> Pool;
    /// The glyph cache's pages: R8 coverage.
    public Texture2DArray<float> GlyphPages;
    public StorageTexture2D<float4> Output;
    /// The layer drawn (§5.6): its commands are `First` to `End`; past the first layer it starts
    /// from `Previous`, the pixels the layers below drew.
    public uint First;
    public uint End;
    public Texture2D<float4> Previous;
    /// Per backdrop blur: its image's texel 0 on the screen (x | y << 16), its size (width |
    /// height << 16), and screen pixels per texel.
    public ReadOnlyBuffer<uint4> Backdrops;
    /// Per path: its record; its tiles; their segments (`PathTiles`).
    public ReadOnlyBuffer<uint> Paths;
    public ReadOnlyBuffer<uint> PathTiles;
    public ReadOnlyBuffer<int4> PathEntries;
}

/// The signed area segment `s` sweeps to the right inside the pixel cell at `cell` (its top-left
/// corner).
float CellArea(float4 s, float2 cell)
{
    if (s.y == s.w)
        return 0;
    float dir = s.w > s.y ? 1.0 : -1.0;
    float ya = Max(Min(s.y, s.w), cell.y);
    float yb = Min(Max(s.y, s.w), cell.y + 1);
    if (yb <= ya)
        return 0;
    float dxdy = (s.z - s.x) / (s.w - s.y);
    float ta = s.x + (ya - s.y) * dxdy - cell.x;
    float tb = s.x + (yb - s.y) * dxdy - cell.x;
    float ga = ta <= 0 ? ta : (ta >= 1 ? 0.5 : ta - ta * ta * 0.5);
    float gb = tb <= 0 ? tb : (tb >= 1 ? 0.5 : tb - tb * tb * 0.5);
    float avg = Abs(tb - ta) < 0.000001 ? Clamp(1 - ta, 0, 1) : (gb - ga) / (tb - ta);
    return dir * avg * (yb - ya);
}

/// A path's coverage of the pixel centered at `px`: its tile's backdrop and the signed areas its
/// tile's entries sweep to the pixel's right (§4.2), summed in coverage units, by its fill rule.
float PathCoverage(in FineArgs a, uint at, float2 px)
{
    ReadOnlyBuffer<uint> p = a.Payload;
    uint rec = p[at + 4] * PathRecordWords;
    int tx = (int)Floor(px.x * 0.0625);
    int ty = (int)Floor(px.y * 0.0625);
    int gx0 = (int)a.Paths[rec + 1];
    int gy0 = (int)a.Paths[rec + 2];
    int gx1 = (int)a.Paths[rec + 3];
    int gy1 = (int)a.Paths[rec + 4];
    if (tx < gx0 || tx >= gx1 || ty < gy0 || ty >= gy1)
        return 0;
    uint t = (a.Paths[rec + 5] + (uint)((ty - gy0) * (gx1 - gx0) + (tx - gx0))) * PathTileWords;
    int acc = (int)a.PathTiles[t] * 1048576;
    uint count = a.PathTiles[t + 1];
    uint first = a.PathTiles[t + 2];
    float2 cell = float2(Floor(px.x), Floor(px.y));
    for (uint k = 0; k < count; k++)
        acc = acc + (int)Floor(CellArea(AsFloat(a.PathEntries[first + k]), cell) * CoverageUnit + 0.5);
    float c = Abs((float)acc * (1 / CoverageUnit));
    if (p[at] == 0)
        return Min(c, 1);
    float m = c - 2 * Floor(c * 0.5);
    return Min(m, 2 - m);
}

const uint PaintGradient = 2;
const uint GradientWords = 264;
const uint GradientTexels = 256;

/// A premultiplied RGBA8 word as floats.
float4 Unpack(uint v) => float4((float)(v & 255), (float)((v >> 8) & 255), (float)((v >> 16) & 255), (float)(v >> 24)) / 255;

/// A paint's premultiplied color at screen pixel `px`: its solid color (an image's tint), or its
/// gradient there.
float4 PaintColor(in UiPaint paint, ReadOnlyBuffer<uint> gradients, float2 px)
{
    if (paint.Kind != PaintGradient)
        return Premultiplied(paint.Color);
    uint g = paint.Color * GradientWords;
    uint shape = gradients[g];
    float t = 0;
    if (shape == 0)
    {
        float dx = P(gradients, g + 3) - P(gradients, g + 1);
        float dy = P(gradients, g + 4) - P(gradients, g + 2);
        t = ((px.x - P(gradients, g + 1)) * dx + (px.y - P(gradients, g + 2)) * dy) / Max(dx * dx + dy * dy, 0.000000000001);
    }
    else if (shape == 1)
    {
        float2 d = px - float2(P(gradients, g + 1), P(gradients, g + 2));
        t = Sqrt(d.x * d.x + d.y * d.y) / Max(P(gradients, g + 3), 0.000001);
    }
    else
    {
        float angle = Atan2(px.y - P(gradients, g + 2), px.x - P(gradients, g + 1)) - P(gradients, g + 3);
        t = angle / 6.28318531;
        t = t - Floor(t);
    }
    float f = Clamp(t, 0, 1) * (float)(GradientTexels - 1);
    uint i = Min((uint)Floor(f), GradientTexels - 2);
    float k = f - (float)i;
    float4 c0 = Unpack(gradients[g + 8 + i]);
    float4 c1 = Unpack(gradients[g + 9 + i]);
    return (c0 + (c1 - c0) * k) * P(gradients, g + 5);
}

/// `erf(x)`, Abramowitz and Stegun 7.1.26.
float Erf(float x)
{
    float t = 1 / (1 + 0.3275911 * Abs(x));
    float y = 1 - (((((1.0614054 * t - 1.453152) * t) + 1.4214138) * t - 0.28449674) * t + 0.2548296) * t * Exp(-x * x);
    return x < 0 ? -y : y;
}

/// A member's distance at screen pixel `px`, in screen pixels: its shape's outer edge (strokes
/// included), a glyph's bitmap box; nothing for effects.
float MemberDistance(uint4 c, in FineArgs a, float2 px)
{
    uint kind = c.x & 63;
    uint at = c.w;
    ReadOnlyBuffer<uint> p = a.Payload;
    if (kind == KindEffect || kind < KindRect || kind > KindBlur)
        return 3.4e38;
    if (kind == KindPath)
    {
        float x0 = P(p, at + 5);
        float y0 = P(p, at + 6);
        float x1 = P(p, at + 7);
        float y1 = P(p, at + 8);
        return RoundBox(float2(px.x - (x0 + x1) * 0.5, px.y - (y0 + y1) * 0.5), float2((x1 - x0) * 0.5, (y1 - y0) * 0.5), 0);
    }
    if (kind == KindGlyph)
    {
        uint4 gr = a.Glyphs[p[at + 2]];
        float gw = (float)(gr.y & 65535);
        float gh = (float)(gr.y >> 16);
        if (gw == 0)
            return 3.4e38;
        float x0 = (float)((int)p[at] + Low16(gr.z));
        float y0 = (float)((int)p[at + 1] + High16(gr.z));
        return RoundBox(float2(px.x - (x0 + gw * 0.5), px.y - (y0 + gh * 0.5)), float2(gw * 0.5, gh * 0.5), 0);
    }
    uint g = c.x >> 16;
    float d = Distance(kind, p, at, Apply(a.Groups, g, 6, px));
    if (kind == KindRect)
        d = d - P(p, at + 8) * 0.5;
    else if (kind == KindCircle)
        d = d - P(p, at + 3) * 0.5;
    else if (kind == KindTriangle)
        d = d - P(p, at + 6) * 0.5;
    return d * (1 / P(a.Groups, g * GroupWords + 13));
}

/// The distance to a group effect's members at screen pixel `px`: the nearest member, or their
/// box as a rounded rectangle.
float EffectDistance(uint4 c, in FineArgs a, float2 px)
{
    ReadOnlyBuffer<uint> p = a.Payload;
    uint at = c.w;
    uint gb = (c.x >> 16) * GroupWords;
    uint first = a.Groups[gb + 15];
    uint count = a.Groups[gb + 16];
    float radius = P(p, at + 6);
    if (radius >= 0 || count > MaxEffectMembers)
    {
        float x0 = P(p, at + 2);
        float y0 = P(p, at + 3);
        float x1 = P(p, at + 4);
        float y1 = P(p, at + 5);
        float r = Min(Max(radius, 0), Min(x1 - x0, y1 - y0) * 0.5);
        return RoundBox(float2(px.x - (x0 + x1) * 0.5, px.y - (y0 + y1) * 0.5), float2((x1 - x0) * 0.5, (y1 - y0) * 0.5), r);
    }
    float d = 3.4e38;
    for (uint i = first; i < first + count; i++)
        d = Min(d, MemberDistance(a.Commands[i], a, px));
    return d;
}

/// A group's shadow (a Gaussian blur of the members' shape, sigma half the blur radius) or glow
/// (fading quadratically over its radius), §4.3.
float4 Effect(uint4 c, in FineArgs a, float4 color, float2 px)
{
    uint gb = (c.x >> 16) * GroupWords;
    float alpha = 0;
    if (a.Payload[c.w] == 0)
    {
        float d = EffectDistance(c, a, float2(px.x - P(a.Groups, gb + 17), px.y - P(a.Groups, gb + 18)));
        float sigma = P(a.Groups, gb + 19) * 0.5;
        alpha = sigma > 0 ? 0.5 - 0.5 * Erf(d / (sigma * 1.41421356)) : Coverage(d);
    }
    else
    {
        float d = EffectDistance(c, a, px);
        float r = P(a.Groups, gb + 21);
        float t = 1 - Clamp(d / Max(r, 0.000001), 0, 1);
        alpha = r > 0 ? t * t : Coverage(d);
    }
    return color * alpha;
}

/// Backdrop blur `c`'s blurred image at screen pixel `px` (`marlin_ui_render::blur`).
float4 Backdrop(uint4 c, in FineArgs a, float2 px)
{
    uint4 b = a.Backdrops[a.Payload[c.w + 9]];
    float s = (float)b.z;
    float2 t = float2((px.x - (float)(b.x & 65535)) / s, (px.y - (float)(b.x >> 16)) / s);
    float2 uv = float2(t.x / (float)(b.y & 65535), t.y / (float)(b.y >> 16));
    UiPaint paint = a.Paints[c.z];
    return paint.Texture.Sample(paint.Sampler, uv, lod: 0);
}

/// Command `c`'s premultiplied color at the pixel centered at `px`, before its group's opacity
/// and its clip.
float4 ShadeUnclipped(uint4 c, in FineArgs a, float2 px)
{
    uint kind = c.x & 63;
    uint at = c.w;
    uint g = c.x >> 16;
    ReadOnlyBuffer<uint> p = a.Payload;
    UiPaint paint = a.Paints[c.z];
    float4 color = PaintColor(paint, a.Gradients, px);
    if (kind == KindPath)
        return color * PathCoverage(a, at, px);
    if (kind == KindBlur)
    {
        float e = RectDistance(p, at, at + 4, Apply(a.Groups, g, 6, px));
        return Backdrop(c, a, px) * Coverage(e * PixelsPerUnit(a.Groups, g, kind, p, at, px, e));
    }
    if (kind == KindEffect)
        return Effect(c, a, color, px);
    if (kind == KindGlyph)
    {
        uint4 gr = a.Glyphs[p[at + 2]];
        int gw = (int)(gr.y & 65535);
        int gh = (int)(gr.y >> 16);
        int gx = (int)Floor(px.x) - ((int)p[at] + Low16(gr.z));
        int gy = (int)Floor(px.y) - ((int)p[at + 1] + High16(gr.z));
        if (gx < 0 || gy < 0 || gx >= gw || gy >= gh)
            return float4(0, 0, 0, 0);
        int2 texel = int2((int)(gr.x & 65535) + gx, (int)(gr.x >> 16) + gy);
        return color * a.GlyphPages.Load(texel, layer: (int)gr.w);
    }
    float2 q = Apply(a.Groups, g, 6, px);
    float d = Distance(kind, p, at, q);
    float k = PixelsPerUnit(a.Groups, g, kind, p, at, px, d);
    if (kind == KindRect)
        return FillAndStroke(color, d, k, P(p, at + 8), p[at + 9]);
    if (kind == KindCircle)
        return FillAndStroke(color, d, k, P(p, at + 3), p[at + 4]);
    if (kind == KindLine)
        return color * Coverage(d * k);
    if (kind == KindTriangle)
        return FillAndStroke(color, d, k, P(p, at + 6), p[at + 7]);
    if (kind == KindImage)
    {
        float cov = Coverage(d * k);
        if (cov <= 0)
            return float4(0, 0, 0, 0);
        float x0 = P(p, at);
        float y0 = P(p, at + 1);
        float du = (P(p, at + 6) - P(p, at + 4)) / (P(p, at + 2) - x0);
        float dv = (P(p, at + 7) - P(p, at + 5)) / (P(p, at + 3) - y0);
        float2 uv = float2(P(p, at + 4) + (q.x - x0) * du, P(p, at + 5) + (q.y - y0) * dv);
        uint size = p[at + 8];
        float texels = Max(Abs(du) * (float)(size & 65535), Abs(dv) * (float)(size >> 16)) * P(a.Groups, g * GroupWords + 13);
        float lod = Max(Log2(Max(texels, 0.000001)), 0);
        float4 t = paint.Texture.Sample(paint.Sampler, uv, lod: lod);
        if ((c.x & FlagImageSrgbPremultiplied) == 0)
            t = float4(LinearToSrgb(t.x) * t.w, LinearToSrgb(t.y) * t.w, LinearToSrgb(t.z) * t.w, t.w);
        return t * color * cov;
    }
    return float4(0, 0, 0, 0);
}

/// Command `c`'s premultiplied color at the pixel centered at `px`.
float4 Shade(uint4 c, in FineArgs a, float2 px)
{
    float4 color = ShadeUnclipped(c, a, px);
    float k = P(a.Groups, (c.x >> 16) * GroupWords + 12) * ClipCoverage(a.Clips, a.Groups, c.y & 65535, px);
    return color * k;
}

/// The pixel centered at `px` after command `c` is drawn over `dst`: `c`'s color over it, or for
/// a backdrop blur, `dst` turned into the blurred image as far as the blur covers the pixel.
float4 Composite(uint4 c, in FineArgs a, float2 px, float4 dst)
{
    if ((c.x & 63) != KindBlur)
        return Over(Shade(c, a, px), dst);
    uint g = c.x >> 16;
    uint at = c.w;
    float d = RectDistance(a.Payload, at, at + 4, Apply(a.Groups, g, 6, px));
    float k = Coverage(d * PixelsPerUnit(a.Groups, g, KindBlur, a.Payload, at, px, d))
        * P(a.Groups, g * GroupWords + 12)
        * ClipCoverage(a.Clips, a.Groups, c.y & 65535, px);
    return dst + (Backdrop(c, a, px) - dst) * k;
}

[Compute(16, 16, 1)]
public void Fine([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in FineArgs a)
{
    UiFrame f = a.Frame.Value;
    uint2 xy = group.xy * 16 + thread.xy;
    float2 px = float2((float)xy.x + 0.5, (float)xy.y + 0.5);
    uint4 h = a.Heads[group.y * f.TilesX + group.x];
    // A clean tile keeps last frame's pixels.
    if (h.z == 0)
        return;
    bool inside = xy.x < f.Width && xy.y < f.Height;
    uint block = h.x;
    float4 color = f.Clear;
    if (a.First > 0 && inside)
        color = a.Previous.Load((int2)xy);
    for (uint k = 0; k < h.y; k++)
    {
        uint slot = k % BlockCommands;
        if (slot == 0 && k > 0)
            block = a.Pool[block * BlockWords + BlockCommands];
        uint i = a.Pool[block * BlockWords + slot];
        if (i >= a.End)
            break;
        if (i >= a.First)
            color = Composite(a.Commands[i], a, px, color);
    }
    if (inside)
        a.Output[(int2)xy] = color;
}

public struct BlurArgs
{
    public Texture2D<float4> Source;
    public StorageTexture2D<float4> Output;
    /// 0: each texel averages `Scale` × `Scale` source texels from `Origin` on; 1: a horizontal
    /// Gaussian of σ `Sigma`; 2: a vertical one.
    public uint Mode;
    public uint Scale;
    /// x | y << 16.
    public uint Origin;
    /// The output's size: width | height << 16.
    public uint Size;
    /// The source's size: width | height << 16.
    public uint SourceSize;
    public float Sigma;
}

/// Source texel `(x, y)`, clamped to the source.
float4 BlurLoad(in BlurArgs a, int x, int y)
{
    int w = (int)(a.SourceSize & 65535);
    int h = (int)(a.SourceSize >> 16);
    return a.Source.Load(int2(Clamp(x, 0, w - 1), Clamp(y, 0, h - 1)));
}

/// A backdrop blur's image (§5.6), one step a dispatch: scaled down, then blurred along x, then
/// along y (`marlin_ui_render::blur::blur`).
[Compute(8, 8, 1)]
public void Blur([DispatchThreadId] uint3 id, [Push] in BlurArgs a)
{
    if (id.x >= (a.Size & 65535) || id.y >= (a.Size >> 16))
        return;
    int x = (int)id.x;
    int y = (int)id.y;
    float4 acc = float4(0, 0, 0, 0);
    if (a.Mode == 0)
    {
        int s = (int)a.Scale;
        int ox = (int)(a.Origin & 65535);
        int oy = (int)(a.Origin >> 16);
        for (int j = 0; j < s; j++)
        {
            for (int i = 0; i < s; i++)
                acc = acc + BlurLoad(a, ox + x * s + i, oy + y * s + j);
        }
        acc = acc / (float)(s * s);
    }
    else
    {
        int dx = a.Mode == 1 ? 1 : 0;
        int dy = 1 - dx;
        int n = (int)Ceil(a.Sigma * 3);
        float total = 0;
        for (int t = -n; t <= n; t++)
        {
            float w = a.Sigma > 0 ? Exp(-(float)(t * t) / (2 * a.Sigma * a.Sigma)) : 1.0;
            acc = acc + BlurLoad(a, x + t * dx, y + t * dy) * w;
            total = total + w;
        }
        acc = acc / total;
    }
    a.Output[int2(x, y)] = acc;
}

public struct EncodeArgs
{
    public Texture2D<float4> Ui;
    /// 1: the target encodes sRGB on write (an `…Srgb` view), so this writes linear values.
    public uint Decode;
}

public struct EncodeVertex
{
    [Position] public float4 Pos;
}

/// One triangle covering the target: vertex ids 0, 1, 2.
[Vertex]
public EncodeVertex EncodeVs([VertexId] uint vertex)
{
    float2 uv = float2((float)((vertex << 1) & 2), (float)(vertex & 2));
    return EncodeVertex { Pos = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1) };
}

/// The UI target's pixel into the window's format (0012 §5.7).
[Pixel]
public float4 EncodePs(in EncodeVertex i, [Push] in EncodeArgs a)
{
    float4 c = a.Ui.Load((int2)i.Pos.xy);
    if (a.Decode == 0)
        return c;
    return float4(SrgbToLinear(c.x), SrgbToLinear(c.y), SrgbToLinear(c.z), c.w);
}

public struct GlyphUploadArgs
{
    /// Per new glyph: x | y << 16, width | height << 16, page, its first word in `Data`.
    public ReadOnlyBuffer<uint4> Uploads;
    /// Coverage bytes, four to a word, row after row; each glyph starts on a word.
    public ReadOnlyBuffer<uint> Data;
    public StorageTexture2DArray<float> Pages;
}

/// New glyph bitmaps into the glyph cache's pages: one thread per texel of glyph `id.z`.
[Compute(8, 8, 1)]
public void GlyphUpload([DispatchThreadId] uint3 id, [Push] in GlyphUploadArgs a)
{
    uint4 u = a.Uploads[id.z];
    uint w = u.y & 65535;
    if (id.x >= w || id.y >= (u.y >> 16))
        return;
    uint b = id.y * w + id.x;
    uint v = (a.Data[u.w + (b >> 2)] >> ((b & 3) * 8)) & 255;
    int2 texel = int2((int)((u.x & 65535) + id.x), (int)((u.x >> 16) + id.y));
    a.Pages[texel, (int)u.z] = (float)v / 255;
}
