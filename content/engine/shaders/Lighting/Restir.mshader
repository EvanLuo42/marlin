namespace Marlin.Engine.Lighting;

// ReSTIR (0010 §2): one reservoir for direct and indirect light (R4c; R3c drew local lights only).
// The reservoir owns `Dnee` (local lights) and, with `Gi`, `I` and the sky's `Dhit` (0010 §2.9),
// over the material buffer's proxy lobe. Reservoirs are cells: a pixel each, or, with `Checkerboard`
// (0010 §3, L2), half the pixels in a checkerboard; the reservoir passes (1–4) run on the cells and
// the shading (5) on every pixel. marlin-render's `RestirDi` declares, a frame:
//
// 1. `RestirInitial`: every pixel draws `Candidates` lights from one presampled light tile (the
//    same tile for its 8×8 screen tile, `LightTiles.mshader`) and keeps one by resampled
//    importance sampling (RIS): weight = target / source pdf, the target the unshadowed
//    contribution. With `InitialVisibility`, one shadow ray tests the one kept: an occluded one
//    keeps its confidence but no weight, so occluded lights do not spread through reuse.
//    With `Gi`, `RestirInitialGi` then adds a second kind of candidate: a cosine-distributed bounce
//    from the pixel's surface, its sample the surface `x2` it reaches (with the radiance leaving
//    it, `RadianceAt`) or the sky. The passes below reuse every kind alike (`SampleLobes`,
//    `SampleVisible`): a surface sample is in area measure at `x2`, so reusing it at another
//    pixel is a reconnection whose Jacobian its target already holds.
// 2. `RestirTemporal` (0010 §2.4): the pixel's reservoir last frame, found through the motion
//    vector, unless its surface changed (distance to the eye, normal); its sample's target
//    evaluated here, its confidence capped at `MaxHistory`; the two reservoirs merged by RIS
//    weighted by confidence. Into this frame's history, or, with spatial reuse, into its input.
// 3. `RestirSpatialShift`, then `RestirSpatial` (0010 §2.5): paired spatial reuse. Pixels pair
//    up through the cooked pairing patterns, one pattern per neighbor; the first pass shifts
//    every pixel's sample to its partners, the second resamples the pixel's reservoir and its
//    partners' by pairwise MIS from those shifts. Into this frame's history.
// 4. `RestirDuplication`: the duplication map of the frame's reservoirs, which lowers the next
//    frame's temporal cap where one sample has spread (PTE §5), and sizes the noise's blobs.
// 5. `RestirShade`: the kept sample's contribution, its visibility from one ray (to a point of
//    the light's sphere, to `x2`, or toward the sky), times the reservoir's weight `W`: a noisy
//    signal, demodulated, for the denoiser (`Denoise.mshader`), with its hints (0010 §6.1): the
//    reservoir's fresh share as `Novelty`, the duplication map's blob size as
//    `CorrelationRadius`.
//
// Lambert diffuse for now, like the sun (`Lighting.mshader`): the exact BSDF comes with the
// final shading (0010 §2.6). Light units: candela times color (`LightDesc`); a light fades out
// at its range with UE's window `saturate(1 − (d/range)⁴)²`.

using Marlin.Substrate;
using Marlin.Engine.Scene;
using Marlin.Engine.Material;

/// A row of the light table (`marlin_render::scene::gpu`); a removed light's row is all zero.
public struct LightRow
{
    /// 0 directional (or none), 1 point, 2 spot.
    public uint Kind;
    public float Range;
    /// Spot: cosines of the inner and outer half angles.
    public float2 Cone;
    /// Candela times the linear color.
    public float3 Intensity;
    /// The emitting sphere's radius.
    public float Radius;
    public float3 Position;
    public uint Spare0;
    /// Where a spot light shines.
    public float3 Direction;
    public uint Spare1;
}

/// A pixel's reservoir (48 bytes, 0010 §2.1's reconnection format): a path's sample, of one of
/// three kinds. A light (`Dnee`): its row and where on its sphere the shadow ray goes. A surface
/// `x2` a bounce from `x1` reached (`I`, and `Dhit` where `x2` glows): the point, its normal and
/// the radiance leaving it toward `x1`, in area measure at `x2` so reuse reconnects it to other
/// pixels' surfaces as it would a light's point. The sky a bounce reached (`Dhit`): the
/// direction and the sky's radiance, in solid angle (the same direction from every pixel).
public struct PathReservoir
{
    /// The light's row, or `SurfaceSample`, `SkySample`; `NoLight`: none.
    public uint Light;
    /// A light: where on its sphere the shadow ray goes, two unorm16 random numbers. A surface:
    /// its normal (octahedral).
    public uint Sample;
    /// A surface's point, or the sky's direction.
    public float3 Point;
    /// The radiance from a surface or the sky (RGB9E5, `PackRgb9e5`).
    public uint Radiance;
    /// The unbiased contribution weight: Σ weights / (M · target of the kept sample).
    public float W;
    /// Confidence: frames' (candidate sets') worth of samples behind it.
    public float M;
    /// The target of the kept sample at this pixel.
    public float Target;
    /// The pixel's surface, for the next frame to tell whether it is the same: its normal
    /// (octahedral) and its distance to the eye (0: no surface).
    public uint Normal;
    public float Distance;
    /// The share of the reservoir's confidence drawn this frame (0010 §6.1's `Novelty`): 1 for an
    /// initial sample; temporal reuse counts last frame's part as 0, and both reuses average it
    /// by confidence. Not by RIS weight, though that is the probability the sample shaded is new:
    /// the weight follows the sample's value, and a novelty that does makes the denoiser's
    /// novelty-weighted average biased.
    public float Fresh;
}

public struct RestirConstants
{
    /// The camera's clip space to world. Column-major.
    public float4x4 InverseViewProjection;
    /// xyz: the camera.
    public float4 Eye;
    /// xyz: the direction the sun's light travels; w: 1 with a sun (for `x2`'s next event).
    public float4 SunDirection;
    /// rgb: the sun's illuminance over π.
    public float4 Sun;
    /// rgb: the sky's luminance, alike in every direction.
    public float4 Sky;
    public uint Width;
    public uint Height;
    /// Lights each pixel draws.
    public uint Candidates;
    /// A new one each frame.
    public uint Seed;
    public uint TileCount;
    public uint TileSize;
    /// 1: test the initial sample's visibility.
    public uint InitialVisibility;
    /// 1: last frame's reservoirs are there.
    public uint HasHistory;
    /// The most confidence a reservoir carries from last frame, where its sample is not
    /// duplicated around it.
    public float MaxHistory;
    /// 1: the duplication map lowers that cap (PTE §5): `lerp(MaxHistory, 1, d^DuplicationPower)`,
    /// d the pixel's duplication last frame.
    public uint Duplication;
    public float DuplicationPower;
    /// Words of `ChangedLights`.
    public uint ChangedWords;
    /// Paired spatial neighbors (0010 §2.5): one per pairing pattern, none when 0.
    public uint Neighbors;
    /// 1: a shadow ray for every sample shifted to a neighbor (0010 §2.6, L2 and up).
    public uint SpatialVisibility;
    /// This frame's placement of the patterns: a translation, then bit 0 flips x, bit 1 flips
    /// y, bit 2 swaps them.
    public uint2 PairingOffset;
    public uint PairingFlags;
    /// 1: `DuplicationMap` holds this frame's map when the shading reads it (for the hints).
    public uint DuplicationReady;
    /// 1: reservoirs for half the pixels, a checkerboard (0010 §3, L2): cell (i, y) is pixel
    /// (2i + ((y + Parity) & 1), y). The shading resamples a pixel without one from its four
    /// neighbors, which have one (0010 §2.6). 0: a reservoir a pixel, cell = pixel.
    public uint Checkerboard;
    /// This frame's and last frame's checkerboard parity: they alternate, so two frames cover
    /// every pixel.
    public uint Parity;
    public uint PreviousParity;
    /// Cells a row of the reservoirs: `Width`, or half of it rounded up.
    public uint GridWidth;
    /// 1: the reservoirs own `I` (0010 §2.9): a bounce from `x1` is a candidate
    /// (`RestirInitialGi`).
    public uint Gi;
    /// 1: the radiance at `x2` is its next event and one more bounce ending at the world cache
    /// (L2); 0: the cache's at `x2` (L0, L1).
    public uint GiBounce;
}

public struct RestirArgs
{
    public Uniform<RestirConstants> Constants;
    public Texture2D<uint4> MaterialBuffer;
    /// The camera's depth (`R32Float`, reverse-Z, 0 where nothing is).
    public Texture2D<float> Depth;
    /// Screen motion since last frame, in UV units (y down): current minus last.
    public Texture2D<float2> Velocity;
    public ReadOnlyBuffer<LightRow> Lights;
    /// Presampled light tiles: per entry the light's row and its probability (float bits).
    public ReadOnlyBuffer<uint2> Tiles;
    /// The pass's input reservoirs, and its output.
    public ReadOnlyBuffer<PathReservoir> Input;
    public Buffer<PathReservoir> Output;
    /// Last frame's reservoirs.
    public ReadOnlyBuffer<PathReservoir> Previous;
    /// A float per pixel: the share of its 17×17 neighbors (of 288) holding its reservoir's
    /// sample. The temporal pass reads last frame's; `RestirDuplication` writes this frame's.
    public Buffer<float> DuplicationMap;
    /// A bit per light row: added, changed or removed this frame (its reused samples are not
    /// trusted); `ChangedWords` words.
    public ReadOnlyBuffer<uint> ChangedLights;
    public AccelerationStructure Tlas;
    /// The pairing patterns (`marlin_render::restir`): words 0–3 their sides, 4–7 where each
    /// starts (in 16-bit offsets after the header), then the offsets, `(dx + 128) | (dy + 128) << 8`.
    public ReadOnlyByteBuffer Pairing;
    /// Per neighbor slot and pixel (slot-major): the pixel's sample shifted to its partner in that
    /// slot, the target there; negative: no partner (off screen, or another surface).
    public Buffer<float> ShiftsOut;
    public ReadOnlyBuffer<float> Shifts;
    /// The shading's output, noisy signals for the denoisers (0010 §6.1, `Denoise.mshader`): the
    /// diffuse light demodulated (divided by the albedo) and the distance to the sample; the
    /// specular light demodulated (divided by `SpecularAlbedo`) and the same distance; and their
    /// hints, `Novelty` and `CorrelationRadius`.
    public StorageTexture2D<float4> Signal;
    public StorageTexture2D<float4> SpecularSignal;
    public StorageTexture2D<float2> Hints;
    /// What a GI bounce's hit is made of, and the world cache it ends at (`RestirInitialGi`).
    public Uniform<GiSources> Gi;
}

/// `RestirArgs.Gi`: a uniform block, as push constants hold 128 bytes.
public struct GiSources
{
    public SharcSources Cache;
    public HitSources Hits;
    public SimpleSources Simple;
}

const uint NoLight = 4294967295;
/// `PathReservoir.Light` of a surface sample and of a sky sample.
const uint SurfaceSample = 4294967294;
const uint SkySample = 4294967293;
/// The distance the signal gives a sky sample's hit.
const float SkyDistance = 1000;

float Luminance(float3 c) => Dot(c, float3(0.2126, 0.7152, 0.0722));

/// The world position of screen pixel `px` at `depth`.
float3 WorldAt(in RestirConstants c, uint2 px, float depth)
{
    float2 ndc = float2(((float)px.x + 0.5) / (float)c.Width * 2 - 1, 1 - ((float)px.y + 0.5) / (float)c.Height * 2);
    float4 p = c.InverseViewProjection * float4(ndc, depth, 1);
    return p.xyz / p.w;
}

/// The light a Lambert surface at `x`, facing `n`, of albedo `albedo`, reflects toward the eye
/// from light `l` (without shadows): albedo / π · I · cos θ / d², faded by the range window and a
/// spot's cone.
float3 Contribution(in LightRow l, float3 x, float3 n, float3 albedo)
{
    float3 toward;
    float3 incident = LightIncident(l, x, out toward);
    return albedo * (0.31830989 * Saturate(Dot(n, toward))) * incident;
}

/// What light `l` sends to `x`, before the surface's cosine: I · window / d² (times a spot's
/// cone), and the direction toward it.
float3 LightIncident(in LightRow l, float3 x, out float3 toward)
{
    float3 d = l.Position - x;
    float d2 = Max(Dot(d, d), 0.0001);
    float dist = Sqrt(d2);
    toward = d / dist;
    float window = Saturate(1 - Pow(dist / Max(l.Range, 0.0001), 4));
    float falloff = window * window / d2;
    float spot = 1;
    if (l.Kind == 2)
    {
        float c = Dot(-toward, l.Direction);
        float s = Saturate((c - l.Cone.y) / Max(l.Cone.x - l.Cone.y, 0.0001));
        spot = s * s;
    }
    if (l.Kind == 0)
        return float3(0, 0, 0);
    return l.Intensity * (falloff * spot);
}

/// What light `l` gives the proxy lobe `p` at `x` seen along `v`, unshadowed: diffuse, and
/// specular of at least `MinLightRoughness`.
Lobes LightLobes(in LightRow l, float3 x, float3 v, in Proxy p)
{
    float3 toward;
    float3 incident = LightIncident(l, x, out toward);
    return ProxyLobes(p, v, toward, incident, true, MinLightRoughness);
}

/// The luminance of `LightLobes`: a light candidate's target.
float LightTarget(in LightRow l, float3 x, float3 v, in Proxy p)
{
    Lobes o = LightLobes(l, x, v, p);
    return Luminance(o.Diffuse + o.Specular);
}

/// Whether the surface at `x` (facing `n`) sees the point of light `l`'s sphere that `sample`
/// names (on the half facing `x`): one shadow ray.
bool Visible(in RestirConstants c, in RestirArgs a, in LightRow l, float3 x, float3 n, uint sample)
{
    float u = (float)(sample & 0xFFFF) / 65536.0;
    float v = (float)(sample >> 16) / 65536.0;
    float3 toward = Normalize(x - l.Position);
    float ring = Sqrt(Max(1 - u * u, 0));
    float phi = v * 6.2831853;
    float3 t = Normalize(Cross(Abs(toward.y) < 0.99 ? float3(0, 1, 0) : float3(1, 0, 0), toward));
    float3 b = Cross(toward, t);
    float3 point = l.Position + l.Radius * (toward * u + t * (ring * Cos(phi)) + b * (ring * Sin(phi)));
    // From just off the surface, scaled with the distance to the eye.
    float3 origin = x + n * (0.001 + 0.0005 * Length(x - c.Eye.xyz));
    float3 d = point - origin;
    float dist = Length(d);
    Ray ray = Ray { Origin = origin, TMin = 0, Direction = d / Max(dist, 0.0001), TMax = dist * 0.999 };
    return !a.Tlas.TraceAny(ray, RayFlags.CullBackFace);
}

/// `x` as a float in [0, 1), from a hash.
float Random(uint x) => Unit(Hash(x));

/// The screen pixel of reservoir cell `cell` this frame (see `Checkerboard`).
uint2 PixelOf(in RestirConstants c, uint2 cell) =>
    c.Checkerboard != 0 ? uint2(cell.x * 2 + ((cell.y + c.Parity) & 1), cell.y) : cell;

/// Whether `cell` is a reservoir: inside the grid, its pixel inside the screen.
bool CellInside(in RestirConstants c, uint2 cell) =>
    cell.x < c.GridWidth && cell.y < c.Height && PixelOf(c, cell).x < c.Width;

/// Where cell `cell`'s reservoir is.
uint CellIndex(in RestirConstants c, uint2 cell) => cell.y * c.GridWidth + cell.x;

/// The cell of parity `parity` nearest screen position `at` (pixels, unclamped): the pixel there,
/// or, in checkerboard, its neighbor along x on the nearer side where the pixel has no reservoir.
uint2 CellNear(in RestirConstants c, float2 at, uint parity)
{
    int x = Clamp((int)Floor(at.x), 0, (int)c.Width - 1);
    int y = Clamp((int)Floor(at.y), 0, (int)c.Height - 1);
    if (c.Checkerboard == 0)
        return uint2((uint)x, (uint)y);
    if (((uint)x & 1) != (((uint)y + parity) & 1))
    {
        x += Frac(at.x) < 0.5 ? -1 : 1;
        if (x < 0)
            x = 1;
        if (x >= (int)c.Width)
            x -= 2;
    }
    return uint2((uint)Max(x, 0) >> 1, (uint)y);
}

/// A reservoir without a sample, for the surface `normal` at `distance` (0: none).
PathReservoir Empty(uint normal, float distance) =>
    PathReservoir { Light = NoLight, Sample = 0, Point = float3(0, 0, 0), Radiance = 0, W = 0, M = 0, Target = 0, Normal = normal, Distance = distance, Fresh = 1 };

/// Whether `r` holds a sample: a light, a surface or the sky.
bool HasSample(in PathReservoir r) => r.Light != NoLight;

/// Whether `r`'s sample is a light (a row of the light table).
bool IsLight(in PathReservoir r) => r.Light < SkySample;

/// What `r`'s sample gives the proxy lobe `p` at `x` seen along `v` (toward the eye),
/// unshadowed: diffuse and specular, whose luminance is the sample's target there. A light's
/// specular is there at any roughness (at least `MinLightRoughness`); a surface's or the sky's
/// only from `SpecularTau` up: below, the specular tracing owns their reflection (0010 §2.7).
/// A surface sample is in area measure at its point (the incident radiance times cos θ₂ / d²),
/// which a reconnection to another pixel's surface weighs as it would a light's point (no
/// Jacobian to apply).
Lobes SampleLobes(in RestirArgs a, in PathReservoir r, float3 x, float3 v, in Proxy p)
{
    if (IsLight(r))
        return LightLobes(a.Lights[r.Light], x, v, p);
    float3 radiance = UnpackRgb9e5(r.Radiance);
    bool specular = p.Roughness >= SpecularTau;
    if (r.Light == SkySample)
        return ProxyLobes(p, v, r.Point, radiance, specular, 0);
    float3 d = r.Point - x;
    float d2 = Max(Dot(d, d), 0.0001);
    float3 toward = d * (1 / Sqrt(d2));
    float cos2 = Saturate(-Dot(UnpackOct(r.Sample), toward));
    return ProxyLobes(p, v, toward, radiance * (cos2 / d2), specular, 0);
}

/// The luminance of `SampleLobes`: the sample's target at `x`.
float SampleTarget(in RestirConstants c, in RestirArgs a, in PathReservoir r, float3 x, in Proxy p)
{
    Lobes o = SampleLobes(a, r, x, ViewOf(c, x), p);
    return Luminance(o.Diffuse + o.Specular);
}

/// The direction from `x` toward the eye.
float3 ViewOf(in RestirConstants c, float3 x) => Normalize(c.Eye.xyz - x);

/// Whether the surface at `x` (facing `n`) sees `r`'s sample: one ray.
bool SampleVisible(in RestirConstants c, in RestirArgs a, in PathReservoir r, float3 x, float3 n)
{
    if (IsLight(r))
        return Visible(c, a, a.Lights[r.Light], x, n, r.Sample);
    float3 origin = x + n * (0.001 + 0.0005 * Length(x - c.Eye.xyz));
    if (r.Light == SkySample)
        return Unoccluded(a.Tlas, origin, origin + r.Point * 100000);
    // Short of the point: the surface there would occlude it.
    float3 d = r.Point - origin;
    float dist = Length(d);
    Ray ray = Ray { Origin = origin, TMin = 0, Direction = d / Max(dist, 0.0001), TMax = dist * 0.99 };
    return !a.Tlas.TraceAny(ray, RayFlags.CullBackFace);
}

/// How far from `x` `r`'s sample is: the signal's hit distance.
float SampleDistance(in RestirArgs a, in PathReservoir r, float3 x) =>
    IsLight(r) ? Length(a.Lights[r.Light].Position - x) : r.Light == SkySample ? SkyDistance : Length(r.Point - x);

/// Takes `from`'s sample into `to`.
void TakeSample(ref PathReservoir to, in PathReservoir from)
{
    to.Light = from.Light;
    to.Sample = from.Sample;
    to.Point = from.Point;
    to.Radiance = from.Radiance;
}

[Compute(8, 8, 1)]
public void RestirInitial([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.GridWidth || id.y >= c.Height)
        return;
    uint pixel = CellIndex(c, id.xy);
    uint2 px = PixelOf(c, id.xy);
    if (px.x >= c.Width)
    {
        a.Output[pixel] = Empty(0, 0);
        return;
    }
    float depth = a.Depth.Load((int2)px);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)px));
    if (depth <= 0 || p.Count == 0)
    {
        a.Output[pixel] = Empty(0, 0);
        return;
    }
    float3 x = WorldAt(c, px, depth);
    PathReservoir r = Empty(PackOct(p.Normal), Length(x - c.Eye.xyz));
    // One tile per 8×8 screen tile, a new one each frame.
    uint seed = Hash(c.Seed ^ Hash(px.y * c.Width + px.x));
    uint tile = Hash(c.Seed ^ Hash((px.y / 8) * 65536 + px.x / 8)) % c.TileCount;
    float sum = 0;
    for (uint i = 0; i < c.Candidates; i++)
    {
        uint h = Hash(seed + i * 0x9E3779B9);
        uint2 entry = a.Tiles[tile * c.TileSize + h % c.TileSize];
        float source = AsFloat(entry.y);
        if (source <= 0)
            continue;
        float target = LightTarget(a.Lights[entry.x], x, ViewOf(c, x), p);
        float weight = target / source;
        sum += weight;
        if (weight > 0 && Random(h ^ 0x68E31DA4) * sum < weight)
        {
            r.Light = entry.x;
            r.Target = target;
        }
    }
    r.M = 1;
    if (r.Light != NoLight)
    {
        r.W = sum / ((float)c.Candidates * r.Target);
        r.Sample = Hash(seed ^ 0xB5297A4D);
    }
    a.Output[pixel] = r;
}

/// The initial sample's shadow ray (`InitialVisibility`): an occluded one keeps its confidence
/// but no weight. A pass of its own: a ray query in `RestirInitial` holds registers through its
/// candidate loop, and the loop runs at a third less occupancy for it (measured: 3.6 against
/// 2.5 ms at 2560×1369).
[Compute(8, 8, 1)]
public void RestirInitialVisibility([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (!CellInside(c, id.xy))
        return;
    uint pixel = CellIndex(c, id.xy);
    uint2 px = PixelOf(c, id.xy);
    PathReservoir r = a.Output[pixel];
    if (r.Light == NoLight || r.W <= 0)
        return;
    float depth = a.Depth.Load((int2)px);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)px));
    float3 x = WorldAt(c, px, depth);
    if (!Visible(c, a, a.Lights[r.Light], x, p.Normal, r.Sample))
        a.Output[pixel].W = 0;
}

/// The light that reaches `x2` (the surface `s`, of simplified material `m`) and leaves it toward
/// the bounce that found it: what it emits, and what it reflects, as `GiBounce` says (see
/// `RestirConstants`). The world cache's radiance where it has an entry; where it has none, the
/// surface's albedo times the sky.
float3 RadianceAt(in RestirConstants c, in RestirArgs a, in GiSources gi, in HitSurface s, in SimpleMaterial m, ref uint state)
{
    float3 eye = c.Eye.xyz;
    if (c.GiBounce == 0)
    {
        float4 cached = SharcQuery(gi.Cache, s.Position, s.Normal);
        return m.Emission + (cached.w > 0 ? cached.xyz : m.Albedo * c.Sky.xyz);
    }
    float3 origin = Lift(s.Position, s.Normal, eye);
    NextEventSources nee = NextEventSources
    {
        Tlas = a.Tlas,
        Lights = a.Lights,
        Tiles = a.Tiles,
        SunDirection = c.SunDirection,
        Sun = c.Sun,
        TileCount = c.TileCount,
        TileSize = c.TileSize,
        Candidates = c.Candidates,
    };
    float3 direct = NextEvent(nee, s.Position, origin, s.Normal, m.Albedo, ref state);
    // One more bounce, ending at the cache (`x3`'s reflected light) or the sky.
    float u = PathRandom(ref state);
    float v = PathRandom(ref state);
    Ray ray = Ray { Origin = origin, TMin = 0, Direction = CosineDirection(s.Normal, u, v), TMax = 100000 };
    RayHit hit = a.Tlas.TraceClosest(ray, RayFlags.CullBackFace);
    float3 beyond = c.Sky.xyz;
    if (hit.Kind != HitKind.None)
    {
        beyond = float3(0, 0, 0);
        if (hit.FrontFace)
        {
            HitSurface t = SurfaceOfHit(hit, ray, gi.Hits);
            SimpleMaterial mt = SimpleOfHit(t, gi.Hits, gi.Simple);
            float4 cached = SharcQuery(gi.Cache, t.Position, t.Normal);
            beyond = mt.Emission + (cached.w > 0 ? cached.xyz : mt.Albedo * c.Sky.xyz);
        }
    }
    return m.Emission + direct + m.Albedo * beyond;
}

/// The GI candidate (`Gi`, 0010 §2.2 steps 3–5): a bounce from `x1`, cosine-distributed, and
/// what it found, resampled with the reservoir `RestirInitial` drew (its visibility tested). A
/// surface's radiance is `RadianceAt`'s; the sky's, its luminance; the sun's disc is VSM's and is
/// not in the sky (0010 §2.9 rule 4). In area measure the candidate's weight is target / pdf =
/// luminance(albedo · L): the cosine and distance terms cancel.
[Compute(8, 8, 1)]
public void RestirInitialGi([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    GiSources gi = a.Gi.Value;
    if (!CellInside(c, id.xy))
        return;
    uint pixel = CellIndex(c, id.xy);
    uint2 px = PixelOf(c, id.xy);
    PathReservoir r = a.Output[pixel];
    if (r.Distance <= 0)
        return;
    float depth = a.Depth.Load((int2)px);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)px));
    float3 x = WorldAt(c, px, depth);
    uint state = Hash(c.Seed ^ 0x3C6EF372 ^ Hash(px.y * c.Width + px.x));
    float3 view = ViewOf(c, x);
    // A direction from the lobes: the specular one (VNDF) with probability `chance` where it is
    // resampled (roughness from `SpecularTau`), else the diffuse one (cosine); the pdf is the
    // mixture's (one-sample MIS).
    float chance = 0;
    if (p.Roughness >= SpecularTau)
    {
        float specular = Luminance(SpecularAlbedo(p.F0, p.Roughness, Saturate(Dot(p.Normal, view))));
        chance = Clamp(specular / Max(specular + Luminance(p.Albedo), 1e-6), 0.1, 1);
    }
    float pick = PathRandom(ref state);
    float u = PathRandom(ref state);
    float v = PathRandom(ref state);
    float3 direction = pick < chance ? SampleSpecular(p.Normal, view, p.Roughness, u, v) : CosineDirection(p.Normal, u, v);
    float cosine = Dot(p.Normal, direction);
    if (cosine <= 0)
        return;
    float pdf = (1 - chance) * cosine * 0.31830989;
    if (chance > 0)
        pdf += chance * SpecularPdf(p.Normal, view, direction, p.Roughness);
    if (pdf <= 0)
        return;
    Ray ray = Ray { Origin = Lift(x, p.Normal, c.Eye.xyz), TMin = 0, Direction = direction, TMax = 100000 };
    RayHit hit = a.Tlas.TraceClosest(ray, RayFlags.CullBackFace);
    PathReservoir g = r;
    float weight = 0;
    if (hit.Kind == HitKind.None)
    {
        g.Light = SkySample;
        g.Point = direction;
        g.Radiance = PackRgb9e5(c.Sky.xyz);
        Lobes o = ProxyLobes(p, view, direction, c.Sky.xyz, chance > 0, 0);
        weight = Luminance(o.Diffuse + o.Specular) / pdf;
    }
    else if (hit.FrontFace)
    {
        HitSurface surface = SurfaceOfHit(hit, ray, gi.Hits);
        SimpleMaterial m = SimpleOfHit(surface, gi.Hits, gi.Simple);
        float3 radiance = RadianceAt(c, a, gi, surface, m, ref state);
        g.Light = SurfaceSample;
        g.Sample = PackOct(surface.Normal);
        g.Point = surface.Position;
        g.Radiance = PackRgb9e5(radiance);
        Lobes o = ProxyLobes(p, view, direction, radiance, chance > 0, 0);
        weight = Luminance(o.Diffuse + o.Specular) / pdf;
    }
    if (weight <= 0)
        return;
    // The reservoir so far: one candidate's worth (M = 1), its weight W · target.
    float before = HasSample(r) ? r.W * r.Target : 0;
    float sum = before + weight;
    PathReservoir s = r;
    if (PathRandom(ref state) * sum < weight)
    {
        TakeSample(ref s, g);
        s.Target = SampleTarget(c, a, g, x, p);
    }
    s.W = s.Target > 0 ? sum / s.Target : 0;
    s.M = 1;
    a.Output[pixel] = s;
}

[Compute(8, 8, 1)]
public void RestirTemporal([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.GridWidth || id.y >= c.Height)
        return;
    uint pixel = CellIndex(c, id.xy);
    uint2 px = PixelOf(c, id.xy);
    PathReservoir r = a.Input[pixel];
    if (c.HasHistory == 0 || r.Distance <= 0)
    {
        a.Output[pixel] = r;
        return;
    }
    // Where the surface was last frame: the reservoir nearest there, of last frame's parity.
    float2 size = float2((float)c.Width, (float)c.Height);
    float2 uv = ((float2)px + 0.5) / size - a.Velocity.Load((int2)px);
    if (uv.x < 0 || uv.y < 0 || uv.x >= 1 || uv.y >= 1)
    {
        a.Output[pixel] = r;
        return;
    }
    PathReservoir q = a.Previous[CellIndex(c, CellNear(c, uv * size, c.PreviousParity))];
    float3 n = UnpackOct(r.Normal);
    // The same surface: about as far from the eye, facing about the same way.
    bool same = q.Distance > 0 && Abs(q.Distance - r.Distance) < 0.1 * r.Distance && Dot(UnpackOct(q.Normal), n) > 0.9;
    // A light added, changed or removed this frame: last frame's weight for it is stale.
    bool changed = IsLight(q) && q.Light / 32 < c.ChangedWords
        && (a.ChangedLights[q.Light / 32] & ((uint)1 << (q.Light % 32))) != 0;
    if (!same || changed || !HasSample(q) || q.M <= 0)
    {
        a.Output[pixel] = r;
        return;
    }
    float depth = a.Depth.Load((int2)px);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)px));
    float3 x = WorldAt(c, px, depth);
    // Last frame's sample, weighed at this frame's surface (its light may have moved or gone).
    float qTarget = SampleTarget(c, a, q, x, p);
    float cap = c.MaxHistory;
    if (c.Duplication != 0)
        cap = Lerp(c.MaxHistory, 1, Pow(Saturate(a.DuplicationMap[pixel]), c.DuplicationPower));
    float qM = Min(q.M, cap);
    float rWeight = r.W * r.Target * r.M;
    float qWeight = qTarget * q.W * qM;
    float sum = rWeight + qWeight;
    PathReservoir s = r;
    if (qWeight > 0 && Random(Hash(c.Seed ^ 0x2545F491) ^ pixel) * sum < qWeight)
    {
        TakeSample(ref s, q);
        s.Target = qTarget;
    }
    s.M = r.M + qM;
    s.W = s.Target > 0 ? sum / (s.M * s.Target) : 0;
    // Last frame's part is not new.
    s.Fresh = r.M * r.Fresh / s.M;
    a.Output[pixel] = s;
}

/// Whether two reservoirs' surfaces are one: about as far from the eye, facing about the same
/// way. Symmetric, so paired pixels agree on whether they reuse from each other.
bool SameSurface(in PathReservoir r, in PathReservoir q) =>
    r.Distance > 0 && q.Distance > 0 && Abs(q.Distance - r.Distance) < 0.1 * Max(r.Distance, q.Distance)
        && Dot(UnpackOct(q.Normal), UnpackOct(r.Normal)) > 0.9;

/// The offset from screen pixel `px` to its partner in pairing pattern `k`, as this frame
/// places the pattern (`PairingOffset`, `PairingFlags`).
int2 PartnerOffset(in RestirConstants c, in RestirArgs a, uint k, uint2 px)
{
    uint size = a.Pairing.Load(k * 4);
    uint start = a.Pairing.Load(16 + k * 4);
    uint x = (px.x + c.PairingOffset.x) % size;
    uint y = (px.y + c.PairingOffset.y) % size;
    if ((c.PairingFlags & 1) != 0)
        x = size - 1 - x;
    if ((c.PairingFlags & 2) != 0)
        y = size - 1 - y;
    if ((c.PairingFlags & 4) != 0)
    {
        uint t = x;
        x = y;
        y = t;
    }
    uint e = start + y * size + x;
    uint packed = (a.Pairing.Load(32 + (e / 2) * 4) >> ((e % 2) * 16)) & 0xFFFF;
    int dx = (int)(packed & 0xFF) - 128;
    int dy = (int)(packed >> 8) - 128;
    // Back to the screen: the placement's inverse.
    if ((c.PairingFlags & 4) != 0)
    {
        int t = dx;
        dx = dy;
        dy = t;
    }
    if ((c.PairingFlags & 1) != 0)
        dx = -dx;
    if ((c.PairingFlags & 2) != 0)
        dy = -dy;
    return int2(dx, dy);
}

/// Cell `cell`'s partner in pattern `k` (the patterns lie on the cells); x negative when it is
/// no reservoir.
int2 Partner(in RestirConstants c, in RestirArgs a, uint k, uint2 cell)
{
    int2 q = int2((int)cell.x, (int)cell.y) + PartnerOffset(c, a, k, cell);
    bool inside = q.x >= 0 && q.y >= 0 && CellInside(c, uint2((uint)q.x, (uint)q.y));
    return inside ? q : int2(-1, -1);
}

/// The first half of paired spatial reuse (0010 §2.5, PTE §3): every pixel's sample shifted to
/// each of its partners, its target there (with a shadow ray from there under
/// `SpatialVisibility`), into `ShiftsOut`. A pair reuses from each other, so these are both
/// shifts of the pair, each computed once.
[Compute(8, 8, 1)]
public void RestirSpatialShift([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.GridWidth || id.y >= c.Height)
        return;
    uint pixels = c.GridWidth * c.Height;
    uint pixel = CellIndex(c, id.xy);
    PathReservoir r = a.Input[pixel];
    for (uint k = 0; k < c.Neighbors; k++)
    {
        float shifted = -1;
        int2 q = Partner(c, a, k, id.xy);
        if (q.x >= 0)
        {
            PathReservoir n = a.Input[CellIndex(c, uint2((uint)q.x, (uint)q.y))];
            if (SameSurface(r, n))
            {
                shifted = 0;
                if (HasSample(r) && r.W > 0)
                {
                    int2 at = (int2)PixelOf(c, uint2((uint)q.x, (uint)q.y));
                    Proxy p = UnpackProxy(a.MaterialBuffer.Load(at));
                    float3 x = WorldAt(c, (uint2)at, a.Depth.Load(at));
                    shifted = SampleTarget(c, a, r, x, p);
                    if (shifted > 0 && c.SpatialVisibility != 0 && !SampleVisible(c, a, r, x, p.Normal))
                        shifted = 0;
                }
            }
        }
        a.ShiftsOut[k * pixels + pixel] = shifted;
    }
}

/// The second half: every pixel resamples its own reservoir (the canonical one) and its
/// partners', with pairwise MIS weighted by confidence (Falcor's `SpatialResampling`; Lin et al.
/// 2022). Both shifts of each pair come from `Shifts`: the partner's sample here is the partner's
/// entry, this pixel's sample there is this pixel's.
[Compute(8, 8, 1)]
public void RestirSpatial([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.GridWidth || id.y >= c.Height)
        return;
    uint pixels = c.GridWidth * c.Height;
    uint pixel = CellIndex(c, id.xy);
    PathReservoir r = a.Input[pixel];
    if (r.Distance <= 0)
    {
        a.Output[pixel] = r;
        return;
    }
    // The confidence of all the reservoirs resampled, and the part of it new this frame.
    float total = r.M;
    float fresh = r.M * r.Fresh;
    for (uint k = 0; k < c.Neighbors; k++)
    {
        int2 q = Partner(c, a, k, id.xy);
        if (a.Shifts[k * pixels + pixel] >= 0 && q.x >= 0)
        {
            PathReservoir n = a.Input[CellIndex(c, uint2((uint)q.x, (uint)q.y))];
            total += n.M;
            fresh += n.M * n.Fresh;
        }
    }
    float others = total - r.M;
    float canonical = r.M / total;
    PathReservoir s = r;
    float sum = 0;
    uint seed = Hash(c.Seed ^ 0x7F4A7C15) ^ pixel;
    for (uint k = 0; k < c.Neighbors; k++)
    {
        float mine = a.Shifts[k * pixels + pixel];
        int2 q = Partner(c, a, k, id.xy);
        if (mine < 0 || q.x < 0)
            continue;
        uint other = CellIndex(c, uint2((uint)q.x, (uint)q.y));
        PathReservoir n = a.Input[other];
        // This pixel's sample, had the partner drawn it: the canonical weight's pairwise term.
        if (mine > 0)
            canonical += n.M / total * (1 - mine * others / (mine * others + r.Target * r.M));
        else
            canonical += n.M / total;
        // The partner's sample, shifted here.
        float theirs = a.Shifts[k * pixels + other];
        if (!HasSample(n) || n.W <= 0 || theirs <= 0)
            continue;
        float source = n.Target * others;
        float m = n.M / total * source / Max(source + theirs * r.M, 1e-20);
        float weight = theirs * n.W * m;
        sum += weight;
        if (weight > 0 && Random(Hash(seed + k * 0x9E3779B9)) * sum < weight)
        {
            TakeSample(ref s, n);
            s.Target = theirs;
        }
    }
    float own = HasSample(r) ? r.Target * r.W * canonical : 0;
    sum += own;
    if (own > 0 && Random(Hash(seed ^ 0x1B873593)) * sum < own)
    {
        TakeSample(ref s, r);
        s.Target = r.Target;
    }
    s.M = total;
    s.W = s.Target > 0 && HasSample(s) ? sum / s.Target : 0;
    s.Fresh = fresh / total;
    a.Output[pixel] = s;
}

/// Neighbor `k` (left, right, up, down) of pixel `px`, which in checkerboard has a cell: its
/// position and reservoir. False where it is off screen or has no surface, or, in `pass` 0,
/// lies on another surface than the one `distance` from the eye facing `normal`.
bool Neighbor(in RestirConstants c, in RestirArgs a, uint2 px, uint k, uint pass, float distance, float3 normal, out int2 q, out PathReservoir n)
{
    q = int2((int)px.x, (int)px.y) + (k == 0 ? int2(-1, 0) : k == 1 ? int2(1, 0) : k == 2 ? int2(0, -1) : int2(0, 1));
    n = Empty(0, 0);
    if (q.x < 0 || q.y < 0 || q.x >= (int)c.Width || q.y >= (int)c.Height)
        return false;
    n = a.Input[CellIndex(c, uint2((uint)q.x >> 1, (uint)q.y))];
    if (n.Distance <= 0)
        return false;
    bool same = Abs(n.Distance - distance) < 0.1 * Max(n.Distance, distance)
        && Dot(UnpackOct(n.Normal), normal) > 0.9;
    return pass != 0 || same;
}

/// Spatial reuse, the biased kind (`BiasedSpatial`; Bitterli et al. 2020's biased variant): every
/// cell resamples its partners' reservoirs, each sample's target evaluated here, weighed by its
/// confidence (1/M MIS) instead of pairwise MIS, and without shadow rays for the partners'
/// samples (the shading's ray tests the one kept). No shift pass: no partner needs this cell's
/// sample at its own surface. Brighter or darker than right where the partners' visibility or
/// targets differ (shadow edges), which the denoiser mostly hides; cheaper.
[Compute(8, 8, 1)]
public void RestirSpatialBiased([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.GridWidth || id.y >= c.Height)
        return;
    uint pixel = CellIndex(c, id.xy);
    PathReservoir r = a.Input[pixel];
    if (r.Distance <= 0)
    {
        a.Output[pixel] = r;
        return;
    }
    uint2 px = PixelOf(c, id.xy);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)px));
    float3 x = WorldAt(c, px, a.Depth.Load((int2)px));
    PathReservoir s = r;
    float sum = HasSample(r) ? r.Target * r.W * r.M : 0;
    float total = r.M;
    float fresh = r.M * r.Fresh;
    uint seed = Hash(c.Seed ^ 0x7F4A7C15) ^ pixel;
    for (uint k = 0; k < c.Neighbors; k++)
    {
        int2 q = Partner(c, a, k, id.xy);
        if (q.x < 0)
            continue;
        PathReservoir n = a.Input[CellIndex(c, uint2((uint)q.x, (uint)q.y))];
        if (!SameSurface(r, n))
            continue;
        total += n.M;
        fresh += n.M * n.Fresh;
        if (!HasSample(n) || n.W <= 0)
            continue;
        float target = SampleTarget(c, a, n, x, p);
        float weight = target * n.W * n.M;
        sum += weight;
        if (weight > 0 && Random(Hash(seed + k * 0x9E3779B9)) * sum < weight)
        {
            TakeSample(ref s, n);
            s.Target = target;
        }
    }
    s.M = total;
    s.W = s.Target > 0 && HasSample(s) ? sum / (total * s.Target) : 0;
    s.Fresh = fresh / total;
    a.Output[pixel] = s;
}

/// Pixel `px`'s reservoir for the shading. A pixel with a cell of its own takes its reservoir.
/// In checkerboard the others resample their four neighbors' (which have cells) by RIS with
/// this pixel's own target (0010 §2.6's reservoir upsampling): those on its surface, or all of
/// them if none is, each weighted alike (1/n). Talbot's 1/|Z| (one over how many of them a
/// sample's light reaches) changed nothing measurable and cost 0.6 ms at 2560×1369 (0010 §6.3).
/// No visibility for the neighbors' samples; the shading's ray tests the one kept.
PathReservoir ShadedReservoir(in RestirConstants c, in RestirArgs a, uint2 px, out float duplication)
{
    duplication = 0;
    bool own = c.Checkerboard == 0 || (px.x & 1) == ((px.y + c.Parity) & 1);
    if (own)
    {
        uint2 cell = c.Checkerboard != 0 ? uint2(px.x >> 1, px.y) : px;
        if (c.DuplicationReady != 0)
            duplication = a.DuplicationMap[CellIndex(c, cell)];
        return a.Input[CellIndex(c, cell)];
    }
    float depth = a.Depth.Load((int2)px);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)px));
    if (depth <= 0 || p.Count == 0)
        return Empty(0, 0);
    float3 x = WorldAt(c, px, depth);
    float distance = Length(x - c.Eye.xyz);
    PathReservoir s = Empty(PackOct(p.Normal), distance);
    float sum = 0;
    float count = 0;
    float fresh = 0;
    uint seed = Hash(c.Seed ^ 0x51ED270B) ^ (px.y * c.Width + px.x);
    for (uint pass = 0; pass < 2 && count == 0; pass++)
    {
        for (uint k = 0; k < 4; k++)
        {
            int2 q;
            PathReservoir n;
            if (!Neighbor(c, a, px, k, pass, distance, p.Normal, out q, out n))
                continue;
            count += 1;
            fresh += n.Fresh;
            if (c.DuplicationReady != 0)
                duplication += a.DuplicationMap[CellIndex(c, uint2((uint)q.x >> 1, (uint)q.y))];
            if (!HasSample(n) || n.W <= 0)
                continue;
            float target = SampleTarget(c, a, n, x, p);
            if (target <= 0)
                continue;
            float weight = target * n.W;
            sum += weight;
            if (Random(Hash(seed + k * 0x9E3779B9)) * sum < weight)
            {
                TakeSample(ref s, n);
                s.Target = target;
            }
        }
    }
    if (count > 0)
    {
        s.W = HasSample(s) && s.Target > 0 ? sum / (count * s.Target) : 0;
        s.Fresh = fresh / count;
        duplication /= count;
    }
    return s;
}

[Compute(8, 8, 1)]
public void RestirShade([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    float duplication;
    PathReservoir r = ShadedReservoir(c, a, id.xy, out duplication);
    // The hints (0010 §6.1): how much of the sample is new, and how far it has been copied
    // around (the duplication map's share d of 288 neighboring reservoirs: blobs of about
    // 1 + 288·d reservoirs, each two pixels in checkerboard).
    float radius = 1;
    if (c.DuplicationReady != 0)
    {
        float area = (1 + 288 * duplication) * (c.Checkerboard != 0 ? 2.0 : 1.0);
        radius = Max(Sqrt(area / 3.14159265), 1);
    }
    a.Hints[(int2)id.xy] = float2(r.Fresh, radius);
    float3 diffuse = float3(0, 0, 0);
    float3 specular = float3(0, 0, 0);
    float hit = 0;
    if (HasSample(r) && r.W > 0)
    {
        float depth = a.Depth.Load((int2)id.xy);
        Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)id.xy));
        float3 x = WorldAt(c, id.xy, depth);
        hit = SampleDistance(a, r, x);
        if (SampleVisible(c, a, r, x, p.Normal))
        {
            // Demodulated: the albedos are the composition's. The diffuse lobe is linear in the
            // albedo: shaded with a white one.
            float3 view = ViewOf(c, x);
            Proxy white = p;
            white.Albedo = float3(1, 1, 1);
            Lobes o = SampleLobes(a, r, x, view, white);
            float3 albedo = SpecularAlbedo(p.F0, p.Roughness, Saturate(Dot(p.Normal, view)));
            diffuse = o.Diffuse * r.W;
            specular = o.Specular / Max(albedo, float3(1e-3, 1e-3, 1e-3)) * r.W;
        }
    }
    a.Signal[(int2)id.xy] = float4(diffuse, hit);
    a.SpecularSignal[(int2)id.xy] = float4(specular, hit);
}

/// What tells an initial sample from every other: its light and the random numbers it was drawn
/// with (each pixel's own, each frame's own).
uint SampleId(in PathReservoir r) => Hash(r.Light ^ AsUInt(r.Point.x)) ^ r.Sample ^ Hash(AsUInt(r.Point.y) + AsUInt(r.Point.z));

/// The sample ids of a 32×32 tile: a 16×16 group and 8 pixels around it.
[GroupShared] uint[1024] DuplicationIds;

/// Ids no sample has: outside the screen, or no sample.
const uint NoId = 4294967295;

/// The duplication map (PTE §5): for every reservoir, how many of the 288 others in its 17×17
/// neighborhood hold the same initial sample, over 288: estimated from every second pixel (80
/// others), as a share.
[Compute(16, 16, 1)]
public void RestirDuplication([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    int2 origin = int2((int)group.x * 16 - 8, (int)group.y * 16 - 8);
    for (uint k = thread.y * 16 + thread.x; k < 1024; k += 256)
    {
        int2 p = origin + int2((int)(k % 32), (int)(k / 32));
        uint id = NoId;
        if (p.x >= 0 && p.y >= 0 && CellInside(c, uint2((uint)p.x, (uint)p.y)))
        {
            PathReservoir r = a.Input[CellIndex(c, uint2((uint)p.x, (uint)p.y))];
            if (r.Light != NoLight && r.W > 0)
                id = SampleId(r);
        }
        DuplicationIds[k] = id;
    }
    Barrier.Group();
    uint2 cell = group.xy * 16 + thread.xy;
    if (cell.x >= c.GridWidth || cell.y >= c.Height)
        return;
    uint me = DuplicationIds[(thread.y + 8) * 32 + thread.x + 8];
    uint same = 0;
    if (me != NoId)
    {
        // Every second pixel of the window, 9 × 9: the same share, a quarter of the work.
        for (uint dy = 0; dy < 17; dy += 2)
        {
            for (uint dx = 0; dx < 17; dx += 2)
                same += DuplicationIds[(thread.y + dy) * 32 + thread.x + dx] == me ? (uint)1 : (uint)0;
        }
        // Not itself.
        same -= 1;
    }
    a.DuplicationMap[CellIndex(c, cell)] = (float)same / 80.0;
}

/// The specular tracing (0010 §2.7, R4d2): where the proxy lobe is smoother than `SpecularTau`,
/// reconnection cannot reuse its reflection of surfaces and the sky, so every such pixel traces
/// one ray from its GGX lobe (VNDF; a mirror's reflection at roughness 0) and shades what it
/// finds as a GI bounce does (`RadianceAt`; the sky where it misses), weighted F · G2 / G1. Added
/// to the specular signal (demodulated) after `RestirShade`, which keeps the lights' highlights;
/// the hit distance becomes the ray's.
[Compute(8, 8, 1)]
public void RestirSpecular([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    int2 px = (int2)id.xy;
    float depth = a.Depth.Load(px);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load(px));
    if (depth <= 0 || p.Count == 0 || p.Roughness >= SpecularTau)
        return;
    GiSources gi = a.Gi.Value;
    float3 x = WorldAt(c, id.xy, depth);
    float3 view = ViewOf(c, x);
    uint state = Hash(c.Seed ^ 0x6A09E667 ^ Hash(id.y * c.Width + id.x));
    float u = PathRandom(ref state);
    float v = PathRandom(ref state);
    float3 direction = SampleSpecular(p.Normal, view, p.Roughness, u, v);
    float3 weight = SpecularWeight(p.Normal, view, direction, p.Roughness, p.F0);
    if (weight.x + weight.y + weight.z <= 0)
        return;
    Ray ray = Ray { Origin = Lift(x, p.Normal, c.Eye.xyz), TMin = 0, Direction = direction, TMax = 100000 };
    RayHit hit = a.Tlas.TraceClosest(ray, RayFlags.CullBackFace);
    float3 radiance = c.Sky.xyz;
    float distance = SkyDistance;
    if (hit.Kind != HitKind.None)
    {
        radiance = float3(0, 0, 0);
        distance = hit.T;
        if (hit.FrontFace)
        {
            HitSurface s = SurfaceOfHit(hit, ray, gi.Hits);
            SimpleMaterial m = SimpleOfHit(s, gi.Hits, gi.Simple);
            radiance = RadianceAt(c, a, gi, s, m, ref state);
        }
    }
    float3 albedo = SpecularAlbedo(p.F0, p.Roughness, Saturate(Dot(p.Normal, view)));
    float4 lights = a.SpecularSignal[px];
    float3 traced = weight * radiance / Max(albedo, float3(1e-3, 1e-3, 1e-3));
    a.SpecularSignal[px] = float4(lights.xyz + traced, distance);
}
