namespace Marlin.Engine.Lighting;

// ReSTIR DI (0010 §2, the §2.9 configuration where the reservoir owns `Dnee`; R3c): local lights
// over the material buffer's proxy lobe. marlin-render's `RestirDi` declares, a frame:
//
// 1. `RestirInitial`: every pixel draws `Candidates` lights from one presampled light tile (the
//    same tile for its 8×8 screen tile, `LightTiles.mshader`) and keeps one by resampled
//    importance sampling (RIS): weight = target / source pdf, the target the unshadowed
//    contribution. With `InitialVisibility`, one shadow ray tests the one kept: an occluded one
//    keeps its confidence but no weight, so occluded lights do not spread through reuse.
// 2. `RestirTemporal` (0010 §2.4): the pixel's reservoir last frame, found through the motion
//    vector, unless its surface changed (distance to the eye, normal); its sample's target
//    evaluated here, its confidence capped at `MaxHistory`; the two reservoirs merged by RIS
//    weighted by confidence. Into this frame's history, or, with spatial reuse, into its input.
// 3. `RestirSpatialShift`, then `RestirSpatial` (0010 §2.5): paired spatial reuse. Pixels pair
//    up through the cooked pairing patterns, one pattern per neighbor; the first pass shifts
//    every pixel's sample to its partners, the second resamples the pixel's reservoir and its
//    partners' by pairwise MIS from those shifts. Into this frame's history.
// 4. `RestirDuplication`: the duplication map of the frame's reservoirs, which lowers the next
//    frame's temporal cap where one sample has spread (PTE §5), and sizes the noise's blobs.
// 5. `RestirShade`: the kept light's contribution, its visibility from one shadow ray to a point
//    of its sphere (a ray query against the TLAS), times the reservoir's weight `W`: a noisy
//    signal, demodulated, for the denoiser (`Denoise.mshader`), with its hints (0010 §6.1): the
//    reservoir's fresh share as `Novelty`, the duplication map's blob size as
//    `CorrelationRadius`.
//
// Lambert diffuse for now, like the sun (`Lighting.mshader`): the exact BSDF comes with the
// final shading (0010 §2.6). Light units: candela times color (`LightDesc`); a light fades out
// at its range with UE's window `saturate(1 − (d/range)⁴)²`.

using Marlin.Substrate;

/// A row of the light table (`marlin_render::scene::gpu`); a removed light's row is all zero.
public struct LightRow
{
    /// 0 directional (or none), 1 point, 2 spot.
    public uint Kind;
    public float Range;
    /// Spot: cosines of the inner and outer half angles.
    public float2 Cone;
    /// Candela times the linear color.
    public float3 Intensity;
    /// The emitting sphere's radius.
    public float Radius;
    public float3 Position;
    public uint Spare0;
    /// Where a spot light shines.
    public float3 Direction;
    public uint Spare1;
}

/// A pixel's reservoir (32 bytes, 0010 §2.1's reconnection format as far as DI needs it).
public struct DiReservoir
{
    /// The light's row; `0xFFFFFFFF`: none.
    public uint Light;
    /// Where on the light's sphere the shadow ray goes: two unorm16 random numbers.
    public uint Sample;
    /// The unbiased contribution weight: Σ weights / (M · target of the kept sample).
    public float W;
    /// Confidence: frames' (candidate sets') worth of samples behind it.
    public float M;
    /// The target of the kept sample at this pixel.
    public float Target;
    /// The pixel's surface, for the next frame to tell whether it is the same: its normal
    /// (octahedral) and its distance to the eye (0: no surface).
    public uint Normal;
    public float Distance;
    /// The share of the reservoir's confidence drawn this frame (0010 §6.1's `Novelty`): 1 for an
    /// initial sample; temporal reuse counts last frame's part as 0, and both reuses average it
    /// by confidence. Not by RIS weight, though that is the probability the sample shaded is new:
    /// the weight follows the sample's value, and a novelty that does makes the denoiser's
    /// novelty-weighted average biased.
    public float Fresh;
}

public struct RestirConstants
{
    /// The camera's clip space to world. Column-major.
    public float4x4 InverseViewProjection;
    /// xyz: the camera.
    public float4 Eye;
    public uint Width;
    public uint Height;
    /// Lights each pixel draws.
    public uint Candidates;
    /// A new one each frame.
    public uint Seed;
    public uint TileCount;
    public uint TileSize;
    /// 1: test the initial sample's visibility.
    public uint InitialVisibility;
    /// 1: last frame's reservoirs are there.
    public uint HasHistory;
    /// The most confidence a reservoir carries from last frame, where its sample is not
    /// duplicated around it.
    public float MaxHistory;
    /// 1: the duplication map lowers that cap (PTE §5): `lerp(MaxHistory, 1, d^DuplicationPower)`,
    /// d the pixel's duplication last frame.
    public uint Duplication;
    public float DuplicationPower;
    /// Words of `ChangedLights`.
    public uint ChangedWords;
    /// Paired spatial neighbors (0010 §2.5): one per pairing pattern, none when 0.
    public uint Neighbors;
    /// 1: a shadow ray for every sample shifted to a neighbor (0010 §2.6, L2 and up).
    public uint SpatialVisibility;
    /// This frame's placement of the patterns: a translation, then bit 0 flips x, bit 1 flips
    /// y, bit 2 swaps them.
    public uint2 PairingOffset;
    public uint PairingFlags;
    /// 1: `DuplicationMap` holds this frame's map when the shading reads it (for the hints).
    public uint DuplicationReady;
    public uint Spare1;
    public uint Spare2;
}

public struct RestirArgs
{
    public Uniform<RestirConstants> Constants;
    public Texture2D<uint4> MaterialBuffer;
    /// The camera's depth (`R32Float`, reverse-Z, 0 where nothing is).
    public Texture2D<float> Depth;
    /// Screen motion since last frame, in UV units (y down): current minus last.
    public Texture2D<float2> Velocity;
    public ReadOnlyBuffer<LightRow> Lights;
    /// Presampled light tiles: per entry the light's row and its probability (float bits).
    public ReadOnlyBuffer<uint2> Tiles;
    /// The pass's input reservoirs, and its output.
    public ReadOnlyBuffer<DiReservoir> Input;
    public Buffer<DiReservoir> Output;
    /// Last frame's reservoirs.
    public ReadOnlyBuffer<DiReservoir> Previous;
    /// A float per pixel: the share of its 17×17 neighbors (of 288) holding its reservoir's
    /// sample. The temporal pass reads last frame's; `RestirDuplication` writes this frame's.
    public Buffer<float> DuplicationMap;
    /// A bit per light row: added, changed or removed this frame (its reused samples are not
    /// trusted); `ChangedWords` words.
    public ReadOnlyBuffer<uint> ChangedLights;
    public AccelerationStructure Tlas;
    /// The pairing patterns (`marlin_render::restir`): words 0–3 their sides, 4–7 where each
    /// starts (in 16-bit offsets after the header), then the offsets, `(dx + 128) | (dy + 128) << 8`.
    public ReadOnlyByteBuffer Pairing;
    /// Per neighbor slot and pixel (slot-major): the pixel's sample shifted to its partner in that
    /// slot, the target there; negative: no partner (off screen, or another surface).
    public Buffer<float> ShiftsOut;
    public ReadOnlyBuffer<float> Shifts;
    /// The shading's output, a noisy signal for the denoiser (0010 §6.1, `Denoise.mshader`): the
    /// light demodulated (divided by the albedo) and the distance to the light; and its hints,
    /// `Novelty` and `CorrelationRadius`.
    public StorageTexture2D<float4> Signal;
    public StorageTexture2D<float2> Hints;
}

const uint NoLight = 4294967295;

float Luminance(float3 c) => Dot(c, float3(0.2126, 0.7152, 0.0722));

/// The world position of screen pixel `px` at `depth`.
float3 WorldAt(in RestirConstants c, uint2 px, float depth)
{
    float2 ndc = float2(((float)px.x + 0.5) / (float)c.Width * 2 - 1, 1 - ((float)px.y + 0.5) / (float)c.Height * 2);
    float4 p = c.InverseViewProjection * float4(ndc, depth, 1);
    return p.xyz / p.w;
}

/// The light a Lambert surface at `x`, facing `n`, of albedo `albedo`, reflects toward the eye
/// from light `l` (without shadows): albedo / π · I · cos θ / d², faded by the range window and a
/// spot's cone.
float3 Contribution(in LightRow l, float3 x, float3 n, float3 albedo)
{
    float3 d = l.Position - x;
    float d2 = Max(Dot(d, d), 0.0001);
    float dist = Sqrt(d2);
    float3 toward = d / dist;
    float cosine = Saturate(Dot(n, toward));
    float window = Saturate(1 - Pow(dist / Max(l.Range, 0.0001), 4));
    float falloff = window * window / d2;
    float spot = 1;
    if (l.Kind == 2)
    {
        float c = Dot(-toward, l.Direction);
        float s = Saturate((c - l.Cone.y) / Max(l.Cone.x - l.Cone.y, 0.0001));
        spot = s * s;
    }
    if (l.Kind == 0)
        return float3(0, 0, 0);
    return albedo * 0.31830989 * l.Intensity * (falloff * spot * cosine);
}

/// Whether the surface at `x` (facing `n`) sees the point of light `l`'s sphere that `sample`
/// names (on the half facing `x`): one shadow ray.
bool Visible(in RestirConstants c, in RestirArgs a, in LightRow l, float3 x, float3 n, uint sample)
{
    float u = (float)(sample & 0xFFFF) / 65536.0;
    float v = (float)(sample >> 16) / 65536.0;
    float3 toward = Normalize(x - l.Position);
    float ring = Sqrt(Max(1 - u * u, 0));
    float phi = v * 6.2831853;
    float3 t = Normalize(Cross(Abs(toward.y) < 0.99 ? float3(0, 1, 0) : float3(1, 0, 0), toward));
    float3 b = Cross(toward, t);
    float3 point = l.Position + l.Radius * (toward * u + t * (ring * Cos(phi)) + b * (ring * Sin(phi)));
    // From just off the surface, scaled with the distance to the eye.
    float3 origin = x + n * (0.001 + 0.0005 * Length(x - c.Eye.xyz));
    float3 d = point - origin;
    float dist = Length(d);
    Ray ray = Ray { Origin = origin, TMin = 0, Direction = d / Max(dist, 0.0001), TMax = dist * 0.999 };
    return !a.Tlas.TraceAny(ray);
}

/// `x` as a float in [0, 1), from a hash.
float Random(uint x) => Unit(Hash(x));

/// A reservoir without a sample, for the surface `normal` at `distance` (0: none).
DiReservoir Empty(uint normal, float distance) =>
    DiReservoir { Light = NoLight, Sample = 0, W = 0, M = 0, Target = 0, Normal = normal, Distance = distance, Fresh = 1 };

[Compute(8, 8, 1)]
public void RestirInitial([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    uint pixel = id.y * c.Width + id.x;
    float depth = a.Depth.Load((int2)id.xy);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)id.xy));
    if (depth <= 0 || p.Count == 0)
    {
        a.Output[pixel] = Empty(0, 0);
        return;
    }
    float3 x = WorldAt(c, id.xy, depth);
    DiReservoir r = Empty(PackOct(p.Normal), Length(x - c.Eye.xyz));
    // One tile per 8×8 screen tile, a new one each frame.
    uint seed = Hash(c.Seed ^ Hash(pixel));
    uint tile = Hash(c.Seed ^ Hash((id.y / 8) * 65536 + id.x / 8)) % c.TileCount;
    float sum = 0;
    for (uint i = 0; i < c.Candidates; i++)
    {
        uint h = Hash(seed + i * 0x9E3779B9);
        uint2 entry = a.Tiles[tile * c.TileSize + h % c.TileSize];
        float source = AsFloat(entry.y);
        if (source <= 0)
            continue;
        float target = Luminance(Contribution(a.Lights[entry.x], x, p.Normal, p.Albedo));
        float weight = target / source;
        sum += weight;
        if (weight > 0 && Random(h ^ 0x68E31DA4) * sum < weight)
        {
            r.Light = entry.x;
            r.Target = target;
        }
    }
    r.M = 1;
    if (r.Light != NoLight)
    {
        r.W = sum / ((float)c.Candidates * r.Target);
        r.Sample = Hash(seed ^ 0xB5297A4D);
    }
    a.Output[pixel] = r;
}

/// The initial sample's shadow ray (`InitialVisibility`): an occluded one keeps its confidence
/// but no weight. A pass of its own: a ray query in `RestirInitial` holds registers through its
/// candidate loop, and the loop runs at a third less occupancy for it (measured: 3.6 against
/// 2.5 ms at 2560×1369).
[Compute(8, 8, 1)]
public void RestirInitialVisibility([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    uint pixel = id.y * c.Width + id.x;
    DiReservoir r = a.Output[pixel];
    if (r.Light == NoLight || r.W <= 0)
        return;
    float depth = a.Depth.Load((int2)id.xy);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)id.xy));
    float3 x = WorldAt(c, id.xy, depth);
    if (!Visible(c, a, a.Lights[r.Light], x, p.Normal, r.Sample))
        a.Output[pixel].W = 0;
}

[Compute(8, 8, 1)]
public void RestirTemporal([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    uint pixel = id.y * c.Width + id.x;
    DiReservoir r = a.Input[pixel];
    if (c.HasHistory == 0 || r.Distance <= 0)
    {
        a.Output[pixel] = r;
        return;
    }
    // Where the surface was last frame.
    float2 size = float2((float)c.Width, (float)c.Height);
    float2 uv = ((float2)id.xy + 0.5) / size - a.Velocity.Load((int2)id.xy);
    if (uv.x < 0 || uv.y < 0 || uv.x >= 1 || uv.y >= 1)
    {
        a.Output[pixel] = r;
        return;
    }
    uint2 at = (uint2)(uv * size);
    DiReservoir q = a.Previous[at.y * c.Width + at.x];
    float3 n = UnpackOct(r.Normal);
    // The same surface: about as far from the eye, facing about the same way.
    bool same = q.Distance > 0 && Abs(q.Distance - r.Distance) < 0.1 * r.Distance && Dot(UnpackOct(q.Normal), n) > 0.9;
    // A light added, changed or removed this frame: last frame's weight for it is stale.
    bool changed = q.Light != NoLight && q.Light / 32 < c.ChangedWords
        && (a.ChangedLights[q.Light / 32] & ((uint)1 << (q.Light % 32))) != 0;
    if (!same || changed || q.Light == NoLight || q.M <= 0)
    {
        a.Output[pixel] = r;
        return;
    }
    float depth = a.Depth.Load((int2)id.xy);
    Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)id.xy));
    float3 x = WorldAt(c, id.xy, depth);
    // Last frame's sample, weighed at this frame's surface (its light may have moved or gone).
    float qTarget = Luminance(Contribution(a.Lights[q.Light], x, p.Normal, p.Albedo));
    float cap = c.MaxHistory;
    if (c.Duplication != 0)
        cap = Lerp(c.MaxHistory, 1, Pow(Saturate(a.DuplicationMap[pixel]), c.DuplicationPower));
    float qM = Min(q.M, cap);
    float rWeight = r.W * r.Target * r.M;
    float qWeight = qTarget * q.W * qM;
    float sum = rWeight + qWeight;
    DiReservoir s = r;
    if (qWeight > 0 && Random(Hash(c.Seed ^ 0x2545F491) ^ pixel) * sum < qWeight)
    {
        s.Light = q.Light;
        s.Sample = q.Sample;
        s.Target = qTarget;
    }
    s.M = r.M + qM;
    s.W = s.Target > 0 ? sum / (s.M * s.Target) : 0;
    // Last frame's part is not new.
    s.Fresh = r.M * r.Fresh / s.M;
    a.Output[pixel] = s;
}

/// Whether two reservoirs' surfaces are one: about as far from the eye, facing about the same
/// way. Symmetric, so paired pixels agree on whether they reuse from each other.
bool SameSurface(in DiReservoir r, in DiReservoir q) =>
    r.Distance > 0 && q.Distance > 0 && Abs(q.Distance - r.Distance) < 0.1 * Max(r.Distance, q.Distance)
        && Dot(UnpackOct(q.Normal), UnpackOct(r.Normal)) > 0.9;

/// The offset from screen pixel `px` to its partner in pairing pattern `k`, as this frame
/// places the pattern (`PairingOffset`, `PairingFlags`).
int2 PartnerOffset(in RestirConstants c, in RestirArgs a, uint k, uint2 px)
{
    uint size = a.Pairing.Load(k * 4);
    uint start = a.Pairing.Load(16 + k * 4);
    uint x = (px.x + c.PairingOffset.x) % size;
    uint y = (px.y + c.PairingOffset.y) % size;
    if ((c.PairingFlags & 1) != 0)
        x = size - 1 - x;
    if ((c.PairingFlags & 2) != 0)
        y = size - 1 - y;
    if ((c.PairingFlags & 4) != 0)
    {
        uint t = x;
        x = y;
        y = t;
    }
    uint e = start + y * size + x;
    uint packed = (a.Pairing.Load(32 + (e / 2) * 4) >> ((e % 2) * 16)) & 0xFFFF;
    int dx = (int)(packed & 0xFF) - 128;
    int dy = (int)(packed >> 8) - 128;
    // Back to the screen: the placement's inverse.
    if ((c.PairingFlags & 4) != 0)
    {
        int t = dx;
        dx = dy;
        dy = t;
    }
    if ((c.PairingFlags & 1) != 0)
        dx = -dx;
    if ((c.PairingFlags & 2) != 0)
        dy = -dy;
    return int2(dx, dy);
}

/// Pixel `px`'s partner in pattern `k`; x negative when it is off screen.
int2 Partner(in RestirConstants c, in RestirArgs a, uint k, uint2 px)
{
    int2 q = int2((int)px.x, (int)px.y) + PartnerOffset(c, a, k, px);
    bool inside = q.x >= 0 && q.y >= 0 && q.x < (int)c.Width && q.y < (int)c.Height;
    return inside ? q : int2(-1, -1);
}

/// The first half of paired spatial reuse (0010 §2.5, PTE §3): every pixel's sample shifted to
/// each of its partners, its target there (with a shadow ray from there under
/// `SpatialVisibility`), into `ShiftsOut`. A pair reuses from each other, so these are both
/// shifts of the pair, each computed once.
[Compute(8, 8, 1)]
public void RestirSpatialShift([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    uint pixels = c.Width * c.Height;
    uint pixel = id.y * c.Width + id.x;
    DiReservoir r = a.Input[pixel];
    for (uint k = 0; k < c.Neighbors; k++)
    {
        float shifted = -1;
        int2 q = Partner(c, a, k, id.xy);
        if (q.x >= 0)
        {
            DiReservoir n = a.Input[(uint)q.y * c.Width + (uint)q.x];
            if (SameSurface(r, n))
            {
                shifted = 0;
                if (r.Light != NoLight && r.W > 0)
                {
                    Proxy p = UnpackProxy(a.MaterialBuffer.Load(q));
                    float3 x = WorldAt(c, (uint2)q, a.Depth.Load(q));
                    LightRow l = a.Lights[r.Light];
                    shifted = Luminance(Contribution(l, x, p.Normal, p.Albedo));
                    if (shifted > 0 && c.SpatialVisibility != 0 && !Visible(c, a, l, x, p.Normal, r.Sample))
                        shifted = 0;
                }
            }
        }
        a.ShiftsOut[k * pixels + pixel] = shifted;
    }
}

/// The second half: every pixel resamples its own reservoir (the canonical one) and its
/// partners', with pairwise MIS weighted by confidence (Falcor's `SpatialResampling`; Lin et al.
/// 2022). Both shifts of each pair come from `Shifts`: the partner's sample here is the partner's
/// entry, this pixel's sample there is this pixel's.
[Compute(8, 8, 1)]
public void RestirSpatial([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    uint pixels = c.Width * c.Height;
    uint pixel = id.y * c.Width + id.x;
    DiReservoir r = a.Input[pixel];
    if (r.Distance <= 0)
    {
        a.Output[pixel] = r;
        return;
    }
    // The confidence of all the reservoirs resampled, and the part of it new this frame.
    float total = r.M;
    float fresh = r.M * r.Fresh;
    for (uint k = 0; k < c.Neighbors; k++)
    {
        int2 q = Partner(c, a, k, id.xy);
        if (a.Shifts[k * pixels + pixel] >= 0 && q.x >= 0)
        {
            DiReservoir n = a.Input[(uint)q.y * c.Width + (uint)q.x];
            total += n.M;
            fresh += n.M * n.Fresh;
        }
    }
    float others = total - r.M;
    float canonical = r.M / total;
    DiReservoir s = r;
    float sum = 0;
    uint seed = Hash(c.Seed ^ 0x7F4A7C15) ^ pixel;
    for (uint k = 0; k < c.Neighbors; k++)
    {
        float mine = a.Shifts[k * pixels + pixel];
        int2 q = Partner(c, a, k, id.xy);
        if (mine < 0 || q.x < 0)
            continue;
        uint other = (uint)q.y * c.Width + (uint)q.x;
        DiReservoir n = a.Input[other];
        // This pixel's sample, had the partner drawn it: the canonical weight's pairwise term.
        if (mine > 0)
            canonical += n.M / total * (1 - mine * others / (mine * others + r.Target * r.M));
        else
            canonical += n.M / total;
        // The partner's sample, shifted here.
        float theirs = a.Shifts[k * pixels + other];
        if (n.Light == NoLight || n.W <= 0 || theirs <= 0)
            continue;
        float source = n.Target * others;
        float m = n.M / total * source / Max(source + theirs * r.M, 1e-20);
        float weight = theirs * n.W * m;
        sum += weight;
        if (weight > 0 && Random(Hash(seed + k * 0x9E3779B9)) * sum < weight)
        {
            s.Light = n.Light;
            s.Sample = n.Sample;
            s.Target = theirs;
        }
    }
    float own = r.Light != NoLight ? r.Target * r.W * canonical : 0;
    sum += own;
    if (own > 0 && Random(Hash(seed ^ 0x1B873593)) * sum < own)
    {
        s.Light = r.Light;
        s.Sample = r.Sample;
        s.Target = r.Target;
    }
    s.M = total;
    s.W = s.Target > 0 && s.Light != NoLight ? sum / s.Target : 0;
    s.Fresh = fresh / total;
    a.Output[pixel] = s;
}

[Compute(8, 8, 1)]
public void RestirShade([DispatchThreadId] uint3 id, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    if (id.x >= c.Width || id.y >= c.Height)
        return;
    uint pixel = id.y * c.Width + id.x;
    DiReservoir r = a.Input[pixel];
    // The hints (0010 §6.1): how much of the sample is new, and how far it has been copied
    // around (the duplication map's share d of 288 neighbors: blobs of about 1 + 288·d pixels).
    float radius = 1;
    if (c.DuplicationReady != 0)
        radius = Max(Sqrt((1 + 288 * a.DuplicationMap[pixel]) / 3.14159265), 1);
    a.Hints[(int2)id.xy] = float2(r.Fresh, radius);
    float3 radiance = float3(0, 0, 0);
    float hit = 0;
    if (r.Light != NoLight && r.W > 0)
    {
        float depth = a.Depth.Load((int2)id.xy);
        Proxy p = UnpackProxy(a.MaterialBuffer.Load((int2)id.xy));
        float3 x = WorldAt(c, id.xy, depth);
        LightRow l = a.Lights[r.Light];
        hit = Length(l.Position - x);
        // Demodulated: the albedo is the composition's.
        if (Visible(c, a, l, x, p.Normal, r.Sample))
            radiance = Contribution(l, x, p.Normal, float3(1, 1, 1)) * r.W;
    }
    a.Signal[(int2)id.xy] = float4(radiance, hit);
}

/// What tells an initial sample from every other: its light and the random numbers it was drawn
/// with (each pixel's own, each frame's own).
uint SampleId(in DiReservoir r) => Hash(r.Light) ^ r.Sample;

/// The sample ids of a 32×32 tile: a 16×16 group and 8 pixels around it.
[GroupShared] uint[1024] DuplicationIds;

/// Ids no sample has: outside the screen, or no sample.
const uint NoId = 4294967295;

/// The duplication map (PTE §5): for every pixel, how many of the 288 others in its 17×17
/// neighborhood hold the same initial sample, over 288: estimated from every second pixel (80
/// others), as a share.
[Compute(16, 16, 1)]
public void RestirDuplication([GroupId] uint3 group, [GroupThreadId] uint3 thread, [Push] in RestirArgs a)
{
    RestirConstants c = a.Constants.Value;
    int2 origin = int2((int)group.x * 16 - 8, (int)group.y * 16 - 8);
    for (uint k = thread.y * 16 + thread.x; k < 1024; k += 256)
    {
        int2 p = origin + int2((int)(k % 32), (int)(k / 32));
        uint id = NoId;
        if (p.x >= 0 && p.y >= 0 && p.x < (int)c.Width && p.y < (int)c.Height)
        {
            DiReservoir r = a.Input[(uint)p.y * c.Width + (uint)p.x];
            if (r.Light != NoLight && r.W > 0)
                id = SampleId(r);
        }
        DuplicationIds[k] = id;
    }
    Barrier.Group();
    uint2 px = group.xy * 16 + thread.xy;
    if (px.x >= c.Width || px.y >= c.Height)
        return;
    uint me = DuplicationIds[(thread.y + 8) * 32 + thread.x + 8];
    uint same = 0;
    if (me != NoId)
    {
        // Every second pixel of the window, 9 × 9: the same share, a quarter of the work.
        for (uint dy = 0; dy < 17; dy += 2)
        {
            for (uint dx = 0; dx < 17; dx += 2)
                same += DuplicationIds[(thread.y + dy) * 32 + thread.x + dx] == me ? (uint)1 : (uint)0;
        }
        // Not itself.
        same -= 1;
    }
    a.DuplicationMap[px.y * c.Width + px.x] = (float)same / 80.0;
}
