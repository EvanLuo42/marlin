            { Name = "r.restir.history", Value = "20" },
            { Name = "r.restir.checkerboard", Value = "true" },
            { Name = "r.restir.spatial_visibility", Value = "true" },
            { Name = "r.restir.gi_bounce", Value = "true" },
            { Name = "r.sharc.capacity", Value = "2097152" },
            { Name = "r.sharc.stride", Value = "4" },
        ] },
        { Group = "sg.lighting", Level = "3", Values = [
