!Version 1

// The engine's scalability table (0008 §2, 0010 §3): what each level of a quality group sets.
// `sg.quality` (0008 §2.3's PC presets) sets the feature groups; each feature group's level sets
// cvars (runtime/engine/framework/src/quality.rs lists them). A game's `Game.Scalability`
// merges over this one, level by level. The framework applies it at boot.
//
// sg.lighting's levels are 0010 §3's tiers L0–L4, with the knobs that exist so far: the quarter-
// resolution reservoirs of L0 and L1 fall back to the checkerboard's half, and L3's second
// bounce and ray-traced sun wait for their features (L4 is L3 with more cache updates).
Scalability
{
    !Uuid = "019a5f20-7c41-7e02-9b6d-3a1f8c2e5d01"
    !Name = "Marlin.Engine.Scalability"
    Levels = [
        { Group = "sg.quality", Level = "low", Values = [
            { Name = "sg.lighting", Value = "1" },
            { Name = "sg.geometry", Value = "1" },
            { Name = "sg.resolution", Value = "2" },
        ] },
        { Group = "sg.quality", Level = "medium", Values = [
            { Name = "sg.lighting", Value = "2" },
            { Name = "sg.geometry", Value = "2" },
            { Name = "sg.resolution", Value = "3" },
        ] },
        { Group = "sg.quality", Level = "high", Values = [
            { Name = "sg.lighting", Value = "3" },
            { Name = "sg.geometry", Value = "3" },
            { Name = "sg.resolution", Value = "3" },
        ] },
        { Group = "sg.quality", Level = "ultra", Values = [
            { Name = "sg.lighting", Value = "3" },
            { Name = "sg.geometry", Value = "3" },
            { Name = "sg.resolution", Value = "4" },
        ] },
        { Group = "sg.quality", Level = "cinematic", Values = [
            { Name = "sg.lighting", Value = "4" },
            { Name = "sg.geometry", Value = "4" },
            { Name = "sg.resolution", Value = "4" },
        ] },
        { Group = "sg.lighting", Level = "0", Values = [
            { Name = "r.restir.candidates", Value = "4" },
            { Name = "r.restir.neighbors", Value = "1" },
            { Name = "r.restir.history", Value = "10" },
            { Name = "r.restir.checkerboard", Value = "true" },
            { Name = "r.restir.spatial_visibility", Value = "false" },
            { Name = "r.restir.gi_bounce", Value = "false" },
            { Name = "r.sharc.capacity", Value = "524288" },
            { Name = "r.sharc.stride", Value = "6" },
        ] },
        { Group = "sg.lighting", Level = "1", Values = [
            { Name = "r.restir.candidates", Value = "8" },
            { Name = "r.restir.neighbors", Value = "1" },
            { Name = "r.restir.history", Value = "15" },
            { Name = "r.restir.checkerboard", Value = "true" },
            { Name = "r.restir.spatial_visibility", Value = "false" },
