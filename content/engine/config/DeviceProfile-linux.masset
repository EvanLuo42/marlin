!Version 1

// The default device profile on linux (0008 §2.2): the preset a desktop starts with. Hardware
// detection that picks a lower or higher one comes later; the user's settings override it.
DeviceProfile
{
    !Uuid = "019a5f20-7c41-7e04-a7d3-5b2c9e1f6a08"
    !Name = "Marlin.Engine.DeviceProfiles.linux"
    Values = [
        { Name = "sg.quality", Value = "medium" },
    ]
}
