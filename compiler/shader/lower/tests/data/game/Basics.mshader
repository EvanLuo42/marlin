namespace Game;

public struct Light
{
    public float3 Color;
    public float Intensity = 2;
}

public enum Mode { A, B = 5, C }

public const int Scale = 3;

public int Arith(int a, int b) => (a + b) * Scale - a / b + a % b;

public uint Unsigned(uint a, uint b) => a / b + (a >> 1);

public float Mix(float a, float b, float t) => a + (b - a) * t;

public float3 Vec(float3 v, float s)
{
    var w = v * s;
    w.y = 10;
    w.xz = float2(w.z, w.x);
    return w + 1;
}

public float Length(float3 v) => Sqrt(Dot(v, v));

public int Loops(int n)
{
    int s = 0;
    for (int i = 0; i < n; i++)
    {
        if (i == 3) continue;
        if (i == 7) break;
        s += i;
    }
    return s;
}

public int Collatz(int n)
{
    int k = 0;
    while (n > 1)
    {
        n = n % 2 == 0 ? n / 2 : 3 * n + 1;
        k++;
    }
    return k;
}

public int Do(int n)
{
    int k = 0;
    do
    {
        k++;
        n--;
    } while (n > 0);
    return k;
}

public int Range(int n)
{
    int s = 0;
    foreach (var i in 0..n) s += i;
    return s;
}

public float Array()
{
    float[4] a = [1, 2, 3, 4];
    float s = 0;
    foreach (var x in a) s += x;
    a[2] = 10;
    return s + a[2];
}

public int Switch(Mode m)
{
    switch (m)
    {
        case Mode.A:
            return 1;
        case Mode.B:
            return 2;
        default:
            return 3;
    }
}

public int SwitchExpr(int x) => x switch { 0 => 10, > 0 and < 5 => 20, _ => 30 };

public int ModeValue(Mode m) => (int)m;

public float Struct(float k)
{
    Light l = Light { Color = float3(1, 2, 3) };
    l.Intensity *= k;
    return l.Color.y + l.Intensity;
}

public void Swap(ref int a, ref int b)
{
    int t = a;
    a = b;
    b = t;
}

public int UseSwap(int x, int y)
{
    Swap(ref x, ref y);
    return x * 10 + y;
}

public bool TryHalf(int x, out int halved)
{
    halved = x / 2;
    return x % 2 == 0;
}

public int UseOut(int x)
{
    if (TryHalf(x, out var h) && h > 2) return h;
    return -1;
}

public struct Counter
{
    public int Count;
    public void Bump(int by) { Count += by; }
    public readonly int Twice() => Count * 2;
}

public int Methods()
{
    Counter c = default;
    c.Bump(3);
    c.Bump(4);
    return c.Twice();
}

public struct Pair
{
    public int A;
    public int B;
    public Pair(int a, int b) { A = a; B = b; }
}

public int Ctor()
{
    var p = Pair(3, 4);
    return p.A * p.B;
}

public int Defaults(int a, int b = 7) => a + b;

public int UseDefaults() => Defaults(1) + Defaults(1, b: 2);

public bool Logic(int a, int b) => a > 0 && b / a > 1 || a == 0;

public int Tuple(int a)
{
    var (x, y) = (a, a + 1);
    return x * y;
}

public float Mat(float4x4 m, float4 v) => (m * v).x;

public int ConstLen()
{
    int[Scale] arr = default;
    return arr.Length;
}
