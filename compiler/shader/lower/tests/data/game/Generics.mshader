namespace Game;

public T Twice<T>(T x) where T : IArithmetic<T> => x + x;

public int TwiceInt(int x) => Twice(x);
public float TwiceFloat(float x) => Twice(x);
public float3 TwiceVec(float3 v) => Twice(v);

public int Sum<const int N>(Vector<int, N> v)
{
    int s = 0;
    foreach (var i in 0..N) s += v[i];
    return s;
}

public int SumOf3(int a, int b, int c) => Sum(Vector<int, 3>(a, b, c));

public int Fact<const int N>()
{
    if (N <= 1) return 1;
    return N * Fact<N - 1>();
}

public int Fact5() => Fact<5>();

public struct Box<T>
{
    public T Value;
    public T Get() => Value;
}

public float UseBox(float x)
{
    Box<float> b = default;
    b.Value = x;
    return b.Get() + Box<int> { Value = 2 }.Get();
}

public interface IShape
{
    float Area();
}

public struct Square : IShape
{
    public float Side;
    public float Area() => Side * Side;
}

public struct Rect : IShape
{
    public float W;
    public float H;
    public float Area() => W * H;
}

public float AreaOf<S>(S s) where S : IShape => s.Area();

public float Areas(float a, float b)
{
    Square q = default;
    q.Side = a;
    Rect r = default;
    r.W = a;
    r.H = b;
    return AreaOf(q) + AreaOf(r);
}

public struct Money : IArithmetic<Money>
{
    public int Cents;
    public static Money operator +(Money a, Money b) => Money { Cents = a.Cents + b.Cents };
    public static Money operator *(Money a, Money b) => Money { Cents = a.Cents * b.Cents };
}

public int TwiceMoney(int cents) => Twice(Money { Cents = cents }).Cents;

public interface IHas
{
    type Item;
}

public struct HasFloat : IHas
{
    public type Item = float;
}

public M.Item Make<M>() where M : IHas => default;

public float MakeFloat() => Make<HasFloat>() + 1;

// An associated type bounded by an interface over itself, used through the type parameter:
// `G.Tree` comes back from `Grow` and has `Weight` from its bound (a material's `Tree`,
// 2026-10-18).
public interface IWeighed<TSelf> where TSelf : IWeighed<TSelf>
{
    float Weight();
}

public interface IGrows<TSelf> where TSelf : IGrows<TSelf>
{
    type Tree : IWeighed<Tree>;
    Tree Grow(float x);
}

public struct Twig : IWeighed<Twig>
{
    public float W;
    public float Weight() => W;
}

public struct Bush : IGrows<Bush>
{
    public float Height;
    public type Tree = Twig;
    public Twig Grow(float x) => Twig { W = x * Height };
}

public float GrownWeight<G>(G g, float x) where G : IGrows<G>
{
    G.Tree t = g.Grow(x);
    return t.Weight();
}

public float BushWeight(float x) => GrownWeight(Bush { Height = 3 }, x);

// Two fields of one struct type: each reads its own (2026-10-18).
public struct Pair3
{
    public float4 A;
    public float4 B;
}

public struct TwoPairs
{
    public Pair3 First;
    public Pair3 Second;
}

public float SecondOfTwo(float x)
{
    TwoPairs t = TwoPairs { First = Pair3 { A = float4(1, 2, 3, 4), B = float4(5, 6, 7, 8) }, Second = Pair3 { A = float4(x, 0, 0, 0), B = float4(0, 0, 0, x * 2) } };
    return t.Second.A.x + t.Second.B.w + t.First.B.y;
}

// An interface's default members, used through a type parameter (0004 §12): a default method
// (its `this` the implementer) and a constant with a default, which one implementer overrides
// and the other takes.
public interface IGlass<TSelf> where TSelf : IGlass<TSelf>
{
    float Thickness();
    float Opacity() => Thickness() * 0.5;
    const int Layers = 1;
}

public struct Pane : IGlass<Pane>
{
    public float Depth;
    public float Thickness() => Depth;
}

public struct Laminate : IGlass<Laminate>
{
    public float Depth;
    public float Thickness() => Depth * 2;
    public float Opacity() => 0.75;
    public const int Layers = 3;
}

public float OpacityOf<G>(G g) where G : IGlass<G> => g.Opacity() * (float)G.Layers;

public float PaneOpacity(float depth) => OpacityOf(Pane { Depth = depth });

public float LaminateOpacity(float depth) => OpacityOf(Laminate { Depth = depth });
