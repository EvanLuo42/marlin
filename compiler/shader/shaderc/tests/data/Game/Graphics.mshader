namespace Game;

// The RHI tests' `solid` and `columns` shaders: vertex and pixel entries.

public struct SolidArgs
{
    public float4 Color;
    public uint Mode;
    public float Depth;
    public uint2 Unused;
    public float4 Color1;
}

public struct SolidVertex
{
    [Position] public float4 Pos;
}

// A full-screen triangle (mode 0), the lower-left half (1), or a sliver at the edge (2).
[Vertex]
public SolidVertex SolidVs([VertexId] uint vertex, [Push] in SolidArgs a)
{
    uint v = vertex % 3;
    float2 p;
    if (a.Mode == 0)
        p = float2(v == 1 ? 3 : -1, v == 2 ? 3 : -1);
    else if (a.Mode == 1)
        p = float2(v == 1 ? 1 : -1, v == 2 ? 1 : -1);
    else
        p = float2(v == 1 ? -0.9 : -0.99, v == 2 ? 0.9 : 0.99);
    return SolidVertex { Pos = float4(p, a.Depth, 1) };
}

[Pixel]
public float4 SolidPs([Push] in SolidArgs a) => a.Color;

public struct Dual
{
    [Target(0)] public float4 Color0;
    [Target(0, Source = 1)] public float4 Color1;
}

[Pixel]
public Dual SolidDual([Push] in SolidArgs a) => Dual { Color0 = a.Color, Color1 = a.Color1 };

[Pixel]
public uint SolidCoord([Position] float4 position) =>
    (uint)position.x | ((uint)position.y << 16);

// Push word 31 is the per-draw constant of indirect draws.
public struct ColumnsArgs
{
    public uint Columns;
    public uint Span;
    public uint Offset;
    public uint[28] Unused;
    public uint First;
}

public struct ColumnVertex
{
    [Position] public float4 Pos;
    [Flat] public uint Value;
}

public const float2[6] Corners =
    [float2(0, 0), float2(1, 0), float2(1, 1), float2(0, 0), float2(1, 1), float2(0, 1)];

[Vertex]
public ColumnVertex ColumnsVs([VertexId] uint vertex, [Push] in ColumnsArgs a)
{
    uint span = Max(a.Span, 1);
    float2 c = Corners[vertex % 6];
    float x = Lerp((float)a.First, (float)(a.First + span), c.x) / (float)a.Columns;
    return ColumnVertex
    {
        Pos = float4(x * 2 - 1, c.y * 2 - 1, 0.5, 1),
        Value = a.First + 1 + a.Offset,
    };
}

[Pixel]
public uint ColumnsPs(in ColumnVertex i) => i.Value;

// Instances count from 0 on every backend (0002 §3).
public struct InstancedVertex
{
    [Position] public float4 Pos;
    [Flat] public uint Instance;
    [NoPerspective] public float2 Uv;
}

[Vertex]
public InstancedVertex Instanced([VertexId] uint vertex, [InstanceId] uint instance)
{
    float2 c = Corners[vertex % 6];
    return InstancedVertex { Pos = float4(c, 0, 1), Instance = instance, Uv = c };
}

[Pixel]
public float4 InstancedPs(in InstancedVertex i) => float4(i.Uv, (float)i.Instance, 1);
