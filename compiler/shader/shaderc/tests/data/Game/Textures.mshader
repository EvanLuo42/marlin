namespace Game;

// The RHI and cook tests' texture shaders: quad, sample.*, volume.* and texel_load.

public struct QuadArgs
{
    public ReadOnlyBuffer<float2> Vertices;
    public Uniform<Tint> Tint;
    public Texture2D<float4> Texture;
    public Sampler Sampler;
    public float Depth;
}

public struct Tint
{
    public float4 Color;
}

public struct QuadVertex
{
    [Position] public float4 Pos;
    public float2 Uv;
}

[Vertex]
public QuadVertex QuadVs([VertexId] uint vertex, [Push] in QuadArgs a)
{
    float2 p = a.Vertices[vertex];
    return QuadVertex { Pos = float4(p, a.Depth, 1), Uv = p * float2(0.5, -0.5) + 0.5 };
}

[Pixel]
public float4 QuadPs(in QuadVertex i, [Push] in QuadArgs a) =>
    a.Texture.Sample(a.Sampler, i.Uv, lod: 0) * a.Tint.Value.Color;

// Implicit levels, bias and gradients: pixel entries only.
[Pixel]
public float4 Levels(in QuadVertex i, [Push] in QuadArgs a) =>
    a.Texture.Sample(a.Sampler, i.Uv)
        + a.Texture.Sample(a.Sampler, i.Uv, bias: -0.5)
        + a.Texture.Sample(a.Sampler, i.Uv, grad: (i.Uv, i.Uv));

// sample.*: one push layout (texture, sampler, output, x, u, v); each entry names the
// texture's type.
public struct SampleArgs
{
    public Texture2D<float> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
    public uint X;
    public float U;
    public float V;
}

[Compute(1, 1, 1)]
public void SampleOne([Push] in SampleArgs a) =>
    a.Output.Store(0, AsUInt(a.Texture.Sample(a.Sampler, float2(a.U, a.V), lod: 0)));

public struct StencilArgs
{
    public Texture2D<uint> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
}

[Compute(4, 1, 1)]
public void Stencil([DispatchThreadId] uint3 id, [Push] in StencilArgs a) =>
    a.Output.Store(id.x * 4, a.Texture[int2((int)id.x, 0)]);

public struct MultisampleArgs
{
    public Texture2DMS<float4> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
    public uint X;
}

[Compute(4, 1, 1)]
public void Multisample([DispatchThreadId] uint3 id, [Push] in MultisampleArgs a)
{
    int x = (int)a.X;
    float r = a.Texture.Load(int2(x, x), sample: (int)id.x).x;
    a.Output.Store(id.x * 4, (uint)(r * 255 + 0.5));
}

public struct CubeArgs
{
    public TextureCubeArray<float4> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
    public uint X;
}

[Compute(1, 1, 1)]
public void Cube([Push] in CubeArgs a)
{
    float4 c = a.Texture.Sample(a.Sampler, float3(1, 0, 0), layer: (int)a.X, lod: 0);
    a.Output.Store(0, (uint)(c.x * 255 + 0.5));
}

// volume.*: push word 0 the volume, 1 the output, 2 the size.
public struct VolumeWriteArgs
{
    public StorageTexture3D<uint> Volume;
    public ByteBuffer Output;
    public uint Size;
}

[Compute(4, 4, 4)]
public void VolumeWrite([DispatchThreadId] uint3 id, [Push] in VolumeWriteArgs a)
{
    if (All(id < a.Size))
        a.Volume[(int3)id] = id.x + 16 * id.y + 256 * id.z + 1;
}

public struct VolumeReadArgs
{
    public Texture3D<uint> Volume;
    public ByteBuffer Output;
    public uint Size;
}

[Compute(4, 4, 4)]
public void VolumeRead([DispatchThreadId] uint3 id, [Push] in VolumeReadArgs a)
{
    uint size = a.Size;
    if (All(id < size))
        a.Output.Store(((id.z * size + id.y) * size + id.x) * 4, a.Volume[(int3)id]);
}

// texel_load: a texel of one layer and mip of a 2D array, as raw words.
public struct TexelArgs
{
    public Texture2DArray<float4> Texture;
    public ByteBuffer Output;
    public uint Width;
    public uint Height;
    public uint Mip;
    public uint Layer;
    public uint Offset;
}

[Compute(8, 8, 1)]
public void TexelLoad([DispatchThreadId] uint3 id, [Push] in TexelArgs a)
{
    if (id.x >= a.Width || id.y >= a.Height)
        return;
    float4 texel = a.Texture.Load((int2)id.xy, layer: (int)a.Layer, mip: (int)a.Mip);
    a.Output.Store4(a.Offset + (id.y * a.Width + id.x) * 16, AsUInt(texel));
}

// Errors: offsets are constants in -8..7; a gather channel is a constant.
[Compute(1, 1, 1)]
public void RuntimeOffset([Push] in SampleArgs a) =>
    a.Output.Store(0, AsUInt(a.Texture.Load(int2(0, 0), offset: int2((int)a.X, 0))));

[Compute(1, 1, 1)]
public void FarOffset([Push] in SampleArgs a) =>
    a.Output.Store(0, AsUInt(a.Texture.Load(int2(0, 0), offset: int2(9, 0))));

public struct ChannelArgs
{
    public Texture2D<float> Texture;
    public Sampler Sampler;
    public ByteBuffer Output;
    public Channel Which;
}

[Compute(1, 1, 1)]
public void RuntimeChannel([Push] in ChannelArgs a) =>
    a.Output.Store4(0, AsUInt(a.Texture.Gather(a.Sampler, float2(0.5, 0.5), a.Which)));
