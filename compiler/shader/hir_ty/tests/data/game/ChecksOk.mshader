namespace Game;

public struct Pair { public float A; public float B; }

public readonly struct Frozen
{
    public readonly float V;
    public Frozen(float v) { V = v; }
    public float Get() => V;
}

public struct Counter
{
    public int Count;
    public Counter(int c) { Count = c; }
    public readonly int Peek() => Count;
    public void Bump() { Count++; }
}

public enum Mode { A, B, C }
[Flags] public enum Bits : uint { X = 1, Y = 2 }

bool TryGet(int i, out float v)
{
    v = i;
    return i > 0;
}

float Assigned(int n, bool c)
{
    float a;
    if (c) a = 1; else a = 2;
    float b;
    if (c && TryGet(n, out b)) a += b;
    if (!TryGet(n, out var d)) return d;
    Pair p;
    p.A = 1;
    p.B = 2;
    var q = p;
    float4 o;
    o.xyz = float3(1, 2, 3);
    o.w = 1;
    float x;
    while (true) { x = 1; break; }
    float y;
    for (;;) { y = 2; break; }
    float z = n > 0 ? 1 : 2;
    switch (n)
    {
        case 0:
            return a;
        default:
            break;
    }
    return a + q.A + o.w + x + y + z;
}

float EveryMember(Mode m)
{
    switch (m)
    {
        case Mode.A: return 1;
        case Mode.B: return 2;
        case Mode.C: return 3;
    }
}

float Arms(Mode m, bool b) => m switch { Mode.A => 1, Mode.B or Mode.C => 2 } + b switch { true => 1, false => 0 };

uint FlagsNeedNotBeCovered(Bits b)
{
    switch (b)
    {
        case Bits.X:
            return 1;
    }
    return 0;
}

void Loops(int n, out int r)
{
    if (n > 0)
    {
        r = 1;
        return;
    }
    do { n--; } while (n > 0);
    for (int i = 0; i < n; i++) { if (i == 2) continue; }
    r = n;
}

int ReadonlyUse(in Counter c, in Frozen f)
{
    var copy = c;
    copy.Bump();
    return c.Peek() + (int)f.Get() + c.Count;
}
