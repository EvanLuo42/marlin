namespace Game;

void Errors(uint3 id, int n)
{
    var mixed = id.x + n;
    float f = 1.5;
    half h = f;
    int3 truncated = float3(1, 2, 3);
    float3 narrowed = float4(1, 2, 3, 4);
    var missing = Nope;
    id.xx = 2;
    float3 short3 = float3(1, 2);
    bool b = 1 && true;
    if (id.x) { }
    var lambda = x => x;
    var wrongGroup = TakesFunc(TwoArgs);
    var notCalled = TwoArgs;
    var unknown = default;
    var cast = (bool)f;
    var noDot = Dot(1, 2);
    3 = n;
    var noMember = f.Nope;
    var intRoot = Sqrt(n);
    var vectorRoot = Sqrt(id);
    var explicitRoot = Sqrt<int>(1);
    var groupRoot = TakesIntFunc(Sqrt);
    return 1;
}

T NotFloat<T>(T x) where T : IArithmetic<T> => Sqrt(x);

int TakesIntFunc(Func<int, int> f) => f(1);
float TakesFunc(Func<float, float> f) => f(1);
float TwoArgs(float a, float b) => a;

// `&`, `|` and `^` need a [Flags] enum; no enum has `<`.
void EnumErrors()
{
    var notFlags = Lobe.Diffuse | Lobe.Specular;
    var ordered = Lobe.Diffuse < Lobe.Specular;
}
