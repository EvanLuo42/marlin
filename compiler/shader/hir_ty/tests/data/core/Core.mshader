// A small stand-in for the core library, enough for the type tests.
namespace Marlin;

public interface IAttribute { }

[Builtin("string")] public struct String { }

public struct BuiltinAttribute : IAttribute
{
    public string Name;
    public BuiltinAttribute(string name) { Name = name; }
}

public struct IntrinsicAttribute : IAttribute
{
    public string Op;
    public IntrinsicAttribute(string op) { Op = op; }
}

public struct FlagsAttribute : IAttribute { }

public interface IScalar<T> where T : IScalar<T> { }

public interface IArithmetic<T> where T : IArithmetic<T>
{
    static abstract T operator +(T a, T b);
}

public interface IFloat<T> : IArithmetic<T> where T : IFloat<T> { }

[Builtin("bool")] public struct Bool : IScalar<Bool> { }
[Builtin("i32")] public struct Int : IScalar<Int>, IArithmetic<Int> { }
[Builtin("u32")] public struct UInt : IScalar<UInt>, IArithmetic<UInt> { }
[Builtin("f16")] public struct Half : IScalar<Half>, IFloat<Half> { }
[Builtin("f32")] public struct Float : IScalar<Float>, IFloat<Float> { }
[Builtin("f64")] public struct Double : IScalar<Double>, IFloat<Double> { }

[Builtin("vector")]
public struct Vector<T, const int N> : IArithmetic<Vector<T, N>>, IFloat<Vector<T, N>>
    where T : IScalar<T> { }
[Builtin("matrix")] public struct Matrix<T, const int R, const int C> where T : IScalar<T> { }

public type float2 = Vector<float, 2>;
public type float3 = Vector<float, 3>;
public type float4 = Vector<float, 4>;
public type uint3 = Vector<uint, 3>;
public type float4x4 = Matrix<float, 4, 4>;

[Builtin("sampler")] public struct Sampler { }

[Builtin("texture2d")]
public struct Texture2D<T>
{
    [Intrinsic("tex.sample")]
    public T Sample(Sampler s, float2 uv, float lod = 0);
}

[Builtin("func")] public struct Func<TResult> { }
[Builtin("func")] public struct Func<T, TResult> { }

[Intrinsic("dot")]
public T Dot<T, const int N>(Vector<T, N> a, Vector<T, N> b) where T : IArithmetic<T>;

public type float4x3 = Matrix<float, 4, 3>;
public type int2 = Vector<int, 2>;
public type int3 = Vector<int, 3>;
public type uint2 = Vector<uint, 2>;
public type half4 = Vector<half, 4>;
public type bool3 = Vector<bool, 3>;

[Intrinsic("all")]
public bool All<const int N>(Vector<bool, N> v);

[Intrinsic("select")]
public Vector<T, N> Select<T, const int N>(Vector<bool, N> c, Vector<T, N> a, Vector<T, N> b)
    where T : IScalar<T>;

[Intrinsic("lerp")]
public Vector<T, N> Lerp<T, const int N>(Vector<T, N> a, Vector<T, N> b, T t)
    where T : IArithmetic<T>;

[Intrinsic("sqrt")] public T Sqrt<T>(T x) where T : IFloat<T>;

[Intrinsic("max")] public float Max(float a, float b);
[Intrinsic("max")] public double Max(double a, double b);
[Intrinsic("max")] public int Max(int a, int b);

// Attributes the compiler knows (0004 §11, §12).
public struct ComputeAttribute : IAttribute { public ComputeAttribute(int x, int y, int z) { } }
public struct VertexAttribute : IAttribute { }
public struct PixelAttribute : IAttribute { }
public struct PushAttribute : IAttribute { }
public struct GroupSharedAttribute : IAttribute { }
public struct ExportAttribute : IAttribute { }
public struct DispatchThreadIdAttribute : IAttribute { }
public struct GroupIndexAttribute : IAttribute { }
public struct VertexIdAttribute : IAttribute { }
public struct PositionAttribute : IAttribute { }
public struct IsFrontFaceAttribute : IAttribute { }
public struct FlatAttribute : IAttribute { }
public struct TargetAttribute : IAttribute { public TargetAttribute(int index) { } }

public enum Capability { Native16Bit, Int64, Float64, WaveMatrix }
public struct RequiresAttribute : IAttribute { public RequiresAttribute(Capability c) { } }

[Builtin("uniform")] public struct Uniform<T> { }
[Builtin("buffer")] public struct Buffer<T>
{
    public T this[uint i] { get; set; }
}

[Requires(Capability.WaveMatrix)]
[Intrinsic("wave.matmul")]
public void MatMul16();
