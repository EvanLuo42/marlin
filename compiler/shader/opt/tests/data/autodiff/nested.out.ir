func @cube(%x: f64) -> f64 {
block0:
    %x2 = fmul %x, %x
    %r = fmul %x2, %x
    return %r
}

func @square(%x: f64) -> f64 {
block0:
    %r = fmul %x, %x
    return %r
}

func @first(%x: f64) -> f64 {
block0:
    %x2 = fmul %x, %x
    %0 = fmul f64 1.0, %x
    %1 = fmul f64 1.0, %x
    %d_x2 = fadd %0, %1
    %r = fmul %x2, %x
    %2 = fmul %d_x2, %x
    %3 = fmul f64 1.0, %x2
    %d_r = fadd %2, %3
    return %d_r
}

func @second(%x: f64) -> f64 {
block0:
    %x2 = fmul %x, %x
    %0 = fmul f64 1.0, %x
    %1 = fmul f64 1.0, %x
    %d_x2 = fadd %0, %1
    %2 = fmul f64 1.0, %x
    %3 = fmul f64 1.0, f64 1.0
    %4 = fmul f64 1.0, %x
    %5 = fmul f64 1.0, f64 1.0
    %d_x2.1 = fadd %2, %4
    %d_d_x2 = fadd %3, %5
    %r = fmul %x2, %x
    %6 = fmul %d_x2.1, %x
    %7 = fmul %d_d_x2, %x
    %8 = fmul f64 1.0, %d_x2.1
    %9 = fadd %7, %8
    %10 = fmul f64 1.0, %x2
    %11 = fmul %d_x2, f64 1.0
    %d_r = fadd %6, %10
    %d_d_r = fadd %9, %11
    return %d_d_r
}

func @dsquare(%x: f64) -> f64 {
block0:
    %r = fmul %x, %x
    %0 = fmul f64 1.0, %x
    %1 = fmul f64 1.0, %x
    %d_r = fadd %0, %1
    return %d_r
}

func @screen(%x: f64, %dx: f64) -> f64 {
block0:
    %r = fmul %x, %x
    %0 = fmul f64 1.0, %x
    %1 = fmul %dx, f64 1.0
    %2 = fmul f64 1.0, %x
    %3 = fmul %dx, f64 1.0
    %d_r = fadd %0, %2
    %ddx_d_r = fadd %1, %3
    return %ddx_d_r
}
