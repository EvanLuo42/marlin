func @divide(%a: i32, %b: i32) -> i32 {
block0:
    %0 = icmp eq %b, i32 0
    %1 = icmp eq %a, i32 -2147483648
    %2 = icmp eq %b, i32 -1
    %3 = and %1, %2
    %4 = or %0, %3
    %5 = select %4, i32 1, %b
    %6 = sdiv %a, %5
    %7 = select %0, i32 0, %6
    %u = udiv %a, i32 3
    %8 = icmp eq i32 -1, i32 0
    %9 = icmp eq %7, i32 -2147483648
    %10 = icmp eq i32 -1, i32 -1
    %11 = and %9, %10
    %12 = or %8, %11
    %13 = select %12, i32 1, i32 -1
    %14 = srem %7, %13
    %15 = select %8, i32 0, %14
    %s = add %15, %u
    return %s
}

func @precise(%a: i32) -> i32 {
block0:
    %f = sitofp precise %a : f32
    %g = fmul precise %f, f32 3.0
    %h = fadd precise %g, f32 1.0
    %i = fptosi %h : i32
    return %i
}
