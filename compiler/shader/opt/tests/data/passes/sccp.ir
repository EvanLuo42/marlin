// Optimistic: %x is 1 on entry and stays 1 round the loop, however many times it goes.
func @loop_constant(%n: i32) -> i32 {
block0:
    loop header block1(i32 1, i32 0) continue block3 merge block4
block1(%x: i32, %k: i32):
    %done = icmp sge %k, %n
    cond_br %done, block4(%x), block2 merge block2
block2:
    %x2 = mul %x, %x
    br block3
block3:
    %k2 = add %k, i32 1
    br block1(%x2, %k2)
block4(%r: i32):
    return %r
}

// A branch known to go one way: the jump it does not take does not count against the
// merge block's parameter.
func @one_way(%a: i32) -> i32 {
block0:
    %c = icmp eq i32 2, i32 2
    cond_br %c, block1, block2 merge block3
block1:
    br block3(i32 7)
block2:
    br block3(%a)
block3(%r: i32):
    %s = add %r, i32 1
    return %s
}
