struct @Game.Pair { A: i32x4, B: f32 }
struct @Game.Rows { R0: f32x4, R1: f32x4 }
struct @Game.Node { Id: i32, Now: @Game.Rows, Then: @Game.Rows, Pairs: [@Game.Pair; 3], Wide: i64 }
struct @Game.NestArgs { Nodes: res<Buffer<@Game.Node>>, View: res<Uniform<@Game.Node>>, I: i32 }
global @Game.Nest.a : ptr<push, @Game.NestArgs>

entry compute(1, 1, 1) @Game.Nest uses(@Game.Nest.a) {
block0:
    %0 = load @Game.Nest.a
    %1 = extract.field %0, .Nodes
    %2 = desc.get %1
    %3 = extract.field %0, .I
    %4 = buffer.elem %2, i32 0
    %5 = buffer.elem %2, i32 1
    %6 = load %4
    store %5, %6
    %7 = access %4, .Then
    %8 = load %7
    %9 = access %5, .Now
    store %9, %8
    %10 = access %7, .R1
    %11 = load %10
    %12 = access %5, .Then, .R0
    store %12, %11
    %13 = access %4, .Pairs, [%3]
    %14 = load %13
    %15 = access %5, .Pairs, [i32 2]
    store %15, %14
    %16 = access %5, .Pairs, [%3], .B
    %17 = load %16
    %18 = fadd %17, f32 1
    store %16, %18
    %19 = access %5, .Pairs, [%3], .A, [i32 2]
    %20 = atomic.add %19, i32 1 scope(device) order(relaxed)
    %21 = access %4, .Wide
    %22 = load %21
    %23 = extract.field %0, .View
    %24 = desc.get %23
    %25 = uniform.ptr %24
    %26 = load %25
    %27 = extract.field %26, .Pairs
    %28 = access %5, .Pairs
    store %28, %27
    %29 = access %25, .Pairs, [%3], .A
    %30 = load %29
    %31 = access %5, .Pairs, [i32 0], .A
    store %31, %30
    return
}
