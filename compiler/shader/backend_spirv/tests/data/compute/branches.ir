// An if/else joined by a parameter, a loop whose body is a switch, and the result stored:
// selections, a switch, a loop with a parameter round it.
struct @Args { Out: res<Buffer<i32>>, N: i32 }

global @args : ptr<push, @Args>
global @gi : ptr<input, i32> builtin(GroupIndex)

entry compute(64, 1, 1) @Branches uses(@args, @gi) {
block0:
    %a = load @args
    %n = extract.field %a, .N
    %i = load @gi
    %c = icmp slt %i, %n
    cond_br %c, block1, block2 merge block3
block1:
    %x = add %i, i32 1
    br block3(%x)
block2:
    %y = mul %i, i32 2
    br block3(%y)
block3(%v: i32):
    loop header block4(i32 0, %v) continue block7 merge block8
block4(%k: i32, %acc: i32):
    %done = icmp sge %k, i32 4
    cond_br %done, block8(%acc), block5 merge block5
block5:
    %s = and %k, i32 1
    switch %s [0: block6] default block9 merge block10
block6:
    %t = add %acc, %k
    br block10(%t)
block9:
    br block10(%acc)
block10(%u: i32):
    br block7
block7:
    %k2 = add %k, i32 1
    br block4(%k2, %u)
block8(%r: i32):
    %out = extract.field %a, .Out
    %h = desc.get %out
    store (buffer.elem %h, %i), %r
    return
}
