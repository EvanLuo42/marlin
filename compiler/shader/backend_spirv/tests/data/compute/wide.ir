struct @Game.WideArgs { Words: res<Buffer<i64>>, Vis: res<StorageTexture2D<i64>>, Counts: res<StorageTexture2DArray<signed i32>> }
global @Game.Wide.id : ptr<input, i32x3> builtin(DispatchThreadId)
global @Game.Wide.a : ptr<push, @Game.WideArgs>

entry compute(8, 8, 1) @Game.Wide uses(@Game.Wide.id, @Game.Wide.a) {
block0:
    %0 = load @Game.Wide.id
    %1 = load @Game.Wide.a
    %2 = extract %0, 0
    %3 = zext %2 : i64
    %4 = shl %3, i64 32
    %5 = extract.field %1, .Words
    %6 = desc.get %5
    %7 = buffer.elem %6, i32 0
    %8 = atomic.umax %7, %4 scope(device) order(relaxed)
    %9 = extract.field %1, .Vis
    %10 = desc.get %9
    %11 = shuffle %0, %0, [0, 1]
    %12 = tex.atomic.umax %10, %11, %8 scope(device) order(relaxed)
    %13 = extract.field %1, .Counts
    %14 = desc.get %13
    %15 = tex.atomic.smin %14, %11, i32 -1 { layer: i32 1 } scope(device) order(relaxed)
    return
}
