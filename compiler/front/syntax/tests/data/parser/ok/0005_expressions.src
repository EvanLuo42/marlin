void F()
{
    var p = float3(1, 2, 3);
    var l = Light(c, 2);
    var m = Light { Color = c, Intensity = 2 };
    Light k = { Color = c };
    var n = l with { Intensity = 4 };
    var z = default(Light);
    Light d = default;
    float[4] w = [0.1, 0.2, 0.3, 0.4];
    var x = a < b;
    var y = F<T>(x) + G<int, 3>.H;
    var s = a >> 2 >>> 1 << 3;
    s >>= 1;
    s >>>= 2;
    var t = a > b ? c : d >= e;
    var u = -x * +y / ~z % !w;
    var v = (float)i + (T)j - (a) + b;
    var r = 0..n;
    var q = ..n;
    var (wi, pdf) = Sample(u);
    (a, b) = (b, a);
    var tup = (Wi: wi, Pdf: pdf);
    x++;
    --y;
    var c2 = t.Sample(s, uv, lod: 2);
    Decode(g, out var nn, ref w);
    Decode(g, out float3 n2, ref w);
    var e = m[0, 1] + m.Column(3).xyz;
    var f = Integrate(64, x => Exp(-x * k));
    var g2 = Integrate(64, (float x) => { return x; });
    var h = q is > 0 and < 10 or 20;
    var k2 = name switch { Lobe.Diffuse => 1, Lobe.Haze or Lobe.Fuzz => 0.5, _ => 0, };
    Debug.Print($"pdf = {pdf} at {id.xy,4:F2} {{literal}}");
    var nested = $"a{$"b{c}"}d";
    var big = 0xFF_FFu + 1.5e-3f + 2h + 3UL + .5;
    var nm = nameof(Light);
}
