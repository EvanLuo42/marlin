/target
# fuzz/ is its own workspace, with its own target directory.
/fuzz/target/
# LLVM coverage profiles belong under target/coverage/; any elsewhere are strays.
*.profraw

# Console backends are private repositories cloned into platforms/<name>/.
# Only the public desktop platform manifests are tracked.
/platforms/*
!/platforms/README.md
!/platforms/windows/
!/platforms/linux/
!/platforms/macos/

# IDE project files
/.idea/

# Per-machine asset index and caches (tools/asset_db).
.marlin/
